# Counter-feedback arm: create, link, rename, and remove inodes/directories.
mkdirat(0xffffffffffffff9c, &AUTO='./counter-inode\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./counter-inode\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='left\x00', 0x242, 0x180)
r2 = openat(r0, &AUTO='right\x00', 0x242, 0x180)
mkdirat(r0, &AUTO='sub\x00', 0x1c0)
mkdirat(r0, &AUTO='sub/nested\x00', 0x1c0)
linkat(r0, &AUTO='left\x00', r0, &AUTO='sub/linked\x00', 0)
renameat2(r0, &AUTO='right\x00', r0, &AUTO='sub/replaced\x00', 0x2)
symlinkat(&AUTO='sub/linked\x00', r0, &AUTO='sym\x00')
unlinkat(r0, &AUTO='sym\x00', 0)
unlinkat(r0, &AUTO='sub/linked\x00', 0)
unlinkat(r0, &AUTO='left\x00', 0)
unlinkat(r0, &AUTO='sub/replaced\x00', 0)
unlinkat(r0, &AUTO='sub/nested\x00', 0x200)
unlinkat(r0, &AUTO='sub\x00', 0x200)
close(r2)
close(r1)
close(r0)
syncfs(0xffffffffffffff9c)
