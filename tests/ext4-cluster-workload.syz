# Cluster accounting: allocation, partial writes, punch/zero/collapse ranges,
# and repeated truncate cycles all exercise mballoc and extent removal.
mkdirat(0xffffffffffffff9c, &AUTO='./cluster\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./cluster\x00', 0x10000, 0)
r1 = openat$auto(r0, &AUTO='file\x00', 0x242, 0x180)
write(r1, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 0x20)
fallocate$auto(r1, 0, 0, 0x20000)
fallocate$auto(r1, 0x10, 0x2000, 0x4000)
fallocate$auto(r1, 0x1, 0x6000, 0x2000)
pwrite64$auto(r1, "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", 0x20, 0x18000)
ftruncate$auto(r1, 0x3000)
fallocate$auto(r1, 0, 0x10000, 0x10000)
ftruncate$auto(r1, 0x1000)
fallocate$auto(r1, 0x10, 0, 0x8000)
fsync(r1)
ftruncate$auto(r1, 0x22000)
fallocate$auto(r1, 0x1, 0x1000, 0x9000)
fsync(r1)
close(r1)
unlinkat$auto(r0, &AUTO='file\x00', 0)
close(r0)
syncfs(0xffffffffffffff9c)
