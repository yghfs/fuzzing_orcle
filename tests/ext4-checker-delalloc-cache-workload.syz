# Drive delayed allocation and extent-status transitions observed rarely in
# the live corpus, then force allocation/cache walks around punch/truncate.
mkdirat(0xffffffffffffff9c, &AUTO='./checker-delalloc-cycle\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./checker-delalloc-cycle\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='delalloc\x00', 0x242, 0x180)
pwrite64(r1, "DELAYED-ALLOC-0001", 0x12, 0)
pwrite64(r1, "DELAYED-ALLOC-0002", 0x12, 0x4000)
pwrite64(r1, "DELAYED-ALLOC-0003", 0x12, 0x10000)
ioctl$EXT4_IOC_GETSTATE(r1, 1074030121, &(0x7f0000000000)=0)
ioctl$EXT4_IOC_PRECACHE_EXTENTS(r1, 26130)
ioctl$EXT4_IOC_GET_ES_CACHE(r1, 3223348778, &(0x7f0000001000)={0, 0x30000, 0, 8, 0, {0}})
ioctl$EXT4_IOC_ALLOC_DA_BLKS(r1, 26124)
fallocate(r1, 0, 0x20000, 0x10000)
pwrite64(r1, "DELAYED-ALLOC-0004", 0x12, 0x24000)
ioctl$EXT4_IOC_PRECACHE_EXTENTS(r1, 26130)
ioctl$EXT4_IOC_CLEAR_ES_CACHE(r1, 26152)
ioctl$EXT4_IOC_GET_ES_CACHE(r1, 3223348778, &(0x7f0000001000)={0, 0x30000, 0, 8, 0, {0}})
fallocate(r1, 0x3, 0x4000, 0x4000)
fallocate(r1, 0x8, 0x8000, 0x4000)
ioctl$EXT4_IOC_ALLOC_DA_BLKS(r1, 26124)
sync_file_range(r1, 0, 0x30000, 0x7)
fsync(r1)
ioctl$EXT4_IOC_PRECACHE_EXTENTS(r1, 26130)
ioctl$EXT4_IOC_CLEAR_ES_CACHE(r1, 26152)
ftruncate(r1, 0x9000)
fallocate(r1, 0, 0, 0x8000)
pwrite64(r1, "REPOPULATE-000001", 0x11, 0x1000)
ioctl$EXT4_IOC_ALLOC_DA_BLKS(r1, 26124)
fsync(r1)
close(r1)
close(r0)
