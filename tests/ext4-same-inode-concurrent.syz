# Every executor opens the same inode and races extent-state transitions.
# The fixed pathname is intentional: threaded/procs execution makes all
# workers share the inode while truncate/fallocate/fsync close transactions.
mkdirat(0xffffffffffffff9c, &AUTO='./same-inode-race\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./same-inode-race\x00', 0x10000, 0)
r1 = openat$auto(r0, &AUTO='victim\x00', 0x242, 0x180)
fallocate$auto(r1, 0, 0, 0x80000)
pwrite64$auto(r1, "INIT-00000000001", 0x10, 0)
pwrite64$auto(r1, "INIT-00000000002", 0x10, 0x20000)
pwrite64$auto(r1, "INIT-00000000003", 0x10, 0x40000)
fsync$auto(r1)
fallocate$auto(r1, 0x3, 0x1000, 0x7000)
fallocate$auto(r1, 0x8, 0x9000, 0x7000)
fallocate$auto(r1, 0x20, 0x12000, 0x7000)
fallocate$auto(r1, 0x2, 0x18000, 0x9000)
ftruncate$auto(r1, 0x50000)
fallocate$auto(r1, 0x3, 0x20000, 0x10000)
fallocate$auto(r1, 0x8, 0x28000, 0x10000)
fallocate$auto(r1, 0x20, 0x30000, 0x10000)
ftruncate$auto(r1, 0x18000)
fsetxattr$auto(r1, &AUTO='user.same.inode\x00', &AUTO='same-inode-value-0001\x00', 0x16, 0)
fremovexattr$auto(r1, &AUTO='user.same.inode\x00')
fsync$auto(r1)
fallocate$auto(r1, 0x3, 0, 0x20000)
ftruncate$auto(r1, 0x40000)
fsync$auto(r1)
close(r1)
close(r0)
