# Build an extent tree, then shift it and remove a large sparse tail.
mkdirat(0xffffffffffffff9c, &AUTO='./shift-targeted\x00', 0x1c0)
r0 = openat(0xffffffffffffff9c, &AUTO='./shift-targeted\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='sparse\x00', 0x242, 0x180)
pwrite64(r1, "AAAA000000000000", 0x10, 0)
pwrite64(r1, "AAAA000000000001", 0x10, 0x3000)
pwrite64(r1, "AAAA000000000002", 0x10, 0x6000)
pwrite64(r1, "AAAA000000000003", 0x10, 0x9000)
pwrite64(r1, "AAAA000000000004", 0x10, 0xc000)
pwrite64(r1, "AAAA000000000005", 0x10, 0xf000)
pwrite64(r1, "AAAA000000000006", 0x10, 0x12000)
pwrite64(r1, "AAAA000000000007", 0x10, 0x15000)
pwrite64(r1, "AAAA000000000008", 0x10, 0x18000)
pwrite64(r1, "AAAA000000000009", 0x10, 0x1b000)
pwrite64(r1, "AAAA000000000010", 0x10, 0x1e000)
pwrite64(r1, "AAAA000000000011", 0x10, 0x21000)
pwrite64(r1, "AAAA000000000012", 0x10, 0x24000)
pwrite64(r1, "AAAA000000000013", 0x10, 0x27000)
pwrite64(r1, "AAAA000000000014", 0x10, 0x2a000)
pwrite64(r1, "AAAA000000000015", 0x10, 0x2d000)
pwrite64(r1, "AAAA000000000016", 0x10, 0x30000)
pwrite64(r1, "AAAA000000000017", 0x10, 0x33000)
pwrite64(r1, "AAAA000000000018", 0x10, 0x36000)
pwrite64(r1, "AAAA000000000019", 0x10, 0x39000)
pwrite64(r1, "AAAA000000000020", 0x10, 0x3c000)
pwrite64(r1, "AAAA000000000021", 0x10, 0x3f000)
pwrite64(r1, "AAAA000000000022", 0x10, 0x42000)
pwrite64(r1, "AAAA000000000023", 0x10, 0x45000)
pwrite64(r1, "AAAA000000000024", 0x10, 0x48000)
pwrite64(r1, "AAAA000000000025", 0x10, 0x4b000)
pwrite64(r1, "AAAA000000000026", 0x10, 0x4e000)
pwrite64(r1, "AAAA000000000027", 0x10, 0x51000)
fsync(r1)
fallocate(r1, 0x8, 0x9000, 0x3000)
fallocate(r1, 0x20, 0x6000, 0x3000)
fallocate(r1, 0x3, 0x12000, 0xc000)
fallocate(r1, 0x8, 0x3000, 0x3000)
fallocate(r1, 0x8, 0x9000, 0x3000)
fallocate(r1, 0x8, 0xf000, 0x3000)
fallocate(r1, 0x8, 0x15000, 0x3000)
fallocate(r1, 0x8, 0x1b000, 0x3000)
fallocate(r1, 0x20, 0x6000, 0x3000)
fallocate(r1, 0x20, 0xc000, 0x3000)
fallocate(r1, 0x20, 0x12000, 0x3000)
fallocate(r1, 0x20, 0x18000, 0x3000)
fallocate(r1, 0x20, 0x1e000, 0x3000)
fallocate(r1, 0x2, 0x24000, 0x30000)
fsync(r1)
unlinkat(r0, &AUTO='sparse\x00', 0)
ftruncate(r1, 0)
close(r1)
close(r0)
unlinkat(0xffffffffffffff9c, &AUTO='./shift-targeted\x00', 0x200)
