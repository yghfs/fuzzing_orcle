# Extent shift/punch/zero paths with live page-cache mappings.
mkdirat(0xffffffffffffff9c, &AUTO='./range-mmap\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./range-mmap\x00', 0x10000, 0)
r1 = openat$auto(r0, &AUTO='shift\x00', 0x242, 0x180)
fallocate$auto(r1, 0, 0, 0x30000)
pwrite64$auto(r1, "A000000000000000", 0x10, 0)
pwrite64$auto(r1, "A111111111111111", 0x10, 0x4000)
pwrite64$auto(r1, "A222222222222222", 0x10, 0x8000)
pwrite64$auto(r1, "A333333333333333", 0x10, 0x10000)
pwrite64$auto(r1, "A444444444444444", 0x10, 0x18000)
pwrite64$auto(r1, "A555555555555555", 0x10, 0x24000)
fsync$auto(r1)
r2 = mmap$auto(&(0x7f0000000000)=0, 0x30000, 0x3, 0x1, r1, 0)
madvise$auto_MADV_WILLNEED(r2, 0x30000, 0x3)
msync$auto(r2, 0x30000, 0x4)
ioctl$EXT4_IOC_GET_ES_CACHE(r1, EXT4_IOC_GET_ES_CACHE,
    &(0x7f0000001000)={0, 0x40000, 0, 4, 0, {0}})
fallocate$auto(r1, 0x10, 0x2000, 0x4000)
msync$auto(r2, 0x30000, 0x1)
fallocate$auto(r1, 0x2, 0x6000, 0xa000)
madvise$auto_MADV_DONTNEED(r2, 0x10000, 0x4)
fallocate$auto(r1, 0x8, 0x8000, 0x4000)
msync$auto(r2, 0x30000, 0x4)
ioctl$EXT4_IOC_GET_ES_CACHE(r1, EXT4_IOC_GET_ES_CACHE,
    &(0x7f0000001000)={0, 0x40000, 0, 8, 0, {0}})
fallocate$auto(r1, 0x20, 0x4000, 0x4000)
mremap$auto(r2, 0x30000, 0x38000, 0x1, 0)
munmap$auto(r2, 0x38000)
ftruncate$auto(r1, 0x12000)
fallocate$auto(r1, 0x10, 0, 0x8000)
fallocate$auto(r1, 0x2, 0x1000, 0x5000)
ftruncate$auto(r1, 0x32000)
fsync$auto(r1)
close(r1)
close(r0)
