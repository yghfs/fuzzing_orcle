# Namespace replacement races inode lifetime with extent and xattr updates.
mkdirat(0xffffffffffffff9c, &AUTO='./race-targeted\x00', 0x1c0)
r0 = openat(0xffffffffffffff9c, &AUTO='./race-targeted\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='left\x00', 0x242, 0x180)
r2 = openat(r0, &AUTO='right\x00', 0x242, 0x180)
write(r1, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 0x20)
write(r2, "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", 0x20)
fallocate(r1, 0, 0, 0x18000)
fallocate(r2, 0, 0, 0x18000)
linkat(r0, &AUTO='left\x00', r0, &AUTO='alias\x00', 0)
renameat2(r0, &AUTO='left\x00', r0, &AUTO='right\x00', 0x2)
renameat2(r0, &AUTO='alias\x00', r0, &AUTO='left\x00', 0x2)
setxattr(&AUTO='./race-targeted/left\x00', &AUTO='user.race\x00', &AUTO='value\x00', 0x6, 0)
removexattr(&AUTO='./race-targeted/left\x00', &AUTO='user.race\x00')
fallocate(r1, 0x1, 0x2000, 0x8000)
ftruncate(r1, 0x1000)
ftruncate(r2, 0x22000)
fsync(r1)
fsync(r2)
copy_file_range(r1, &(0x7f0000000000)=0, r2, &(0x7f0000000010)=0, 0x8000, 0)
fsetxattr(r1, &AUTO='user.race.fd\x00', &AUTO='descriptor\x00', 0xa, 0)
fremovexattr(r1, &AUTO='user.race.fd\x00')
unlinkat(r0, &AUTO='left\x00', 0)
unlinkat(r0, &AUTO='right\x00', 0)
close(r1)
close(r2)
close(r0)
