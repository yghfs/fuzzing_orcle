# Concentrate inode and directory counter updates: nested creation/removal,
# hard-link accounting, directory exchange, and unlink while handles stay open.
mkdirat(0xffffffffffffff9c, &AUTO='./checker-dir-cycle\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./checker-dir-cycle\x00', 0x10000, 0)
mkdirat(r0, &AUTO='left\x00', 0x1c0)
mkdirat(r0, &AUTO='right\x00', 0x1c0)
mkdirat(r0, &AUTO='left/child\x00', 0x1c0)
mkdirat(r0, &AUTO='right/child\x00', 0x1c0)
r1 = openat(r0, &AUTO='primary\x00', 0x242, 0x180)
r2 = openat(r0, &AUTO='secondary\x00', 0x242, 0x180)
write(r1, "primary-data-0001", 0x12)
write(r2, "secondary-data-01", 0x12)
linkat(r0, &AUTO='primary\x00', r0, &AUTO='left/linked\x00', 0)
linkat(r0, &AUTO='secondary\x00', r0, &AUTO='right/linked\x00', 0)
renameat2(r0, &AUTO='left/linked\x00', r0, &AUTO='right/linked\x00', 0x2)
renameat2(r0, &AUTO='left\x00', r0, &AUTO='right\x00', 0x2)
symlinkat(&AUTO='primary\x00', r0, &AUTO='left/sym\x00')
setxattr(&AUTO='./checker-dir-cycle/left/sym\x00', &AUTO='user.checker.dir\x00', &AUTO='symlink-value\x00', 0xe, 0)
lremovexattr(&AUTO='./checker-dir-cycle/left/sym\x00', &AUTO='user.checker.dir\x00')
unlinkat(r0, &AUTO='left/sym\x00', 0)
unlinkat(r0, &AUTO='primary\x00', 0)
ftruncate(r1, 0x1000)
fsync(r1)
unlinkat(r0, &AUTO='secondary\x00', 0)
unlinkat(r0, &AUTO='right/linked\x00', 0)
unlinkat(r0, &AUTO='left/linked\x00', 0)
close(r2)
close(r1)
unlinkat(r0, &AUTO='left/child\x00', 0x200)
unlinkat(r0, &AUTO='right/child\x00', 0x200)
unlinkat(r0, &AUTO='left\x00', 0x200)
unlinkat(r0, &AUTO='right\x00', 0x200)
close(r0)
syncfs(0xffffffffffffff9c)
