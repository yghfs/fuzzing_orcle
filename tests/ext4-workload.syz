# ext4 metadata lifecycle seed. The runner executes from /tmp/ext4-syzkaller.
mkdirat(0xffffffffffffff9c, &AUTO='./seed\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./seed\x00', 0x10000, 0)
r1 = openat$auto(r0, &AUTO='file0\x00', 0x242, 0x180)
write(r1, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 0x20)
fallocate$auto(r1, 0, 0, 0x8000)
ftruncate$auto(r1, 0x1800)
fsync$auto(r1)
setxattr$auto(&AUTO='./seed/file0\x00', &AUTO='user.ext4_checker\x00', &AUTO='metadata\x00', 0x8, 0)
linkat$auto(r0, &AUTO='file0\x00', r0, &AUTO='hard0\x00', 0)
symlinkat$auto(&AUTO='file0\x00', r0, &AUTO='sym0\x00')
renameat$auto(r0, &AUTO='file0\x00', r0, &AUTO='file1\x00')
mkdirat$auto(r0, &AUTO='dir0\x00', 0x1c0)
r2 = openat$dir(0xffffffffffffff9c, &AUTO='./seed/dir0\x00', 0x10000, 0)
r3 = openat$auto(r2, &AUTO='nested\x00', 0x242, 0x180)
write(r3, "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", 0x20)
fallocate$auto(r3, 0, 0x1000, 0x4000)
fsync$auto(r3)
close(r3)
unlinkat$auto(r2, &AUTO='nested\x00', 0)
close(r2)
unlinkat$auto(r0, &AUTO='hard0\x00', 0)
unlinkat$auto(r0, &AUTO='sym0\x00', 0)
unlinkat$auto(r0, &AUTO='file1\x00', 0)
unlinkat$auto(r0, &AUTO='dir0\x00', 0x200)
close(r1)
close(r0)
