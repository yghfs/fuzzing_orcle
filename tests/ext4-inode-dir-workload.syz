# Inode and directory accounting: nested mkdir/rmdir, hard links, rename,
# failed removals, and unlink while descriptors remain open.
mkdirat(0xffffffffffffff9c, &AUTO='./inode\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./inode\x00', 0x10000, 0)
mkdirat(r0, &AUTO='a\x00', 0x1c0)
mkdirat(r0, &AUTO='b\x00', 0x1c0)
mkdirat(r0, &AUTO='a/c\x00', 0x1c0)
r1 = openat$auto(r0, &AUTO='file\x00', 0x242, 0x180)
write(r1, "CCCCCCCCCCCCCCCC", 0x10)
linkat$auto(r0, &AUTO='file\x00', r0, &AUTO='file.link\x00', 0)
renameat2$auto(r0, &AUTO='file.link\x00', r0, &AUTO='b/moved\x00', 0)
symlinkat$auto(&AUTO='moved\x00', r0, &AUTO='b/sym\x00')
unlinkat$auto(r0, &AUTO='file\x00', 0)
unlinkat$auto(r0, &AUTO='a/c\x00', 0x200)
mkdirat(r0, &AUTO='a/c\x00', 0x1c0)
unlinkat$auto(r0, &AUTO='b/sym\x00', 0)
unlinkat$auto(r0, &AUTO='b/moved\x00', 0)
close(r1)
unlinkat$auto(r0, &AUTO='a/c\x00', 0x200)
unlinkat$auto(r0, &AUTO='a\x00', 0x200)
unlinkat$auto(r0, &AUTO='b\x00', 0x200)
close(r0)
unlinkat$auto(0xffffffffffffff9c, &AUTO='./inode\x00', 0x200)
