# Concentrate directory/inode accounting and namespace replacement: nested
# directories, hard links, symlinks, device nodes, and exchange renames.
mkdirat(0xffffffffffffff9c, &AUTO='./dir-counter-targeted\x00', 0x1c0)
r0 = openat(0xffffffffffffff9c, &AUTO='./dir-counter-targeted\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='left\x00', 0x242, 0x180)
r2 = openat(r0, &AUTO='right\x00', 0x242, 0x180)
write(r1, "left-data-0000001", 0x11)
write(r2, "right-data-00001", 0x10)
mkdirat(r0, &AUTO='a\x00', 0x1c0)
mkdirat(r0, &AUTO='b\x00', 0x1c0)
mkdirat(r0, &AUTO='a/child\x00', 0x1c0)
mkdirat(r0, &AUTO='b/child\x00', 0x1c0)
linkat(r0, &AUTO='left\x00', r0, &AUTO='a/hard\x00', 0)
symlinkat(&AUTO='left\x00', r0, &AUTO='b/link\x00')
mknodat(r0, &AUTO='node\x00', 0x1000, 0)
chmod(&AUTO='./dir-counter-targeted/left\x00', 0x1a4)
fchmod(r1, 0x1a0)
chown(&AUTO='./dir-counter-targeted/right\x00', 0, 0)
fchown(r2, 0, 0)
renameat2(r0, &AUTO='left\x00', r0, &AUTO='right\x00', 0x2)
renameat2(r0, &AUTO='a\x00', r0, &AUTO='b\x00', 0x2)
unlinkat(r0, &AUTO='a/hard\x00', 0)
unlinkat(r0, &AUTO='b/link\x00', 0)
unlinkat(r0, &AUTO='node\x00', 0)
unlinkat(r0, &AUTO='a/child\x00', 0x200)
unlinkat(r0, &AUTO='b/child\x00', 0x200)
unlinkat(r0, &AUTO='a\x00', 0x200)
unlinkat(r0, &AUTO='b\x00', 0x200)
unlinkat(r0, &AUTO='left\x00', 0)
unlinkat(r0, &AUTO='right\x00', 0)
close(r2)
close(r1)
close(r0)
syncfs(0xffffffffffffff9c)
