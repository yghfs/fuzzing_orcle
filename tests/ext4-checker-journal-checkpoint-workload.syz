# Interleave real journal flushes with inode/extent metadata transactions so
# checker transaction events are stressed at allocation, rename, and orphan
# boundaries.  Flags=0 performs a normal ext4 journal checkpoint/flush.
mkdirat(0xffffffffffffff9c, &AUTO='./checker-journal-cycle\x00', 0x1c0)
r0 = openat$dir(0xffffffffffffff9c, &AUTO='./checker-journal-cycle\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='active\x00', 0x242, 0x180)
r2 = openat(r0, &AUTO='replacement\x00', 0x242, 0x180)
fallocate(r1, 0, 0, 0x20000)
fallocate(r2, 0, 0, 0x20000)
pwrite64(r1, "ACTIVE-000000001", 0x10, 0)
pwrite64(r1, "ACTIVE-000000002", 0x10, 0x8000)
pwrite64(r2, "REPLACE-00000001", 0x10, 0)
fsetxattr(r1, &AUTO='user.checkpoint.a\x00', &AUTO='checkpoint-value-a\x00', 0x13, 0)
fsetxattr(r1, &AUTO='user.checkpoint.b\x00', &AUTO='checkpoint-value-b\x00', 0x13, 0)
fsync(r1)
ioctl$EXT4_IOC_CHECKPOINT(r1, 1074030123, &(0x7f0000000000)=0)
linkat(r0, &AUTO='active\x00', r0, &AUTO='alias\x00', 0)
renameat2(r0, &AUTO='alias\x00', r0, &AUTO='replacement\x00', 0x2)
ioctl$EXT4_IOC_CHECKPOINT(r2, 1074030123, &(0x7f0000000000)=0)
unlinkat(r0, &AUTO='active\x00', 0)
unlinkat(r0, &AUTO='replacement\x00', 0)
ftruncate(r1, 0x3000)
fallocate(r1, 0x3, 0x1000, 0x1000)
fsync(r1)
ioctl$EXT4_IOC_CHECKPOINT(r1, 1074030123, &(0x7f0000000000)=0)
fremovexattr(r1, &AUTO='user.checkpoint.a\x00')
ftruncate(r2, 0)
unlinkat(r0, &AUTO='alias\x00', 0)
close(r2)
close(r1)
mkdirat(r0, &AUTO='subdir\x00', 0x1c0)
unlinkat(r0, &AUTO='subdir\x00', 0x200)
close(r0)
syncfs(0xffffffffffffff9c)
