# Extent shift/punch/zero transitions with a live page-cache mapping.
mkdirat(0xffffffffffffff9c, &AUTO='./range-targeted\x00', 0x1c0)
r0 = openat(0xffffffffffffff9c, &AUTO='./range-targeted\x00', 0x10000, 0)
r1 = openat(r0, &AUTO='shift\x00', 0x242, 0x180)
fallocate(r1, 0, 0, 0x30000)
pwrite64(r1, "A000000000000000", 0x10, 0)
pwrite64(r1, "A111111111111111", 0x10, 0x4000)
pwrite64(r1, "A222222222222222", 0x10, 0x8000)
pwrite64(r1, "A333333333333333", 0x10, 0x10000)
pwrite64(r1, "A444444444444444", 0x10, 0x18000)
pwrite64(r1, "A555555555555555", 0x10, 0x24000)
fsync(r1)
r2 = mmap(&(0x7f0000000000)=0, 0x30000, 0x3, 0x1, r1, 0)
madvise(r2, 0x30000, 0x3)
msync(r2, 0x30000, 0x4)
ioctl$EXT4_IOC_GET_ES_CACHE(r1, 3223348778, &(0x7f0000001000)={0, 0x40000, 0, 4, 0, {0}})
fallocate(r1, 0x10, 0x2000, 0x4000)
msync(r2, 0x30000, 0x1)
fallocate(r1, 0x2, 0x6000, 0xa000)
madvise(r2, 0x10000, 0x4)
fallocate(r1, 0x8, 0x8000, 0x4000)
msync(r2, 0x30000, 0x4)
ioctl$EXT4_IOC_GET_ES_CACHE(r1, 3223348778, &(0x7f0000001000)={0, 0x40000, 0, 8, 0, {0}})
fallocate(r1, 0x20, 0x4000, 0x4000)
mremap(r2, 0x30000, 0x38000, 0x1, 0)
munmap(r2, 0x38000)
ftruncate(r1, 0x12000)
fallocate(r1, 0x10, 0, 0x8000)
fallocate(r1, 0x2, 0x1000, 0x5000)
ftruncate(r1, 0x32000)
fsync(r1)
close(r1)
close(r0)
