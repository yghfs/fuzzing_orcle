# Downloaded, extracted, or generated Linux source trees.
/kernel/
/experiments/*/kernel/
/experiments/*/dev/
/experiments/*/build/
/experiments/*/kernel/
/experiments/*/source/*.tar.xz
/experiments/*/source/*.tar.xz.*
