/experiments/*/research/2026-10-31-single-random-fault/**/*.jsonl
/experiments/*/research/2026-10-31-single-random-fault/**/*.raw
/experiments/*/research/2026-10-31-single-random-fault/**/*.tsv
/experiments/*/initramfs/bin/
/work/syzkaller/
*.img
*.qcow2
*.raw
*.cpio.gz
*.bzImage

