#!/bin/busybox sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /sys/kernel/tracing /mnt
mount -t tracefs tracefs /sys/kernel/tracing 2>/dev/null || true
TRACE=/sys/kernel/tracing
mount -t ext4 -o errors=continue,noatime,inode_readahead_blks=0 /dev/vda /mnt || {
	echo MOUNT_FAILED
	exec /bin/busybox poweroff -f
}
cd /mnt/p || { echo PARENT_LOOKUP_FAILED; exec /bin/busybox poweroff -f; }
echo "PRECONDITION parent=$(stat -c %i .) target=$(stat -c %i file)"
exec 3<> file || { echo TARGET_OPEN_FAILED; exec /bin/busybox poweroff -f; }
exec 4<> arm || { echo ARMFILE_OPEN_FAILED; exec /bin/busybox poweroff -f; }
sync
echo "QMP_READY parent_inode=$(stat -c %i .) target_inode=$(stat -c %i file)"
read -r answer </dev/console
/bin/busybox blockdev --flushbufs /dev/vda
echo "BLOCKDEV_FLUSHBUFS_RESULT rc=$?"

if [ ! -w "$TRACE/kprobe_events" ]; then
	echo TRACE_SETUP_ERROR=no-kprobe-events
	exec /bin/busybox poweroff -f
fi
echo 0 > "$TRACE/tracing_on"
echo > "$TRACE/trace"
echo 'p:unlink_mainline/abort jbd2_journal_abort' > "$TRACE/kprobe_events" || {
	echo TRACE_SETUP_ERROR=abort-probe
	exec /bin/busybox poweroff -f
}
echo 'p:unlink_mainline/stop jbd2_journal_stop comm=$comm handle=$arg1:x64 tx=+0($arg1):x64 tid=+8(+0($arg1)):u32 state=+12(+0($arg1)):u32 h_err=+32($arg1):s32 h_aborted=+36($arg1):b1@2/8' >> "$TRACE/kprobe_events" || {
	echo TRACE_SETUP_ERROR=stop-probe
	exec /bin/busybox poweroff -f
}
echo 'r:unlink_mainline/stop_ret jbd2_journal_stop handle=$arg1:x64 ret=$retval:s32' >> "$TRACE/kprobe_events" || {
	echo TRACE_SETUP_ERROR=stop-return-probe
	exec /bin/busybox poweroff -f
}
echo 1 > "$TRACE/events/unlink_mainline/abort/enable"
echo 1 > "$TRACE/events/unlink_mainline/stop/enable"
echo 1 > "$TRACE/events/unlink_mainline/stop_ret/enable"
if [ -w "$TRACE/events/jbd2/jbd2_start_commit/enable" ] &&
	[ -w "$TRACE/events/jbd2/jbd2_end_commit/enable" ]; then
	echo 1 > "$TRACE/events/jbd2/jbd2_start_commit/enable"
	echo 1 > "$TRACE/events/jbd2/jbd2_end_commit/enable"
else
	echo TRACE_SETUP_ERROR=no-jbd2-commit-tracepoints
	exec /bin/busybox poweroff -f
fi
echo TRACE_SETUP_OK
echo 1 > "$TRACE/tracing_on"
/bin/fault-workload unlink file
WORKLOAD_RC=$?
echo "WORKLOAD_RC=$WORKLOAD_RC"
echo QMP_RESULT_READY
read -r answer </dev/console
sync
exec 3>&- 4>&-
cd /
umount /mnt
UMOUNT_RC=$?
echo "UNMOUNT_RESULT rc=$UMOUNT_RC"
echo 0 > "$TRACE/tracing_on"
echo "JBD2_ABORT_HITS=$(grep -c 'unlink_mainline/abort:' "$TRACE/trace" || true)"
echo JBD2_TRACE_BEGIN
cat "$TRACE/trace"
echo JBD2_TRACE_END
exec /bin/busybox poweroff -f
