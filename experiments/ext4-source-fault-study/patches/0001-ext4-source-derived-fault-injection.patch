+		"unlink_parent_global_abort",
+	[EXT4_SOURCE_FAULT_UNLINK_PARENT_INODE_READ] =
+		"unlink_parent_inode_read",
+	[EXT4_SOURCE_FAULT_UNLINK_TARGET_DIRTY] = "unlink_target_inode_dirty",
+	[EXT4_SOURCE_FAULT_RENAME_NEW_DIRENT_ACCESS] = "rename_new_dirent_access",
