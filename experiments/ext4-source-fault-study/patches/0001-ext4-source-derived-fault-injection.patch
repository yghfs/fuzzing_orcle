+
+static const char *ext4_source_fault_errno_name(int error)
+{
+	switch (-error) {
+	case EIO:
+		return "EIO";
+	case ENOMEM:
+		return "ENOMEM";
+	case ENOSPC:
+		return "ENOSPC";
+	case EROFS:
+		return "EROFS";
+	case EUCLEAN:
+		return "EUCLEAN";
+	case EINVAL:
+		return "EINVAL";
+	default:
+		return "unknown";
+	}
+}
+
+static int ext4_source_fault_parse_errno(const char *name)
+{
+	if (!strcmp(name, "EIO"))
+		return -EIO;
+	if (!strcmp(name, "ENOMEM"))
+		return -ENOMEM;
+	if (!strcmp(name, "ENOSPC"))
+		return -ENOSPC;
+	if (!strcmp(name, "EROFS"))
+		return -EROFS;
+	if (!strcmp(name, "EFSCORRUPTED"))
+		return -EFSCORRUPTED;
+	if (!strcmp(name, "EUCLEAN"))
+		return -EUCLEAN;
+	if (!strcmp(name, "EINVAL"))
+		return -EINVAL;
+	return 1;
+}
+
+static bool ext4_source_fault_errno_valid(enum ext4_source_fault_op op,
+					  int error)
+{
+	switch (op) {
+	case EXT4_SOURCE_FAULT_EVICT_INITIAL_DIRTY:
+	case EXT4_SOURCE_FAULT_EVICT_FINAL_DIRTY:
+	case EXT4_SOURCE_FAULT_RMDIR_CHILD_DIRTY:
+	case EXT4_SOURCE_FAULT_RMDIR_PARENT_DIRTY:
+	case EXT4_SOURCE_FAULT_UNLINK_PARENT_DIRTY:
+	case EXT4_SOURCE_FAULT_UNLINK_TARGET_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_SOURCE_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_NEW_PARENT_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_OLD_PARENT_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_REPLACED_DIRTY:
+	case EXT4_SOURCE_FAULT_MKDIR_CHILD_DIRTY:
+	case EXT4_SOURCE_FAULT_MKDIR_PARENT_DIRTY:
+		return error == -EIO || error == -ENOMEM ||
+		       error == -ENOSPC || error == -EROFS ||
+		       error == -EFSCORRUPTED || error == -EUCLEAN ||
+		       error == -EINVAL;
+	case EXT4_SOURCE_FAULT_UNLINK_PARENT_RESERVE:
+		/* After inode-location success, ext4_reserve_inode_write()
+		 * reaches journal write access, whose error set is EIO/EROFS.
+		 */
+		return error == -EIO || error == -EROFS;
+	case EXT4_SOURCE_FAULT_UNLINK_PARENT_GLOBAL_ABORT:
+	case EXT4_SOURCE_FAULT_UNLINK_PARENT_INODE_READ:
+		return error == -EIO;
+	case EXT4_SOURCE_FAULT_ORPHAN_DELETE_ACCESS:
+	case EXT4_SOURCE_FAULT_XATTR_RELEASE_ACCESS:
+		return error == -EIO;
+	case EXT4_SOURCE_FAULT_RMDIR_DIRENT_ACCESS:
+	case EXT4_SOURCE_FAULT_UNLINK_DIRENT_ACCESS:
+	case EXT4_SOURCE_FAULT_RENAME_NEW_DIRENT_ACCESS:
+	case EXT4_SOURCE_FAULT_RENAME_OLD_DIRENT_ACCESS:
+	case EXT4_SOURCE_FAULT_MKDIR_ADD_ENTRY_ACCESS:
+	case EXT4_SOURCE_FAULT_RENAME_EXCHANGE_FIRST_ACCESS:
+	case EXT4_SOURCE_FAULT_RENAME_EXCHANGE_SECOND_ACCESS:
+	case EXT4_SOURCE_FAULT_RENAME_OLD_DOTDOT_ACCESS:
+	case EXT4_SOURCE_FAULT_RENAME_NEW_DOTDOT_ACCESS:
+		return error == -EIO || error == -EROFS;
+	case EXT4_SOURCE_FAULT_ORPHAN_DELETE_DIRTY:
+	case EXT4_SOURCE_FAULT_GROUP_EXTEND_BITMAP_DIRTY:
+	case EXT4_SOURCE_FAULT_GROUP_EXTEND_DESC_DIRTY:
+	case EXT4_SOURCE_FAULT_GROUP_ADD_SUPER_DIRTY:
+		/* These hooks pass inode == NULL.  The no-journal dirtying path
+		 * cannot return EIO here; only JBD2's return set applies.
+		 */
+		return error == -ENOSPC || error == -EROFS ||
+		       error == -EUCLEAN || error == -EINVAL;
+	case EXT4_SOURCE_FAULT_XATTR_RELEASE_DIRTY:
+	case EXT4_SOURCE_FAULT_RMDIR_DIRENT_DIRTY:
+	case EXT4_SOURCE_FAULT_UNLINK_DIRENT_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_NEW_DIRENT_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_OLD_DIRENT_DIRTY:
+	case EXT4_SOURCE_FAULT_MKDIR_CHILD_DIRENT_DIRTY:
+	case EXT4_SOURCE_FAULT_MKDIR_ADD_ENTRY_DIRTY:
+		return error == -EIO || error == -ENOSPC || error == -EROFS ||
+		       error == -EUCLEAN || error == -EINVAL;
+	case EXT4_SOURCE_FAULT_GROUP_ADD_GROUPINFO:
+		return error == -ENOMEM;
+	case EXT4_SOURCE_FAULT_RENAME_EXCHANGE_FIRST_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_EXCHANGE_SECOND_DIRTY:
+		return error == -EIO || error == -ENOSPC || error == -EROFS ||
+		       error == -EUCLEAN || error == -EINVAL;
+	case EXT4_SOURCE_FAULT_RENAME_EXCHANGE_FIRST_INODE_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_EXCHANGE_SECOND_INODE_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_OLD_DOTDOT_DIRTY:
+	case EXT4_SOURCE_FAULT_RENAME_NEW_DOTDOT_DIRTY:
+		return error == -EIO || error == -ENOMEM || error == -ENOSPC ||
+		       error == -EROFS || error == -EFSCORRUPTED ||
+		       error == -EUCLEAN || error == -EINVAL;
+	case EXT4_SOURCE_FAULT_GROUP_EXTEND_BUDDY_LOAD:
+		return error == -ENOMEM || error == -EIO ||
+		       error == -EFSCORRUPTED || error == -EINVAL;
+	case EXT4_SOURCE_FAULT_RENAME_OLD_LOOKUP:
+		return error == -ENOMEM || error == -EIO ||
+		       error == -EFSCORRUPTED;
+	case EXT4_SOURCE_FAULT_NONE:
+	case EXT4_SOURCE_FAULT_MAX:
+		return false;
+	}
+	return false;
+}
+
+static enum ext4_source_fault_op ext4_source_fault_parse_op(const char *name)
+{
+	enum ext4_source_fault_op op;
+
+	for (op = EXT4_SOURCE_FAULT_EVICT_INITIAL_DIRTY;
+	     op < EXT4_SOURCE_FAULT_MAX; op++) {
+		if (!strcmp(name, ext4_source_fault_names[op]))
+			return op;
+	}
+	return EXT4_SOURCE_FAULT_NONE;
+}
+
+int ext4_source_fault_take(struct super_block *sb,
+			   enum ext4_source_fault_op op)
+{
+	unsigned long flags;
+	int error = 0;
+
+	if (op <= EXT4_SOURCE_FAULT_NONE || op >= EXT4_SOURCE_FAULT_MAX)
+		return 0;
+
+	spin_lock_irqsave(&ext4_source_fault_lock, flags);
+	if (ext4_source_fault_state.armed && ext4_source_fault_state.op == op) {
+		error = ext4_source_fault_state.error;
+		ext4_source_fault_state.armed = false;
+		ext4_source_fault_state.hits++;
+	}
+	spin_unlock_irqrestore(&ext4_source_fault_lock, flags);
+
+	if (error)
+		pr_info_ratelimited("EXT4 source fault: dev=%s op=%s error=%s (%d)\n",
+				    sb ? sb->s_id : "unknown",
+				    ext4_source_fault_names[op],
+				    ext4_source_fault_errno_name(error), error);
+	return error;
+}
+
+static ssize_t ext4_source_fault_read(struct file *file, char __user *user_buf,
+				      size_t count, loff_t *ppos)
+{
+	char buf[160];
+	unsigned long flags;
+	enum ext4_source_fault_op op;
+	int error;
+	u64 hits;
+	bool armed;
+	int len;
+
+	spin_lock_irqsave(&ext4_source_fault_lock, flags);
+	op = ext4_source_fault_state.op;
+	error = ext4_source_fault_state.error;
+	hits = ext4_source_fault_state.hits;
+	armed = ext4_source_fault_state.armed;
+	spin_unlock_irqrestore(&ext4_source_fault_lock, flags);
+
+	if (armed)
+		len = scnprintf(buf, sizeof(buf), "%s %s armed=1 hits=%llu\n",
+				ext4_source_fault_names[op],
+				ext4_source_fault_errno_name(error), hits);
+	else
+		len = scnprintf(buf, sizeof(buf), "off hits=%llu\n", hits);
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static ssize_t ext4_source_fault_write(struct file *file,
+				       const char __user *user_buf,
+				       size_t count, loff_t *ppos)
+{
+	char input[96], *cursor, *op_name, *errno_name;
+	enum ext4_source_fault_op op;
+	unsigned long flags;
+	int error;
+
+	if (!count || count >= sizeof(input))
+		return -EINVAL;
+	if (copy_from_user(input, user_buf, count))
+		return -EFAULT;
+	input[count] = '\0';
+	strim(input);
+
+	if (!strcmp(input, "off")) {
+		spin_lock_irqsave(&ext4_source_fault_lock, flags);
+		ext4_source_fault_state.armed = false;
+		ext4_source_fault_state.op = EXT4_SOURCE_FAULT_NONE;
+		ext4_source_fault_state.error = 0;
+		spin_unlock_irqrestore(&ext4_source_fault_lock, flags);
+		return count;
+	}
+
+	cursor = input;
+	op_name = strsep(&cursor, " \t");
+	if (!cursor)
+		return -EINVAL;
+	op_name = strim(op_name);
+	errno_name = strim(cursor);
+	if (!*op_name || !*errno_name || strpbrk(errno_name, " \t"))
+		return -EINVAL;
+
+	op = ext4_source_fault_parse_op(op_name);
+	if (op == EXT4_SOURCE_FAULT_NONE)
+		return -EINVAL;
+	error = ext4_source_fault_parse_errno(errno_name);
+	if (error > 0 || !ext4_source_fault_errno_valid(op, error))
+		return -EINVAL;
+
+	spin_lock_irqsave(&ext4_source_fault_lock, flags);
+	ext4_source_fault_state.op = op;
+	ext4_source_fault_state.error = error;
+	ext4_source_fault_state.hits = 0;
+	ext4_source_fault_state.armed = true;
+	spin_unlock_irqrestore(&ext4_source_fault_lock, flags);
+	return count;
+}
+
+static const struct file_operations ext4_source_fault_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ext4_source_fault_read,
+	.write = ext4_source_fault_write,
+	.llseek = default_llseek,
+};
+
+int ext4_source_fault_init(void)
+{
+	ext4_source_fault_dir = debugfs_create_dir("ext4-source-fault", NULL);
+	if (IS_ERR_OR_NULL(ext4_source_fault_dir))
+		return ext4_source_fault_dir ? PTR_ERR(ext4_source_fault_dir) :
+			-ENOMEM;
+	if (IS_ERR_OR_NULL(debugfs_create_file("control", 0600,
+					       ext4_source_fault_dir, NULL,
+					       &ext4_source_fault_fops))) {
+		debugfs_remove_recursive(ext4_source_fault_dir);
+		ext4_source_fault_dir = NULL;
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+void ext4_source_fault_exit(void)
+{
+	debugfs_remove_recursive(ext4_source_fault_dir);
+	ext4_source_fault_dir = NULL;
+}
