+/* Checker hooks can run with ext4 group locks held; never sleep here. */
+static bool checker_barrier_read_trylock(struct ext4_sb_info *sbi)
+{
+	return down_read_trylock(&sbi->s_checker_barrier);
+}
+
+static void checker_barrier_read_unlock(struct ext4_sb_info *sbi, bool locked)
+{
+	if (locked)
+		up_read(&sbi->s_checker_barrier);
+}
+
+/*
+ * Enter the checker event critical section without sleeping.  Most ext4
+ * hooks run while a filesystem lock is held, so taking the barrier with
+ * down_read() is not safe here.  A failed trylock is normally a snapshot in
+ * progress, but it can also mean that ext4_checker_stop() is waiting to free
+ * the event ring.  Recheck s_checker_active while holding the checker lock so
+ * a hook which observed the old value cannot dereference the ring after it is
+ * freed.  checker_stop() takes the same lock before freeing the ring.
+ */
+static bool checker_event_lock(struct ext4_sb_info *sbi,
+				      bool *barrier_locked)
+{
+	*barrier_locked = checker_barrier_read_trylock(sbi);
+	spin_lock(&sbi->s_checker_lock);
+	if (!*barrier_locked && !READ_ONCE(sbi->s_checker_active)) {
+		spin_unlock(&sbi->s_checker_lock);
+		return false;
+	}
+	return true;
+}
