+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit fault injection for validating suspected ext4 error paths. */
+
+#include <linux/atomic.h>
+#include <linux/kstrtox.h>
+#include <linux/module.h>
+
+#include "fault-inject.h"
+
+static int fault_mode;
+static atomic_t fault_seen = ATOMIC_INIT(0);
+static atomic_t pending_alloc_seen = ATOMIC_INIT(0);
+static atomic_t mballoc_mark_seen = ATOMIC_INIT(0);
+static atomic_t project_transfer_seen = ATOMIC_INIT(0);
+
+static int fault_mode_set(const char *val, const struct kernel_param *kp)
+{
+	int mode, ret;
+
+	ret = kstrtoint(val, 0, &mode);
+	if (ret)
+		return ret;
+	if (mode != 0 && (mode < 5 || mode > 36))
+		return -EINVAL;
+	WRITE_ONCE(*(int *)kp->arg, mode);
+	return 0;
+}
+
+static const struct kernel_param_ops fault_mode_ops = {
+	.set = fault_mode_set,
+	.get = param_get_int,
+};
+module_param_cb(ext4_fault_mode, &fault_mode_ops, &fault_mode, 0600);
+MODULE_PARM_DESC(ext4_fault_mode,
+		"candidate validation only: 0 disables injection; modes 5..33 "
+		"select an ext4 failure (see tests/README.md)");
+
+static bool fault_take(int fault)
+{
+	return READ_ONCE(fault_mode) == fault &&
+		atomic_cmpxchg(&fault_seen, 0, 1) == 0;
+}
+
+bool ext4_fault_inject_pending_alloc(void)
+{
+	if (READ_ONCE(fault_mode) != 5)
+		return false;
+	if (atomic_inc_return(&pending_alloc_seen) != 2)
+		return false;
+	pr_warn("EXT4 candidate validation fault: failed second pending reservation allocation\n");
+	return true;
+}
+
+bool ext4_fault_inject_mballoc_mark(void)
+{
+	if (READ_ONCE(fault_mode) != 6 ||
+	    atomic_cmpxchg(&mballoc_mark_seen, 0, 1) != 0)
+		return false;
+	pr_warn("EXT4 candidate validation fault: mballoc error after bitmap update\n");
+	return true;
+}
+
+bool ext4_fault_inject_resize_group_add(void)
+{
+	if (!fault_take(7))
+		return false;
+	pr_warn("EXT4 candidate validation fault: resize group block addition failed\n");
+	return true;
+}
+
+bool ext4_fault_inject_group_add_super(void)
+{
+	if (!fault_take(8))
