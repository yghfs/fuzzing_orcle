+	switch (model) {
+	case EXT4_CHECKER_MODEL_BLOCK_BITMAP: return EXT4_CHECKER_EVENT_COUNTER;
+	case EXT4_CHECKER_MODEL_RESERVATION: return EXT4_CHECKER_EVENT_RESERVATION;
+	case EXT4_CHECKER_MODEL_EA_REFERENCES: return EXT4_CHECKER_EVENT_EA_REFERENCE;
+	case EXT4_CHECKER_MODEL_EXTENT_BLOCKS: return EXT4_CHECKER_EVENT_INODE_BLOCKS;
