+/*
+ * Walk actual directory entries, including htree leaves and inline data.
+ * Htree index blocks are not directory entries; the htree root's real dot
+ * entries are retained because its fake index dirent has inode == 0.
+ */
+int ext4_checker_scan_dir(struct inode *dir,
+			  int (*emit)(u32 ino, void *data), void *data)
+{
+	struct super_block *sb = dir->i_sb;
+	struct ext4_checker_dir_scan scan = {
+		.ctx = {
+			.actor = ext4_checker_dir_emit,
+			.pos = 0,
+		},
+		.emit = emit,
+		.data = data,
+	};
+	struct dir_private_info info = {
+		.cookie = inode_peek_iversion(dir),
+	};
+	struct file fake_file = {
+		.f_inode = dir,
+		.private_data = &info,
+	};
+	unsigned int block, blocks;
+	int has_inline_data = 1;
+	int err;
+
+	down_read(&dir->i_rwsem);
+	if (ext4_has_inline_data(dir)) {
+		err = ext4_read_inline_dir(&fake_file, &scan.ctx,
+					  &has_inline_data);
+		if (scan.err)
+			err = scan.err;
+		goto out;
+	}
+
+	blocks = DIV_ROUND_UP_ULL(i_size_read(dir), sb->s_blocksize);
+	if (!blocks) {
+		err = -EFSCORRUPTED;
+		goto out;
+	}
+	for (block = 0; block < blocks; block++) {
+		struct buffer_head *bh;
+		struct ext4_dir_entry_2 *de;
+		unsigned int offset = 0;
+		unsigned int limit;
+
+		bh = ext4_read_dirblock(dir, block,
+					is_dx(dir) && !block ? INDEX :
+					DIRENT_HTREE);
+		if (IS_ERR(bh)) {
+			err = PTR_ERR(bh);
+			goto out;
+		}
+		if (!bh)
+			continue;
+		if (block && is_dx_internal_node(dir, block,
+					(struct ext4_dir_entry *)bh->b_data)) {
+			brelse(bh);
+			bh = ext4_read_dirblock(dir, block, INDEX);
+			if (IS_ERR(bh)) {
+				err = PTR_ERR(bh);
+				goto out;
+			}
+			if (bh)
+				brelse(bh);
+			continue;
+		}
+		limit = bh->b_size;
+		if (ext4_has_metadata_csum(sb))
+			limit -= sizeof(struct ext4_dir_entry_tail);
+		while (offset < limit) {
+			unsigned int rec_len;
+
+			de = (struct ext4_dir_entry_2 *)(bh->b_data + offset);
+			if (ext4_check_dir_entry(dir, NULL, de, bh, bh->b_data,
+						 limit, offset)) {
+				err = -EFSCORRUPTED;
+				brelse(bh);
+				goto out;
+			}
+			if (le32_to_cpu(de->inode)) {
+				err = emit(le32_to_cpu(de->inode), data);
+				if (err) {
+					brelse(bh);
+					goto out;
+				}
+			}
+			rec_len = ext4_rec_len_from_disk(de->rec_len,
+							 sb->s_blocksize);
+			offset += rec_len;
+		}
+		brelse(bh);
+	}
+	err = 0;
+out:
+	up_read(&dir->i_rwsem);
+	return err;
+}
