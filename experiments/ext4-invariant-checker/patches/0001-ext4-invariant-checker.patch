+static void ext4_mb_pending_totals(struct super_block *sb, u64 *pending,
+				   u64 *tracked)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	ext4_group_t group;
+
+	*tracked = 0;
+	for (group = 0; group < ext4_get_groups_count(sb); group++) {
+		struct ext4_group_info *grp = ext4_get_group_info(sb, group);
+		struct rb_node *node;
+
+		if (!grp)
+			continue;
+		ext4_lock_group(sb, group);
+		for (node = rb_first(&grp->bb_free_root); node;
+		     node = rb_next(node)) {
+			struct ext4_free_data *entry =
+				rb_entry(node, struct ext4_free_data, efd_node);
+
+			*tracked += entry->efd_count;
+		}
+		ext4_unlock_group(sb, group);
+	}
+	spin_lock(&sbi->s_md_lock);
+	*pending = sbi->s_mb_free_pending;
+	spin_unlock(&sbi->s_md_lock);
+}
+
+/*
+ * Bracket pending-free tree/counter updates so a full RB-tree scan can reject
+ * a checkpoint or free operation that overlaps the observation window.
+ */
+bool ext4_mb_pending_snapshot(struct super_block *sb, u64 *pending,
+			     u64 *tracked)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	u64 seq;
+
+	if (atomic_read(&sbi->s_mb_pending_updates))
+		return false;
+	seq = atomic64_read(&sbi->s_mb_pending_seq);
+	smp_mb();
+	if (atomic_read(&sbi->s_mb_pending_updates))
+		return false;
+
+	ext4_mb_pending_totals(sb, pending, tracked);
+	smp_mb();
+	if (atomic_read(&sbi->s_mb_pending_updates) ||
+	    seq != atomic64_read(&sbi->s_mb_pending_seq))
+		return false;
+	return true;
+}
+
+/* Compare mballoc's cached free count with its in-memory block bitmap. */
+bool ext4_checker_mb_buddy_snapshot(struct super_block *sb, u64 *checks,
+					    u64 *violations, u64 *unverified,
+					    u32 *bad_group, u32 *bad_expected,
+					    u32 *bad_actual)
+{
+	struct ext4_group_info *grp;
+	struct ext4_buddy e4b;
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	ext4_group_t group;
+
+	*checks = 0;
+	*violations = 0;
+	*unverified = 0;
+	*bad_group = 0;
+	*bad_expected = 0;
+	*bad_actual = 0;
+	for (group = 0; group < ext4_get_groups_count(sb); group++) {
+		ext4_grpblk_t max;
+		s32 bitmap_free;
+		u32 buddy_free;
+		int err;
+
+		err = ext4_mb_load_buddy(sb, group, &e4b);
+		if (err) {
+			(*unverified)++;
+			continue;
+		}
+		grp = e4b.bd_info;
+		max = ext4_num_clusters_in_group(sb, group);
+		if (!grp || !e4b.bd_bitmap || EXT4_MB_GRP_NEED_INIT(grp) ||
+		    !max || max > (sb->s_blocksize << 3)) {
+			(*unverified)++;
+			ext4_mb_unload_buddy(&e4b);
+			continue;
+		}
+		ext4_lock_group(sb, group);
+		bitmap_free = ext4_count_free(e4b.bd_bitmap, max / 8);
+		buddy_free = grp->bb_free;
+		ext4_unlock_group(sb, group);
+		ext4_mb_unload_buddy(&e4b);
+		(*checks)++;
+		if (bitmap_free == buddy_free)
+			continue;
+		(*violations)++;
+		if (*violations == 1) {
+			*bad_group = group;
+			*bad_expected = buddy_free;
+			*bad_actual = bitmap_free;
+		}
+	}
+	(void)sbi;
+	return true;
+}
