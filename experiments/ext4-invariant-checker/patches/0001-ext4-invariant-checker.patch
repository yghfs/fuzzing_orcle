+static bool ext4_checker_dir_emit(struct dir_context *ctx, const char *name,
+				  int namelen, loff_t offset, u64 ino,
+				  unsigned int d_type)
+{
+	struct ext4_checker_dir_scan *scan =
+		container_of(ctx, struct ext4_checker_dir_scan, ctx);
+
+	if (ino > U32_MAX) {
+		scan->err = -EFSCORRUPTED;
+		return false;
+	}
+	scan->err = scan->emit(ino, scan->data);
+	return !scan->err;
