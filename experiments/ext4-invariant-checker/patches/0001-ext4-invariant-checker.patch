+	checker_reservation_locked(inode, "fsync");
+	read_unlock(&EXT4_I(inode)->i_es_lock);
+	if (!down_read_trylock(&EXT4_I(inode)->i_data_sem)) {
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_EXTENT_BLOCKS,
+					"inode_check", 0, 0, 0, false);
+		return;
+	}
+	ext4_checker_extent_blocks(inode);
+	up_read(&EXT4_I(inode)->i_data_sem);
+}
+
+static const char *checker_tx_source_name(enum ext4_checker_tx_source source)
+{
+	switch (source) {
+	case EXT4_CHECKER_TX_START:
+		return "start";
+	case EXT4_CHECKER_TX_STOP:
+		return "stop";
+	case EXT4_CHECKER_TX_RESERVED_START:
+		return "reserved_start";
+	case EXT4_CHECKER_TX_RESTART_END:
+		return "restart_end";
+	case EXT4_CHECKER_TX_RESTART_BEGIN:
+		return "restart_begin";
+	case EXT4_CHECKER_TX_SUPER_BEGIN:
+		return "super_begin";
+	case EXT4_CHECKER_TX_SUPER_END:
+		return "super_end";
+	case EXT4_CHECKER_TX_RESTART_ATTEMPT:
+		return "restart_attempt";
+	case EXT4_CHECKER_TX_RESTART_SUCCESS:
+		return "restart_success";
+	case EXT4_CHECKER_TX_RESTART_FAIL:
+		return "restart_fail";
+	case EXT4_CHECKER_TX_CREDITS_ENOUGH:
+		return "credits_enough";
+	case EXT4_CHECKER_TX_CREDITS_NEED_RESTART:
+		return "credits_need_restart";
+	case EXT4_CHECKER_TX_CREDITS_ERROR:
+		return "credits_error";
+	default:
+		return "unknown";
+	}
+}
+
+/* Compare the global delayed-allocation counter with all live ext4 inodes. */
+static bool checker_delalloc_snapshot(struct super_block *sb, s64 *expected,
+					      s64 *actual, unsigned long *bad_ino)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct inode *inode;
+	s64 total = 0;
+
+	*bad_ino = 0;
+	spin_lock(&sb->s_inode_list_lock);
+	list_for_each_entry(inode, &sb->s_inodes, i_sb_list) {
+		s32 reserved;
+
+		spin_lock(&EXT4_I(inode)->i_block_reservation_lock);
+		reserved = EXT4_I(inode)->i_reserved_data_blocks;
+		spin_unlock(&EXT4_I(inode)->i_block_reservation_lock);
+		if (reserved < 0)
+			continue;
+		total += reserved;
+		if (reserved && !*bad_ino)
+			*bad_ino = inode->i_ino;
+	}
+	spin_unlock(&sb->s_inode_list_lock);
+	*expected = percpu_counter_sum(&sbi->s_dirtyclusters_counter);
+	*actual = total;
+	return true;
+}
+
+static enum ext4_checker_event_type checker_delta_event_type(
+		enum ext4_checker_counter counter, s64 delta)
+{
+	if (counter == EXT4_CHECKER_CLUSTERS)
+		return delta < 0 ? EXT4_CHECKER_EVENT_CLUSTER_ALLOC :
+			EXT4_CHECKER_EVENT_CLUSTER_FREE;
+	if (counter == EXT4_CHECKER_INODES)
+		return delta < 0 ? EXT4_CHECKER_EVENT_INODE_ALLOC :
+			EXT4_CHECKER_EVENT_INODE_FREE;
+	return delta < 0 ? EXT4_CHECKER_EVENT_DIR_REMOVE :
+		EXT4_CHECKER_EVENT_DIR_CREATE;
+}
+
+static u64 checker_handle_tid(handle_t *handle)
+{
+	if (!handle || !ext4_handle_valid(handle) || !handle->h_transaction)
+		return 0;
+	return handle->h_transaction->t_tid;
+}
+
+static enum ext4_checker_counter checker_event_counter(
+		enum ext4_checker_event_type type)
+{
+	switch (type) {
+	case EXT4_CHECKER_EVENT_INODE_ALLOC:
+	case EXT4_CHECKER_EVENT_INODE_FREE:
+		return EXT4_CHECKER_INODES;
+	case EXT4_CHECKER_EVENT_DIR_CREATE:
+	case EXT4_CHECKER_EVENT_DIR_REMOVE:
+		return EXT4_CHECKER_DIRS;
+	default:
+		return EXT4_CHECKER_CLUSTERS;
+	}
+}
+
+static s64 *checker_group_value(struct ext4_checker_group *group,
+				enum ext4_checker_counter counter)
+{
+	switch (counter) {
+	case EXT4_CHECKER_CLUSTERS:
+		return &group->clusters;
+	case EXT4_CHECKER_INODES:
+		return &group->inodes;
+	default:
+		return &group->dirs;
+	}
+}
+
+static s64 *checker_global_value(struct ext4_sb_info *sbi,
+				enum ext4_checker_counter counter)
+{
+	switch (counter) {
+	case EXT4_CHECKER_CLUSTERS:
+		return &sbi->s_checker_global[EXT4_CHECKER_CLUSTERS];
+	case EXT4_CHECKER_INODES:
+		return &sbi->s_checker_global[EXT4_CHECKER_INODES];
+	default:
+		return &sbi->s_checker_global[EXT4_CHECKER_DIRS];
+	}
+}
+
+static s64 checker_global_actual(struct ext4_sb_info *sbi,
+				 enum ext4_checker_counter counter)
+{
+	switch (counter) {
+	case EXT4_CHECKER_CLUSTERS:
+		return percpu_counter_sum(&sbi->s_freeclusters_counter);
+	case EXT4_CHECKER_INODES:
+		return percpu_counter_sum(&sbi->s_freeinodes_counter);
+	default:
+		return percpu_counter_sum(&sbi->s_dirs_counter);
+	}
+}
+
+static void checker_record_locked(struct super_block *sb, bool group_event,
+				  ext4_group_t group,
+				  enum ext4_checker_counter counter,
+				  enum ext4_checker_event_type type,
+				  u64 inode, ext4_fsblk_t range_start,
+				  u32 range_len, u64 txid, s64 delta,
+				  s64 old_value, s64 expected, s64 actual)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_event *event;
+	unsigned int slot;
+
+	slot = sbi->s_checker_event_head;
+	event = &sbi->s_checker_events[slot];
+	event->seq = ++sbi->s_checker_event_seq;
+	event->op_id = event->seq;
+	event->inode = inode;
+	event->range_start = range_start;
+	event->txid = txid;
+	event->group = group_event ? group : ~0U;
+	event->range_len = range_len;
+	event->counter = counter;
+	event->type = type;
+	event->flags = group_event ? 1 : 0;
+	event->tx_source = EXT4_CHECKER_TX_UNKNOWN;
+	event->source_line = 0;
+	event->refs_before = 0;
+	event->refs_after = 0;
+	event->delta = delta;
+	event->old_value = old_value;
+	event->expected = expected;
+	event->actual = actual;
+	event->pid = current->pid;
+	event->cpu = raw_smp_processor_id();
+	sbi->s_checker_event_head = (slot + 1) % sbi->s_checker_event_size;
+	if (sbi->s_checker_event_count < sbi->s_checker_event_size)
+		sbi->s_checker_event_count++;
+	else
+		sbi->s_checker_event_dropped++;
+}
+
+static bool checker_violation_locked(struct super_block *sb, bool group_event,
+					 ext4_group_t group,
+					 enum ext4_checker_counter counter,
+					 s64 old_value, s64 expected, s64 actual)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool bad = expected != actual;
+
+	checker_record_locked(sb, group_event, group, counter,
+			     checker_delta_event_type(counter, expected - old_value),
+			     0, 0, 0, 0, expected - old_value,
+			     old_value, expected, actual);
+	if (bad) {
+		sbi->s_checker_violation_count++;
+		scnprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "counter=%s scope=%s group=%u old=%lld expected=%lld actual=%lld "
+			  "pid=%d cpu=%u\n", checker_counter_name(counter),
+			  group_event ? "group" : "global", group, old_value,
+			  expected, actual, current->pid, raw_smp_processor_id());
+		pr_warn_ratelimited("EXT4 invariant violation: %s", sbi->s_checker_last_report);
+		strscpy(sbi->s_checker_last_violation,
+			sbi->s_checker_last_report);
+	}
+	return bad;
+}
+
+static bool checker_tx_event_locked(struct super_block *sb,
+				    enum ext4_checker_event_type type,
+				    u64 txid, enum ext4_checker_tx_source source,
+				    unsigned int line, u32 refs, u32 *before, u32 *after)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	unsigned int start = txid % EXT4_CHECKER_TX_SLOTS;
+	unsigned int i;
+	int free_slot = -1;
+
+	*before = 0;
+	*after = 0;
+
+	/* A no-journal handle has no transaction object (tid == 0).  The
+	 * no-journal stop path legitimately has no matching journal-stop event,
+	 * so it must not consume a pairing slot or become an underflow.
+	 */
+	if (!txid)
+		return false;
+
+	for (i = 0; i < EXT4_CHECKER_TX_SLOTS; i++) {
+		unsigned int slot = (start + i) % EXT4_CHECKER_TX_SLOTS;
+
+		if (sbi->s_checker_txrefs[slot] &&
+		    sbi->s_checker_txids[slot] == txid) {
+			*before = sbi->s_checker_txrefs[slot];
+			if (type == EXT4_CHECKER_EVENT_TX_BEGIN)
+				sbi->s_checker_txrefs[slot] += refs;
+			else if (*before >= refs)
+				sbi->s_checker_txrefs[slot] -= refs;
+			else
+				break;
+			*after = sbi->s_checker_txrefs[slot];
+			return false;
+		}
+		if (!sbi->s_checker_txrefs[slot] && free_slot < 0)
+			free_slot = slot;
+	}
+
+	if (type == EXT4_CHECKER_EVENT_TX_BEGIN && free_slot >= 0) {
+		sbi->s_checker_txids[free_slot] = txid;
+		sbi->s_checker_txrefs[free_slot] = refs;
+		*after = refs;
+		return false;
+	}
+
+	sbi->s_checker_tx_underflows++;
+	sbi->s_checker_violation_count++;
+	scnprintf(sbi->s_checker_last_report,
+		  sizeof(sbi->s_checker_last_report),
+		  "transaction pairing violation type=%u txid=%llu seq=%llu "
+		  "source=%s line=%u refs=%u->%u pid=%d cpu=%u reason=%s\n",
+		  type, txid, sbi->s_checker_event_seq + 1,
+		  checker_tx_source_name(source), line, *before, *after,
+		  current->pid,
+		  raw_smp_processor_id(), free_slot < 0 ? "slots_full" :
+		  "unmatched_end");
+	pr_warn_ratelimited("EXT4 invariant violation: %s",
+			    sbi->s_checker_last_report);
+	strscpy(sbi->s_checker_last_violation, sbi->s_checker_last_report);
+	return true;
+}
+
+/* Keep the first failing transaction's edges even after the main ring wraps. */
+static void checker_capture_tx_context_locked(struct ext4_sb_info *sbi, u64 txid)
+{
+	unsigned int i;
+
+	if (sbi->s_checker_tx_context_count)
+		return;
+	for (i = 0; i < sbi->s_checker_event_count &&
+	     sbi->s_checker_tx_context_count < EXT4_CHECKER_TX_CONTEXT; i++) {
+		unsigned int slot = (sbi->s_checker_event_head +
+			sbi->s_checker_event_size - 1 - i) %
+			sbi->s_checker_event_size;
+		struct ext4_checker_event *event = &sbi->s_checker_events[slot];
+
+		if (event->txid == txid &&
+		    (event->type == EXT4_CHECKER_EVENT_TX_BEGIN ||
+		     event->type == EXT4_CHECKER_EVENT_TX_END ||
+		     event->type == EXT4_CHECKER_EVENT_TX_RESTART ||
+		     event->type == EXT4_CHECKER_EVENT_TX_CREDITS))
+			sbi->s_checker_tx_context[sbi->s_checker_tx_context_count++] =
+				*event;
+	}
+}
+
+void ext4_checker_tx_restart_event(struct super_block *sb, handle_t *handle,
+				   enum ext4_checker_tx_source source,
+				   unsigned int line)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_event *event;
+	u64 txid;
+	u32 refs = 0;
+	unsigned int start, i;
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	txid = checker_handle_tid(handle);
+	if (txid) {
+		start = txid % EXT4_CHECKER_TX_SLOTS;
+		for (i = 0; i < EXT4_CHECKER_TX_SLOTS; i++) {
+			unsigned int slot = (start + i) % EXT4_CHECKER_TX_SLOTS;
+
+			if (sbi->s_checker_txrefs[slot] &&
+			    sbi->s_checker_txids[slot] == txid) {
+				refs = sbi->s_checker_txrefs[slot];
+				break;
+			}
+		}
+	}
+	checker_record_locked(sb, true, 0, EXT4_CHECKER_CLUSTERS,
+			     EXT4_CHECKER_EVENT_TX_RESTART, 0, 0, 0, txid,
+			     0, 0, 0, 0);
+	event = &sbi->s_checker_events[(sbi->s_checker_event_head +
+					 sbi->s_checker_event_size - 1) %
+					sbi->s_checker_event_size];
+	event->tx_source = source;
+	event->source_line = line;
+	event->refs_before = refs;
+	event->refs_after = refs;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+void ext4_checker_tx_event(struct super_block *sb,
+			   enum ext4_checker_event_type type,
+			   struct inode *inode, handle_t *handle,
+			   enum ext4_checker_tx_source source, unsigned int line)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_event *event;
+	u64 txid;
+	u32 before, after;
+	u32 refs = 1;
+	bool barrier_locked, bad;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	txid = checker_handle_tid(handle);
+	/* JBD2 restarts the same handle without resetting nested h_ref. */
+	if (source == EXT4_CHECKER_TX_RESTART_END ||
+	    source == EXT4_CHECKER_TX_RESTART_BEGIN)
+		refs = handle->h_ref;
+	bad = checker_tx_event_locked(sb, type, txid, source, line,
+					      refs, &before, &after);
+	checker_record_locked(sb, true, 0, EXT4_CHECKER_CLUSTERS, type,
+			     inode ? inode->i_ino : 0, 0, 0, txid, 0, 0, 0, 0);
+	event = &sbi->s_checker_events[(sbi->s_checker_event_head +
+					 sbi->s_checker_event_size - 1) %
+					sbi->s_checker_event_size];
+	event->tx_source = source;
+	event->source_line = line;
+	event->refs_before = before;
+	event->refs_after = after;
+	if (bad)
+		checker_capture_tx_context_locked(sbi, txid);
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+void ext4_checker_tx_credits_event(handle_t *handle, int check_cred,
+					   int extend_cred, int revoke_cred,
+					   int result, unsigned int line)
+{
+	struct super_block *sb;
+	struct ext4_sb_info *sbi;
+	struct ext4_checker_event *event;
+	enum ext4_checker_tx_source source;
+	u64 txid;
+	u32 refs = 0;
+	unsigned int start, i;
+	bool barrier_locked;
+
+	if (!ext4_handle_valid(handle) || !handle->h_transaction)
+		return;
+	sb = handle->h_transaction->t_journal->j_private;
+	if (!sb)
+		return;
+	sbi = EXT4_SB(sb);
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	txid = checker_handle_tid(handle);
+	if (result > 0)
+		source = EXT4_CHECKER_TX_CREDITS_NEED_RESTART;
+	else if (result < 0)
+		source = EXT4_CHECKER_TX_CREDITS_ERROR;
+	else
+		source = EXT4_CHECKER_TX_CREDITS_ENOUGH;
+	start = txid % EXT4_CHECKER_TX_SLOTS;
+	for (i = 0; txid && i < EXT4_CHECKER_TX_SLOTS; i++) {
+		unsigned int slot = (start + i) % EXT4_CHECKER_TX_SLOTS;
+
+		if (sbi->s_checker_txrefs[slot] &&
+		    sbi->s_checker_txids[slot] == txid) {
+			refs = sbi->s_checker_txrefs[slot];
+			break;
+		}
+	}
+	checker_record_locked(sb, true, 0, EXT4_CHECKER_CLUSTERS,
+			     EXT4_CHECKER_EVENT_TX_CREDITS, 0, check_cred,
+			     extend_cred, txid, revoke_cred, 0, 0, result);
+	event = &sbi->s_checker_events[(sbi->s_checker_event_head +
+					 sbi->s_checker_event_size - 1) %
+					sbi->s_checker_event_size];
+	event->tx_source = source;
+	event->source_line = line;
+	event->refs_before = refs;
+	event->refs_after = refs;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+void ext4_checker_metadata_event(struct super_block *sb,
+				 enum ext4_checker_event_type type,
+				 struct inode *inode, ext4_group_t group,
+				 ext4_fsblk_t range_start, u32 range_len,
+				 handle_t *handle)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	ext4_checker_metadata_event_ino(sb, type, inode ? inode->i_ino : 0,
+					group, range_start, range_len, handle);
+}
+
+void ext4_checker_metadata_event_ino(struct super_block *sb,
+				 enum ext4_checker_event_type type,
+				 u64 ino, ext4_group_t group,
+				 ext4_fsblk_t range_start, u32 range_len,
+				 handle_t *handle)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool barrier_locked;
+	u32 before, after;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	if (type == EXT4_CHECKER_EVENT_TX_BEGIN ||
+	    type == EXT4_CHECKER_EVENT_TX_END)
+		checker_tx_event_locked(sb, type, checker_handle_tid(handle),
+					EXT4_CHECKER_TX_UNKNOWN, 0, 1,
+					&before, &after);
+	checker_record_locked(sb, true, group, checker_event_counter(type), type,
+			     ino, range_start, range_len, checker_handle_tid(handle), 0,
+			     0, 0, 0);
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+static s64 checker_group_actual(struct super_block *sb, ext4_group_t group,
+				       enum ext4_checker_counter counter)
+{
+	struct ext4_group_desc *gdp;
+
+	gdp = ext4_get_group_desc(sb, group, NULL);
+	if (!gdp)
+		return -1;
+	switch (counter) {
+	case EXT4_CHECKER_CLUSTERS:
+		return ext4_free_group_clusters(sb, gdp);
+	case EXT4_CHECKER_INODES:
+		return ext4_free_inodes_count(sb, gdp);
+	default:
+		return ext4_used_dirs_count(sb, gdp);
+	}
+}
+
+void ext4_checker_global_delta(struct super_block *sb,
+			       enum ext4_checker_counter counter, s64 delta)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	s64 old_value, expected, actual;
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	old_value = *checker_global_value(sbi, counter);
+	expected = old_value + delta;
+	/*
+	 * percpu counters are updated outside s_checker_lock.  Reading their
+	 * aggregate here races a concurrent update and can report a transient
+	 * value between two valid operations.  The shadow is therefore advanced
+	 * from the observed delta; the snapshot checks whether checker events raced
+	 * with its scan before treating the result as authoritative.
+	 */
+	actual = checker_global_actual(sbi, counter);
+	checker_record_locked(sb, false, 0, counter,
+			     checker_delta_event_type(counter, delta),
+			     0, 0, 0, 0, delta, old_value, expected, actual);
+	*checker_global_value(sbi, counter) = expected;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+void ext4_checker_group_delta(struct super_block *sb, ext4_group_t group,
+			      enum ext4_checker_counter counter, s64 delta)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	s64 old_value, expected, actual;
+	bool bad;
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active) || group >= sbi->s_groups_count)
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	old_value = *checker_group_value(&sbi->s_checker_groups[group], counter);
+	expected = old_value + delta;
+	actual = checker_group_actual(sb, group, counter);
+	bad = checker_violation_locked(sb, true, group, counter, old_value,
+				       expected, actual);
+	*checker_group_value(&sbi->s_checker_groups[group], counter) = actual;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+	if (bad && checker_panic)
+		panic("ext4 invariant checker: group counter mismatch");
+}
+
+void ext4_checker_group_set(struct super_block *sb,
+			    struct ext4_group_desc *bg,
+			    enum ext4_checker_counter counter,
+			    s64 old_value, s64 new_value)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	ext4_group_t group;
+	s64 actual;
+	bool bad;
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active) || old_value == new_value)
+		return;
+	for (group = 0; group < sbi->s_groups_count; group++)
+		if (ext4_get_group_desc(sb, group, NULL) == bg)
+			break;
+	if (group == sbi->s_groups_count ||
+	    group >= READ_ONCE(sbi->s_checker_group_capacity))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	actual = checker_group_actual(sb, group, counter);
+	bad = checker_violation_locked(sb, true, group, counter, old_value,
+				       new_value, actual);
+	*checker_group_value(&sbi->s_checker_groups[group], counter) = actual;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+	if (bad && checker_panic)
+		panic("ext4 invariant checker: group setter mismatch");
+}
+
+void ext4_checker_resize_groups(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_group *groups;
+	struct ext4_checker_group *old_groups;
+	unsigned int old_capacity, new_capacity, i;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	new_capacity = READ_ONCE(sbi->s_groups_count);
+	if (new_capacity <= READ_ONCE(sbi->s_checker_group_capacity))
+		return;
+
+	down_write(&sbi->s_checker_barrier);
+	old_capacity = sbi->s_checker_group_capacity;
+	new_capacity = READ_ONCE(sbi->s_groups_count);
+	if (new_capacity <= old_capacity)
+		goto out;
+	groups = kvcalloc(new_capacity, sizeof(*groups), GFP_NOFS);
+	if (!groups) {
+		sbi->s_checker_resize_unverified = true;
+		sbi->s_checker_unverified_count++;
+		goto out;
+	}
+	spin_lock(&sbi->s_checker_lock);
+	old_groups = sbi->s_checker_groups;
+	memcpy(groups, old_groups, old_capacity * sizeof(*groups));
+	for (i = old_capacity; i < new_capacity; i++) {
+		struct ext4_group_desc *gdp = ext4_get_group_desc(sb, i, NULL);
+
+		if (!gdp) {
+			sbi->s_checker_resize_unverified = true;
+			continue;
+		}
+		groups[i].clusters = ext4_free_group_clusters(sb, gdp);
+		groups[i].inodes = ext4_free_inodes_count(sb, gdp);
+		groups[i].dirs = ext4_used_dirs_count(sb, gdp);
+	}
+	sbi->s_checker_groups = groups;
+	sbi->s_checker_group_capacity = new_capacity;
+	spin_unlock(&sbi->s_checker_lock);
+	kvfree(old_groups);
+	goto out;
+out:
+	up_write(&sbi->s_checker_barrier);
+}
+
+void ext4_checker_resize_state(struct super_block *sb, bool active)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return;
+	down_write(&sbi->s_checker_barrier);
+	WRITE_ONCE(sbi->s_checker_resize_active, active);
+	up_write(&sbi->s_checker_barrier);
+}
+
+bool ext4_checker_namespace_begin(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return false;
+	atomic_inc(&sbi->s_checker_namespace_active);
+	atomic64_inc(&sbi->s_checker_namespace_seq);
+	return true;
+}
+
+void ext4_checker_namespace_end(struct super_block *sb, bool tracked)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!tracked)
+		return;
+	atomic64_inc(&sbi->s_checker_namespace_seq);
+	atomic_dec(&sbi->s_checker_namespace_active);
+}
+
+bool ext4_checker_xattr_begin(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return false;
+	barrier_locked = checker_barrier_read_trylock(sbi);
+	spin_lock(&sbi->s_checker_lock);
+	if (!barrier_locked && !READ_ONCE(sbi->s_checker_active)) {
+		spin_unlock(&sbi->s_checker_lock);
+		return false;
+	}
+	atomic64_inc(&sbi->s_checker_xattr_seq);
+	smp_mb__after_atomic();
+	atomic_inc(&sbi->s_checker_xattr_active);
+	smp_mb__after_atomic();
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+	return true;
+}
+
+void ext4_checker_xattr_end(struct super_block *sb, bool tracked)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!tracked)
+		return;
+	smp_mb__before_atomic();
+	atomic_dec(&sbi->s_checker_xattr_active);
+	smp_mb__before_atomic();
+	atomic64_inc(&sbi->s_checker_xattr_seq);
+}
+
+void ext4_checker_flex_begin(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!READ_ONCE(sbi->s_checker_active) || !sbi->s_log_groups_per_flex)
+		return;
+	atomic_inc(&sbi->s_checker_flex_active);
+	smp_mb__after_atomic();
+	atomic64_inc(&sbi->s_checker_flex_seq);
+	smp_mb__after_atomic();
+}
+
+void ext4_checker_flex_end(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!READ_ONCE(sbi->s_checker_active) || !sbi->s_log_groups_per_flex)
+		return;
+	smp_mb__before_atomic();
+	atomic64_inc(&sbi->s_checker_flex_seq);
+	smp_mb__before_atomic();
+	atomic_dec(&sbi->s_checker_flex_active);
+}
+
+static void ext4_checker_orphan_file_snapshot(struct super_block *sb,
+					      unsigned int *checks,
+					      unsigned int *violations,
+					      unsigned int *unverified)
+{
+	struct ext4_orphan_info *oi = &EXT4_SB(sb)->s_orphan_info;
+	int inodes_per_ob = ext4_inodes_per_orphan_block(sb);
+	u64 seq;
+	int first_block = -1, first_slots = 0, first_counter = 0;
+	int i;
+
+	*checks = 0;
+	*violations = 0;
+	*unverified = 0;
+	if (!ext4_has_feature_orphan_file(sb))
+		return;
+	if (!oi->of_blocks || !oi->of_binfo) {
+		*unverified = 1;
+		return;
+	}
+	seq = atomic64_read(&oi->of_change_seq);
+	if (atomic_read(&oi->of_active_ops)) {
+		*unverified = 1;
+		return;
+	}
+	smp_rmb();
+	for (i = 0; i < oi->of_blocks; i++) {
+		struct buffer_head *bh = oi->of_binfo[i].ob_bh;
+		__le32 *entries;
+		int free_slots = 0;
+		int j;
+		int cached;
+
+		if (!bh || !buffer_uptodate(bh)) {
+			(*unverified)++;
+			continue;
+		}
+		entries = (__le32 *)bh->b_data;
+		for (j = 0; j < inodes_per_ob; j++)
+			if (READ_ONCE(entries[j]) == 0)
+				free_slots++;
+		cached = atomic_read(&oi->of_binfo[i].ob_free_entries);
+		(*checks)++;
+		if (free_slots != cached) {
+			if (first_block < 0) {
+				first_block = i;
+				first_slots = free_slots;
+				first_counter = cached;
+			}
+			(*violations)++;
+		}
+	}
+	smp_rmb();
+	if (atomic_read(&oi->of_active_ops) ||
+	    seq != atomic64_read(&oi->of_change_seq)) {
+		*checks = 0;
+		*violations = 0;
+		*unverified = 1;
+		return;
+	}
+	if (*violations)
+		pr_warn_ratelimited("EXT4 invariant violation: orphan_file_entries "
+				    "mismatched_blocks=%u first_block=%d "
+				    "free_slots=%d counter=%d\n",
+				    *violations, first_block, first_slots,
+				    first_counter);
+}
+
+struct ext4_checker_xattr_ref {
+	ext4_fsblk_t block;
+};
+
+struct ext4_checker_ea_ref {
+	unsigned long ino;
+};
+
+struct ext4_checker_ea_inode {
+	unsigned long ino;
+	u64 refs;
+};
+
+#define EXT4_CHECKER_EA_REF_MAX (1U << 20)
+
+static int ext4_checker_xattr_ref_cmp(const void *a, const void *b)
+{
+	const struct ext4_checker_xattr_ref *left = a;
+	const struct ext4_checker_xattr_ref *right = b;
+
+	if (left->block < right->block)
+		return -1;
+	if (left->block > right->block)
+		return 1;
+	return 0;
+}
+
+static int ext4_checker_ea_ref_cmp(const void *a, const void *b)
+{
+	const struct ext4_checker_ea_ref *left = a;
+	const struct ext4_checker_ea_ref *right = b;
+
+	if (left->ino < right->ino)
+		return -1;
+	if (left->ino > right->ino)
+		return 1;
+	return 0;
+}
+
+static bool ext4_checker_ea_ref_add(struct ext4_checker_ea_ref **refs,
+				    unsigned int *count,
+				    unsigned int *capacity,
+				    unsigned long ino)
+{
+	struct ext4_checker_ea_ref *new_refs;
+	unsigned int new_capacity;
+
+	if (*count >= EXT4_CHECKER_EA_REF_MAX)
+		return false;
+	if (*count == *capacity) {
+		new_capacity = *capacity ? *capacity * 2 : 64;
+		if (new_capacity < *capacity ||
+		    new_capacity > EXT4_CHECKER_EA_REF_MAX)
+			new_capacity = EXT4_CHECKER_EA_REF_MAX;
+		new_refs = krealloc(*refs, new_capacity * sizeof(**refs), GFP_NOFS);
+		if (!new_refs)
+			return false;
+		*refs = new_refs;
+		*capacity = new_capacity;
+	}
+	(*refs)[(*count)++].ino = ino;
+	return true;
+}
+
+static bool ext4_checker_ea_inode_add(struct ext4_checker_ea_inode **inodes,
+				      unsigned int *count,
+				      unsigned int *capacity,
+				      unsigned long ino, u64 refs)
+{
+	struct ext4_checker_ea_inode *new_inodes;
+	unsigned int new_capacity;
+
+	if (*count >= EXT4_CHECKER_EA_REF_MAX)
+		return false;
+	if (*count == *capacity) {
+		new_capacity = *capacity ? *capacity * 2 : 64;
+		if (new_capacity < *capacity ||
+		    new_capacity > EXT4_CHECKER_EA_REF_MAX)
+			new_capacity = EXT4_CHECKER_EA_REF_MAX;
+		new_inodes = krealloc(*inodes,
+				      new_capacity * sizeof(**inodes), GFP_NOFS);
+		if (!new_inodes)
+			return false;
+		*inodes = new_inodes;
+		*capacity = new_capacity;
+	}
+	(*inodes)[*count].ino = ino;
+	(*inodes)[(*count)++].refs = refs;
+	return true;
+}
+
+static bool ext4_checker_ea_scan_entries(struct ext4_checker_ea_ref **refs,
+					 unsigned int *ref_count,
+					 unsigned int *ref_capacity,
+					 struct ext4_xattr_entry *entry,
+					 void *end)
+{
+	while ((void *)entry + sizeof(u32) <= end) {
+		struct ext4_xattr_entry *next;
+
+		if (IS_LAST_ENTRY(entry))
+			return true;
+		if ((void *)entry + sizeof(*entry) > end)
+			return false;
+		next = EXT4_XATTR_NEXT(entry);
+		if ((void *)next <= (void *)entry || (void *)next > end)
+			return false;
+		if (entry->e_value_inum &&
+		    !ext4_checker_ea_ref_add(refs, ref_count, ref_capacity,
+					     le32_to_cpu(entry->e_value_inum)))
+			return false;
+		entry = next;
+	}
+	return false;
+}
+
+/* Recompute EA inode ownership from xattr entries, independently of ref fields. */
+static void ext4_checker_ea_inode_snapshot(struct super_block *sb,
+					  unsigned int *checks,
+					  unsigned int *violations,
+					  unsigned int *unverified,
+					  unsigned long *bad_ino,
+					  u64 *bad_expected,
+					  u64 *bad_actual,
+					  char *reason, size_t reason_size)
+{
+	struct ext4_checker_ea_ref *refs = NULL;
+	struct ext4_checker_ea_inode *inodes = NULL;
+	struct ext4_checker_xattr_ref *blocks = NULL;
+	unsigned int ref_count = 0, ref_capacity = 0;
+	unsigned int inode_count = 0, inode_capacity = 0;
+	unsigned int block_count = 0, block_capacity = 0;
+	ext4_group_t group;
+	unsigned int i;
+	u64 xattr_seq;
+	bool complete = true;
+	bool raced;
+
+	*checks = 0;
+	*violations = 0;
+	*unverified = 0;
+	*bad_ino = 0;
+	*bad_expected = 0;
+	*bad_actual = 0;
+	strscpy(reason, "none", reason_size);
+	if (!ext4_has_feature_ea_inode(sb))
+		return;
+	if (EXT4_SB(sb)->s_mount_state & EXT4_FC_REPLAY) {
+		*unverified = 1;
+		strscpy(reason, "fast_commit_replay", reason_size);
+		return;
+	}
+	xattr_seq = atomic64_read(&EXT4_SB(sb)->s_checker_xattr_seq);
+	if (atomic_read(&EXT4_SB(sb)->s_checker_xattr_active)) {
+		*unverified = 1;
+		strscpy(reason, "xattr_update_active", reason_size);
+		return;
+	}
+	smp_rmb();
+
+	for (group = 0; group < ext4_get_groups_count(sb) && complete; group++) {
+		struct buffer_head *bitmap;
+		unsigned int bit, limit = EXT4_INODES_PER_GROUP(sb);
+
+		bitmap = ext4_read_inode_bitmap(sb, group);
+		if (IS_ERR(bitmap)) {
+			complete = false;
+			strscpy(reason, "inode_bitmap_read", reason_size);
+			break;
+		}
+		for (bit = 0; bit < limit; bit++) {
+			struct ext4_iloc iloc;
+			struct ext4_inode *raw;
+			unsigned long ino;
+			ext4_fsblk_t block;
+
+			ino = group * EXT4_INODES_PER_GROUP(sb) + bit + 1;
+			if (ino > le32_to_cpu(EXT4_SB(sb)->s_es->s_inodes_count))
+				break;
+			if (!ext4_test_bit(bit, bitmap->b_data))
+				continue;
+			/* Inode 1 is a reserved bitmap entry; the inode-table
+			 * locator intentionally rejects it. */
+			if (ino < EXT4_ROOT_INO)
+				continue;
+			if (ext4_get_fc_inode_loc(sb, ino, &iloc)) {
+				complete = false;
+				strscpy(reason, "inode_read", reason_size);
+				break;
+			}
+			raw = ext4_raw_inode(&iloc);
+			if (!le16_to_cpu(raw->i_mode)) {
+				brelse(iloc.bh);
+				continue;
+			}
+			if (le32_to_cpu(raw->i_flags) & EXT4_EA_INODE_FL) {
+				u64 ref_value;
+
+				ref_value = ((u64)le32_to_cpu(raw->i_ctime) << 32) |
+					le32_to_cpu(raw->i_disk_version);
+				if (!ext4_checker_ea_inode_add(&inodes, &inode_count,
+							       &inode_capacity,
+							       ino, ref_value)) {
+					complete = false;
+					strscpy(reason, "ea_inode_capacity", reason_size);
+					brelse(iloc.bh);
+					break;
+				}
+			}
+			if (EXT4_INODE_SIZE(sb) > EXT4_GOOD_OLD_INODE_SIZE) {
+				unsigned int extra = le16_to_cpu(raw->i_extra_isize);
+				void *raw_end = (void *)raw + EXT4_INODE_SIZE(sb);
+				void *header_pos = (void *)raw +
+					EXT4_GOOD_OLD_INODE_SIZE + extra;
+
+				if (header_pos + sizeof(struct ext4_xattr_ibody_header) +
+				    sizeof(u32) > raw_end) {
+					complete = false;
+					strscpy(reason, "ibody_bounds", reason_size);
+				} else {
+					struct ext4_xattr_ibody_header *header = header_pos;
+
+					if (header->h_magic == cpu_to_le32(EXT4_XATTR_MAGIC) &&
+					    !ext4_checker_ea_scan_entries(&refs,
+							&ref_count, &ref_capacity,
+							IFIRST(header), raw_end)) {
+						complete = false;
+						strscpy(reason, "ibody_entries", reason_size);
+					}
+				}
+			}
+			block = le32_to_cpu(raw->i_file_acl_lo);
+			if (EXT4_INODE_SIZE(sb) > EXT4_GOOD_OLD_INODE_SIZE)
+				block |= (__u64)le16_to_cpu(
+					raw->osd2.linux2.l_i_file_acl_high) << 32;
+			if (block && complete) {
+				struct ext4_checker_xattr_ref *new_blocks;
+				unsigned int new_capacity;
+
+				if (block_count >= EXT4_CHECKER_EA_REF_MAX) {
+					complete = false;
+					strscpy(reason, "xattr_block_capacity", reason_size);
+				} else if (block_count == block_capacity) {
+					new_capacity = block_capacity ? block_capacity * 2 : 64;
+					if (new_capacity > EXT4_CHECKER_EA_REF_MAX)
+						new_capacity = EXT4_CHECKER_EA_REF_MAX;
+					new_blocks = krealloc(blocks,
+						new_capacity * sizeof(*blocks), GFP_NOFS);
+					if (!new_blocks) {
+						complete = false;
+						strscpy(reason, "xattr_block_alloc", reason_size);
+					} else {
+						blocks = new_blocks;
+						block_capacity = new_capacity;
+					}
+				}
+				if (complete)
+					blocks[block_count++].block = block;
+			}
+			brelse(iloc.bh);
+			if (!complete)
+				break;
+		}
+		brelse(bitmap);
+	}
+	if (!complete)
+		goto out_unverified;
+
+	sort(blocks, block_count, sizeof(*blocks),
+	     ext4_checker_xattr_ref_cmp, NULL);
+	for (i = 0; i < block_count; ) {
+		struct buffer_head *bh;
+		struct ext4_xattr_header *header;
+		unsigned int next = i + 1;
+		void *end;
+
+		while (next < block_count && blocks[next].block == blocks[i].block)
+			next++;
+		bh = ext4_sb_bread(sb, blocks[i].block, REQ_PRIO);
+		if (IS_ERR(bh)) {
+			complete = false;
+			strscpy(reason, "xattr_block_read", reason_size);
+			break;
+		}
+		header = BHDR(bh);
+		end = bh->b_data + bh->b_size;
+		if (header->h_magic != cpu_to_le32(EXT4_XATTR_MAGIC) ||
+		    header->h_blocks != cpu_to_le32(1) ||
+		    !ext4_checker_ea_scan_entries(&refs, &ref_count,
+						 &ref_capacity, BFIRST(bh), end)) {
+			complete = false;
+			strscpy(reason, "xattr_block_entries", reason_size);
+		}
+		brelse(bh);
+		if (!complete)
+			break;
+		i = next;
+	}
+	if (!complete)
+		goto out_unverified;
+
+	sort(refs, ref_count, sizeof(*refs), ext4_checker_ea_ref_cmp, NULL);
+	{
+		unsigned int ref = 0;
+
+		for (i = 0; i < inode_count; i++) {
+			u64 expected = 0;
+
+			while (ref < ref_count && refs[ref].ino < inodes[i].ino) {
+				unsigned int next = ref + 1;
+
+				while (next < ref_count && refs[next].ino == refs[ref].ino)
+					next++;
+				(*checks)++;
+				(*violations)++;
+				if (!*bad_ino) {
+					*bad_ino = refs[ref].ino;
+					*bad_expected = next - ref;
+					*bad_actual = 0;
+				}
+				ref = next;
+			}
+			while (ref < ref_count && refs[ref].ino == inodes[i].ino) {
+				expected++;
+				ref++;
+			}
+			(*checks)++;
+			if (inodes[i].refs != expected) {
+				(*violations)++;
+				if (!*bad_ino) {
+					*bad_ino = inodes[i].ino;
+					*bad_expected = expected;
+					*bad_actual = inodes[i].refs;
+				}
+			}
+		}
+		while (ref < ref_count) {
+			unsigned int next = ref + 1;
+
+			while (next < ref_count && refs[next].ino == refs[ref].ino)
+				next++;
+			(*checks)++;
+			(*violations)++;
+			if (!*bad_ino) {
+				*bad_ino = refs[ref].ino;
+				*bad_expected = next - ref;
+				*bad_actual = 0;
+			}
+			ref = next;
+		}
+	}
+	if (!complete)
+		goto out_unverified;
+	goto out;
+
+out_unverified:
+	*checks = 0;
+	*violations = 0;
+	*unverified = 1;
+out:
+	smp_rmb();
+	raced = atomic_read(&EXT4_SB(sb)->s_checker_xattr_active) ||
+		 xattr_seq != atomic64_read(&EXT4_SB(sb)->s_checker_xattr_seq);
+	if (raced) {
+		*checks = 0;
+		*violations = 0;
+		*unverified = 1;
+		strscpy(reason, "xattr_update_race", reason_size);
+	}
+	kvfree(refs);
+	kvfree(inodes);
+	kvfree(blocks);
+}
+
+/*
+ * Compare each xattr block header with an independently collected count of
+ * raw inode i_file_acl references.  The inode table supplies the expected
+ * side of the relation; reading the xattr block supplies the stored side.
+ */
+static void ext4_checker_xattr_block_snapshot(struct super_block *sb,
+						      unsigned int *checks,
+						      unsigned int *violations,
+						      unsigned int *unverified,
+						      u64 *bad_block,
+						      u32 *bad_ref,
+						      u32 *bad_expected,
+						      char *reason, size_t reason_size)
+{
+	struct ext4_checker_xattr_ref *refs = NULL;
+	ext4_group_t group;
+	unsigned int ref_count = 0, ref_capacity = 0;
+	ext4_fsblk_t first_block = le32_to_cpu(EXT4_SB(sb)->s_es->s_first_data_block);
+	ext4_fsblk_t block_count = ext4_blocks_count(EXT4_SB(sb)->s_es);
+	bool complete = true;
+
+	*checks = 0;
+	*violations = 0;
+	*unverified = 0;
+	*bad_block = 0;
+	*bad_ref = 0;
+	*bad_expected = 0;
+	strscpy(reason, "none", reason_size);
+
+	for (group = 0; group < ext4_get_groups_count(sb) && complete; group++) {
+		struct buffer_head *bitmap;
+		unsigned int bit, limit = EXT4_INODES_PER_GROUP(sb);
+
+		bitmap = ext4_read_inode_bitmap(sb, group);
+		if (IS_ERR(bitmap)) {
+			complete = false;
+			strscpy(reason, "inode_bitmap_read", reason_size);
+			break;
+		}
+		for (bit = 0; bit < limit; bit++) {
+			struct ext4_iloc iloc;
+			struct ext4_inode *raw;
+			struct inode *live;
+			unsigned long ino;
+			ext4_fsblk_t block;
+			bool referenced;
+			unsigned int new_capacity;
+			struct ext4_checker_xattr_ref *new_refs;
+
+			ino = group * EXT4_INODES_PER_GROUP(sb) + bit + 1;
+			if (ino > le32_to_cpu(EXT4_SB(sb)->s_es->s_inodes_count))
+				break;
+			if (!ext4_test_bit(bit, bitmap->b_data))
+				continue;
+			if (ino < EXT4_ROOT_INO)
+				continue;
+			if (ext4_get_fc_inode_loc(sb, ino, &iloc)) {
+				complete = false;
+				strscpy(reason, "inode_read", reason_size);
+				break;
+			}
+			raw = ext4_raw_inode(&iloc);
+			if (!le16_to_cpu(raw->i_mode)) {
+				brelse(iloc.bh);
+				continue;
+			}
+			/* A zero-link inode may still be valid while an fd is open.
+			 * Consult the inode cache so that only an evicted stale inode is
+			 * excluded from the independent reference count. */
+			referenced = le16_to_cpu(raw->i_links_count) != 0;
+			if (!referenced) {
+				live = ilookup(sb, ino);
+				if (live) {
+					referenced = true;
+					iput(live);
+				}
+			}
+			block = le32_to_cpu(raw->i_file_acl_lo);
+			if (EXT4_INODE_SIZE(sb) > EXT4_GOOD_OLD_INODE_SIZE)
+				block |= (__u64)le16_to_cpu(raw->osd2.linux2.l_i_file_acl_high) << 32;
+			brelse(iloc.bh);
+			if (!block || !referenced)
+				continue;
+			if (ref_count == ref_capacity) {
+				new_capacity = ref_capacity ? ref_capacity * 2 : 64;
+				if (new_capacity < ref_capacity ||
+				    new_capacity > SIZE_MAX / sizeof(*refs)) {
+					complete = false;
+					strscpy(reason, "reference_count_overflow", reason_size);
+					break;
+				}
+				new_refs = krealloc(refs,
+						   new_capacity * sizeof(*refs), GFP_KERNEL);
+				if (!new_refs) {
+					complete = false;
+					strscpy(reason, "alloc", reason_size);
+					break;
+				}
+				refs = new_refs;
+				ref_capacity = new_capacity;
+			}
+			refs[ref_count++].block = block;
+		}
+		brelse(bitmap);
+	}
+	if (!complete)
+		goto out_unverified;
+
+	sort(refs, ref_count, sizeof(*refs), ext4_checker_xattr_ref_cmp, NULL);
+	for (unsigned int i = 0; i < ref_count; ) {
+		struct buffer_head *bh;
+		ext4_fsblk_t block = refs[i].block;
+		unsigned int j = i + 1;
+		u32 expected = 1, actual;
+
+		while (j < ref_count && refs[j].block == block) {
+			expected++;
+			j++;
+		}
+		if (block < first_block || block >= block_count) {
+			(*unverified)++;
+			i = j;
+			continue;
+		}
+		bh = ext4_sb_bread(sb, block, REQ_PRIO);
+		if (IS_ERR(bh)) {
+			(*unverified)++;
+			i = j;
+			continue;
+		}
+		if (BHDR(bh)->h_magic != cpu_to_le32(EXT4_XATTR_MAGIC) ||
+		    BHDR(bh)->h_blocks != cpu_to_le32(1)) {
+			(*unverified)++;
+			brelse(bh);
+			i = j;
+			continue;
+		}
+		actual = le32_to_cpu(BHDR(bh)->h_refcount);
+		(*checks)++;
+		if (actual != expected) {
+			(*violations)++;
+			if (!*bad_block) {
+				*bad_block = block;
+				*bad_ref = actual;
+				*bad_expected = expected;
+			}
+		}
+		brelse(bh);
+		i = j;
+	}
+	goto out;
+
+out_unverified:
+	*unverified = 1;
+out:
+	kvfree(refs);
+}
+
+struct ext4_checker_flex_count {
+	s64 clusters;
+	s64 inodes;
+	s64 dirs;
+};
+
+static void ext4_checker_flex_snapshot(struct super_block *sb,
+				       unsigned int *checks,
+				       unsigned int *violations,
+				       unsigned int *unverified)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_flex_count *sums;
+	ext4_group_t flex_count, group;
+	u64 seq;
+	int first_flex = -1;
+	s64 first_expected[3] = { 0, 0, 0 };
+	s64 first_actual[3] = { 0, 0, 0 };
+	unsigned int i;
+
+	*checks = 0;
+	*violations = 0;
+	*unverified = 0;
+	if (!ext4_has_feature_flex_bg(sb) || !sbi->s_log_groups_per_flex ||
+	    !sbi->s_groups_count)
+		return;
+	flex_count = ext4_flex_group(sbi, sbi->s_groups_count - 1) + 1;
+	if (flex_count > sbi->s_flex_groups_allocated) {
+		*unverified = 1;
+		return;
+	}
+	sums = kvcalloc(flex_count, sizeof(*sums), GFP_NOFS);
+	if (!sums) {
+		*unverified = 1;
+		return;
+	}
+	seq = atomic64_read(&sbi->s_checker_flex_seq);
+	if (atomic_read(&sbi->s_checker_flex_active)) {
+		*unverified = 1;
+		goto out;
+	}
+	smp_rmb();
+	for (group = 0; group < READ_ONCE(sbi->s_groups_count); group++) {
+		struct ext4_group_desc *gdp = ext4_get_group_desc(sb, group, NULL);
+		ext4_group_t flex = ext4_flex_group(sbi, group);
+
+		if (!gdp || flex >= flex_count) {
+			(*unverified)++;
+			continue;
+		}
+		sums[flex].clusters += ext4_free_group_clusters(sb, gdp);
+		sums[flex].inodes += ext4_free_inodes_count(sb, gdp);
+		sums[flex].dirs += ext4_used_dirs_count(sb, gdp);
+	}
+	rcu_read_lock();
+	for (i = 0; i < flex_count; i++) {
+		struct flex_groups *fg = sbi_array_rcu_deref(sbi, s_flex_groups, i);
+		s64 actual[3];
+	s64 expected[3] = { sums[i].clusters, sums[i].inodes, sums[i].dirs };
+		unsigned int field;
+
+		if (!fg) {
+			(*unverified)++;
+			continue;
+		}
+		actual[0] = atomic64_read(&fg->free_clusters);
+		actual[1] = atomic_read(&fg->free_inodes);
+		actual[2] = atomic_read(&fg->used_dirs);
+		for (field = 0; field < ARRAY_SIZE(actual); field++) {
+			(*checks)++;
+			if (actual[field] == expected[field])
+				continue;
+			(*violations)++;
+			if (first_flex < 0) {
+				first_flex = i;
+				memcpy(first_expected, expected, sizeof(expected));
+				memcpy(first_actual, actual, sizeof(actual));
+			}
+		}
+	}
+	rcu_read_unlock();
+	smp_rmb();
+	if (atomic_read(&sbi->s_checker_flex_active) ||
+	    seq != atomic64_read(&sbi->s_checker_flex_seq)) {
+		*checks = 0;
+		*violations = 0;
+		*unverified = 1;
+		first_flex = -1;
+	}
+	if (*violations)
+		pr_warn_ratelimited("EXT4 invariant violation: flex_group_counts "
+				    "mismatched_fields=%u first_flex=%d "
+				    "expected=(%lld,%lld,%lld) actual=(%lld,%lld,%lld)\n",
+				    *violations, first_flex,
+				    first_expected[0], first_expected[1], first_expected[2],
+				    first_actual[0], first_actual[1], first_actual[2]);
+out:
+	kvfree(sums);
+}
+
+struct ext4_checker_dirlink_scan {
+	u32 *entries;
+	u32 max_ino;
+};
+
+static int checker_dirlink_count_entry(u32 ino, void *data)
+{
+	struct ext4_checker_dirlink_scan *scan = data;
+
+	if (!ino || ino > scan->max_ino)
+		return -EFSCORRUPTED;
+	if (scan->entries[ino] == U32_MAX)
+		return -EOVERFLOW;
+	scan->entries[ino]++;
+	return 0;
+}
+
+static bool checker_dirlink_skip_target(struct super_block *sb, u32 ino)
+{
+	struct ext4_super_block *es = EXT4_SB(sb)->s_es;
+
+	if (ino < EXT4_FIRST_INO(sb) && ino != EXT4_ROOT_INO)
+		return true;
+	return ino == le32_to_cpu(es->s_usr_quota_inum) ||
+		ino == le32_to_cpu(es->s_grp_quota_inum) ||
+		ino == le32_to_cpu(es->s_prj_quota_inum) ||
+		ino == le32_to_cpu(es->s_orphan_file_inum);
+}
+
+/* Read the on-disk EA flag before iget; normal iget rejects EA inodes. */
+static struct inode *checker_dirlink_iget(struct super_block *sb, u32 ino,
+					  bool *is_ea)
+{
+	struct ext4_iloc iloc;
+	struct ext4_inode *raw;
+	ext4_iget_flags flags = EXT4_IGET_NORMAL;
+	int err;
+
+	*is_ea = false;
+	err = ext4_get_fc_inode_loc(sb, ino, &iloc);
+	if (err)
+		return ERR_PTR(err);
+	raw = ext4_raw_inode(&iloc);
+	if (!le16_to_cpu(raw->i_mode)) {
+		brelse(iloc.bh);
+		if (ino < EXT4_FIRST_INO(sb) && ino != EXT4_ROOT_INO) {
+			*is_ea = true; /* reserved inode slot is unused */
+			return NULL;
+		}
+		return ERR_PTR(-ESTALE);
+	}
+	if (le32_to_cpu(raw->i_flags) & EXT4_EA_INODE_FL) {
+		*is_ea = true;
+		brelse(iloc.bh);
+		return NULL;
+	}
+	if (ino < EXT4_FIRST_INO(sb) || checker_dirlink_skip_target(sb, ino))
+		flags = EXT4_IGET_SPECIAL;
+	brelse(iloc.bh);
+	return ext4_iget(sb, ino, flags);
+}
+
+/*
+ * Recompute the global dirent reference count for every ordinary inode.
+ * Any unreadable inode or directory invalidates the whole pass: comparing a
+ * partial sum could turn a valid filesystem into a false positive.
+ */
+static void ext4_checker_dirlink_snapshot(struct super_block *sb,
+					  u64 *checks, u64 *violations,
+					  u64 *unverified,
+					  u32 *bad_ino, u32 *bad_links,
+					  u32 *bad_entries, char *reason,
+					  size_t reason_size)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_dirlink_scan scan;
+	u32 max_ino = le32_to_cpu(sbi->s_es->s_inodes_count);
+	ext4_group_t groups = ext4_get_groups_count(sb);
+	ext4_group_t group;
+	bool complete = true;
+	bool raced;
+	u64 namespace_seq;
+	u64 checked = 0, mismatches = 0, skipped = 0;
+	u32 ino;
+
+	namespace_seq = atomic64_read(&sbi->s_checker_namespace_seq);
+	if (atomic_read(&sbi->s_checker_namespace_active)) {
+		*unverified = 1;
+		strscpy(reason, "namespace_update_active", reason_size);
+		return;
+	}
+	scan.max_ino = max_ino;
+	scan.entries = kvcalloc((size_t)max_ino + 1,
+				sizeof(*scan.entries), GFP_KERNEL);
+	if (!scan.entries) {
+		*unverified = 1;
+		strscpy(reason, "alloc", reason_size);
+		return;
+	}
+
+	for (group = 0; group < groups && complete; group++) {
+		struct buffer_head *bitmap;
+		unsigned int bit, limit = EXT4_INODES_PER_GROUP(sb);
+
+		bitmap = ext4_read_inode_bitmap(sb, group);
+		if (IS_ERR(bitmap)) {
+			complete = false;
+			strscpy(reason, "inode_bitmap_read", reason_size);
+			break;
+		}
+		for (bit = 0; bit < limit; bit++) {
+			struct inode *inode;
+			bool is_ea;
+
+			ino = group * EXT4_INODES_PER_GROUP(sb) + bit + 1;
+			if (ino > max_ino)
+				break;
+			if (checker_dirlink_skip_target(sb, ino))
+				continue;
+			if (!ext4_test_bit(bit, bitmap->b_data))
+				continue;
+			inode = checker_dirlink_iget(sb, ino, &is_ea);
+			if (is_ea)
+				continue;
+			if (IS_ERR(inode)) {
+				complete = false;
+				*bad_ino = ino;
+				strscpy(reason, "iget_first_pass", reason_size);
+				break;
+			}
+			if (is_bad_inode(inode)) {
+				iput(inode);
+				complete = false;
+				*bad_ino = ino;
+				strscpy(reason, "bad_inode_first_pass", reason_size);
+				break;
+			}
+			if (ext4_test_inode_flag(inode, EXT4_INODE_EA_INODE)) {
+				iput(inode);
+				continue;
+			}
+			if (S_ISDIR(inode->i_mode) && inode->i_nlink) {
+				int err = ext4_checker_scan_dir(inode,
+							checker_dirlink_count_entry,
+							&scan);
+
+				if (err) {
+					complete = false;
+					*bad_ino = ino;
+					snprintf(reason, reason_size, "dir_read_%d", err);
+				}
+			}
+			iput(inode);
+			if (!complete)
+				break;
+		}
+		brelse(bitmap);
+	}
+
+	if (complete) {
+		for (group = 0; group < groups && complete; group++) {
+			struct buffer_head *bitmap;
+			unsigned int bit, limit = EXT4_INODES_PER_GROUP(sb);
+
+			bitmap = ext4_read_inode_bitmap(sb, group);
+			if (IS_ERR(bitmap)) {
+				complete = false;
+				strscpy(reason, "inode_bitmap_second", reason_size);
+				break;
+			}
+			for (bit = 0; bit < limit; bit++) {
+				struct inode *inode;
+				u32 links, entries;
+				bool is_ea;
+
+				ino = group * EXT4_INODES_PER_GROUP(sb) + bit + 1;
+				if (ino > max_ino)
+					break;
+				/* System inodes do not follow the ordinary inode formula. */
+				if (checker_dirlink_skip_target(sb, ino))
+					continue;
+				if (!ext4_test_bit(bit, bitmap->b_data)) {
+					entries = scan.entries[ino];
+					if (!entries)
+						continue;
+					checked++;
+					if (!mismatches) {
+						*bad_ino = ino;
+						*bad_links = 0;
+						*bad_entries = entries;
+					}
+					mismatches++;
+					continue;
+				}
+				inode = checker_dirlink_iget(sb, ino, &is_ea);
+				if (is_ea)
+					continue;
+				if (IS_ERR(inode)) {
+					complete = false;
+					*bad_ino = ino;
+					strscpy(reason, "iget_second_pass", reason_size);
+					break;
+				}
+				if (is_bad_inode(inode)) {
+					iput(inode);
+					complete = false;
+					*bad_ino = ino;
+					strscpy(reason, "bad_inode_second_pass", reason_size);
+					break;
+				}
+				if (ext4_test_inode_flag(inode,
+							  EXT4_INODE_EA_INODE)) {
+					iput(inode);
+					continue;
+				}
+				if (S_ISDIR(inode->i_mode) && inode->i_nlink == 1 &&
+				    ext4_has_feature_dir_nlink(sb)) {
+					/* 1 is ext4's overflow/unknown-subdir sentinel. */
+					skipped++;
+					iput(inode);
+					continue;
+				}
+				links = inode->i_nlink;
+				entries = scan.entries[ino];
+				iput(inode);
+				checked++;
+				if (links == entries)
+					continue;
+				if (!mismatches) {
+					*bad_ino = ino;
+					*bad_links = links;
+					*bad_entries = entries;
+				}
+				mismatches++;
+			}
+			brelse(bitmap);
+		}
+	}
+
+	raced = atomic_read(&sbi->s_checker_namespace_active) ||
+		namespace_seq != atomic64_read(&sbi->s_checker_namespace_seq);
+	if (complete && !raced) {
+		*checks = checked;
+		*violations = mismatches;
+		*unverified = skipped;
+	} else {
+		*unverified = 1;
+		if (raced)
+			strscpy(reason, "namespace_update_race", reason_size);
+	}
+	kvfree(scan.entries);
+}
+
+int ext4_checker_snapshot(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	s64 sums[3] = { 0, 0, 0 };
+	s64 actual_global[3];
+	ext4_fsblk_t first_block = le32_to_cpu(sbi->s_es->s_first_data_block);
+	ext4_fsblk_t blocks = ext4_blocks_count(sbi->s_es);
+	unsigned int i;
+	int violations = 0;
+	int stable_violations = 0;
+	int unverified = 0;
+	int bitmap_violations = 0;
+	unsigned int inode_checks = 0, inode_unverified = 0, inode_violations = 0;
+	unsigned int block_checks = 0, block_unverified = 0, block_violations = 0;
+	int descriptor_violations = 0;
+	int checksum_violations = 0;
+	int bounds_violations = 0;
+	int shadow_violations = 0;
+	int global_violations = 0;
+	int global_shadow_drift = 0;
+	unsigned int orphan_file_checks = 0;
+	unsigned int orphan_file_violations = 0;
+	unsigned int orphan_file_unverified = 0;
+	unsigned int ea_inode_checks = 0;
+	unsigned int ea_inode_violations = 0;
+	unsigned int ea_inode_unverified = 0;
+	unsigned int xattr_block_checks = 0;
+	unsigned int xattr_block_violations = 0;
+	unsigned int xattr_block_unverified = 0;
+	unsigned int flex_checks = 0, flex_violations = 0, flex_unverified = 0;
+	bool raced;
+	bool dirlink_raced;
+	bool namespace_active;
+	u64 event_seq;
+	u64 namespace_seq;
+	u64 xattr_seq;
+	bool xattr_active;
+	u64 dirlink_checks = 0, dirlink_violations = 0;
+	u64 dirlink_unverified = 0;
+	u64 mb_pending = 0, mb_pending_tracked = 0;
+	u64 mb_pending_checks = 0, mb_pending_violations = 0;
+	u64 mb_pending_unverified = 0;
+	u64 mb_buddy_checks = 0, mb_buddy_violations = 0;
+	u64 mb_buddy_unverified = 0;
+	u32 mb_buddy_bad_group = 0, mb_buddy_bad_expected = 0;
+	u32 mb_buddy_bad_actual = 0;
+	s64 delalloc_expected = 0, delalloc_actual = 0;
+	u64 delalloc_checks = 0, delalloc_violations = 0;
+	u64 delalloc_unverified = 0;
+	unsigned long delalloc_bad_ino = 0;
+	unsigned long ea_inode_bad_ino = 0;
+	u64 ea_inode_bad_expected = 0, ea_inode_bad_actual = 0;
+	u64 xattr_bad_block = 0;
+	u32 xattr_bad_ref = 0, xattr_bad_expected = 0;
+	char xattr_reason[48] = "none";
+	char ea_inode_reason[48] = "none";
+	u32 dirlink_bad_ino = 0, dirlink_bad_links = 0;
+	u32 dirlink_bad_entries = 0;
+	char dirlink_reason[48] = "none";
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return 0;
+	down_write(&sbi->s_checker_barrier);
+	if (READ_ONCE(sbi->s_checker_resize_active) ||
+	    test_bit(EXT4_FLAGS_RESIZING, &sbi->s_ext4_flags)) {
+		spin_lock(&sbi->s_checker_lock);
+		sbi->s_checker_unverified_count++;
+		scnprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "snapshot unverified resize_active groups=%u\n",
+			  READ_ONCE(sbi->s_groups_count));
+		spin_unlock(&sbi->s_checker_lock);
+		up_write(&sbi->s_checker_barrier);
+		return 0;
+	}
+	spin_lock(&sbi->s_checker_lock);
+	namespace_active = atomic_read(&sbi->s_checker_namespace_active) != 0;
+	event_seq = sbi->s_checker_event_seq;
+	namespace_seq = atomic64_read(&sbi->s_checker_namespace_seq);
+	xattr_seq = atomic64_read(&sbi->s_checker_xattr_seq);
+	xattr_active = atomic_read(&sbi->s_checker_xattr_active) != 0;
+	spin_unlock(&sbi->s_checker_lock);
+	for (i = 0; i < sbi->s_groups_count; i++) {
+		struct ext4_group_desc *gdp;
+		struct buffer_head *bh;
+		int bitmap_free;
+
+		gdp = ext4_get_group_desc(sb, i, NULL);
+		if (!gdp) {
+			block_unverified++;
+			inode_unverified++;
+			continue;
+		}
+		if (i >= READ_ONCE(sbi->s_checker_group_capacity)) {
+			unverified++;
+			block_unverified++;
+			inode_unverified++;
+			continue;
+		}
+		bh = ext4_read_block_bitmap(sb, i);
+		if (IS_ERR(bh)) {
+			unverified++;
+			block_unverified++;
+		}
+		else {
+			bitmap_free = ext4_count_free(bh->b_data,
+							ext4_num_clusters_in_group(sb, i) / 8);
+			block_checks++;
+			if (bitmap_free != ext4_free_group_clusters(sb, gdp)) {
+				block_violations++;
+				bitmap_violations++;
+				violations++;
+			}
+			brelse(bh);
+		}
+		bitmap_free = ext4_checker_count_free_inodes(sb, i);
+		if (bitmap_free < 0) {
+			unverified++;
+			inode_unverified++;
+		} else {
+			inode_checks++;
+			if (bitmap_free != ext4_free_inodes_count(sb, gdp)) {
+				bitmap_violations++;
+				inode_violations++;
+				violations++;
+			}
+		}
+	}
+	ext4_checker_orphan_file_snapshot(sb, &orphan_file_checks,
+					 &orphan_file_violations,
+					 &orphan_file_unverified);
+	violations += orphan_file_violations;
+	unverified += orphan_file_unverified;
+	ext4_checker_xattr_block_snapshot(sb, &xattr_block_checks,
+					  &xattr_block_violations,
+					  &xattr_block_unverified,
+					  &xattr_bad_block, &xattr_bad_ref,
+					  &xattr_bad_expected, xattr_reason,
+					  sizeof(xattr_reason));
+	violations += xattr_block_violations;
+	unverified += xattr_block_unverified;
+	ext4_checker_ea_inode_snapshot(sb, &ea_inode_checks,
+					&ea_inode_violations,
+					&ea_inode_unverified,
+					&ea_inode_bad_ino,
+					&ea_inode_bad_expected,
+					&ea_inode_bad_actual,
+					ea_inode_reason,
+					sizeof(ea_inode_reason));
+	violations += ea_inode_violations;
+	unverified += ea_inode_unverified;
+	ext4_checker_flex_snapshot(sb, &flex_checks, &flex_violations,
+				   &flex_unverified);
+	violations += flex_violations;
+	unverified += flex_unverified;
+	ext4_checker_dirlink_snapshot(sb, &dirlink_checks,
+				      &dirlink_violations,
+				      &dirlink_unverified, &dirlink_bad_ino,
+				      &dirlink_bad_links,
+				      &dirlink_bad_entries, dirlink_reason,
+				      sizeof(dirlink_reason));
+	unverified += dirlink_unverified;
+	if (ext4_mb_pending_snapshot(sb, &mb_pending, &mb_pending_tracked)) {
+		mb_pending_checks++;
+		if (mb_pending != mb_pending_tracked) {
+			mb_pending_violations++;
+			violations++;
+		}
+	} else {
+		mb_pending_unverified++;
+		unverified++;
+	}
+	if (checker_delalloc_snapshot(sb, &delalloc_expected,
+					      &delalloc_actual, &delalloc_bad_ino)) {
+		delalloc_checks++;
+		if (delalloc_expected != delalloc_actual) {
+			delalloc_violations++;
+			violations++;
+		}
+	} else {
+		delalloc_unverified++;
+		unverified++;
+	}
+	if (ext4_checker_mb_buddy_snapshot(sb, &mb_buddy_checks,
+						   &mb_buddy_violations,
+						   &mb_buddy_unverified,
+						   &mb_buddy_bad_group,
+						   &mb_buddy_bad_expected,
+						   &mb_buddy_bad_actual)) {
+		violations += mb_buddy_violations;
+	} else {
+		mb_buddy_unverified++;
+		unverified++;
+	}
+	spin_lock(&sbi->s_checker_lock);
+	sbi->s_checker_snapshot_count++;
+	for (i = 0; i < sbi->s_groups_count; i++) {
+		struct ext4_group_desc *gdp;
+		s64 actual;
+		ext4_fsblk_t block_bitmap, inode_bitmap, inode_table;
+
+		gdp = ext4_get_group_desc(sb, i, NULL);
+		if (!gdp) {
+			descriptor_violations++;
+			violations++;
+			continue;
+		}
+		if (i >= sbi->s_checker_group_capacity) {
+			unverified++;
+			sums[EXT4_CHECKER_CLUSTERS] +=
+				checker_group_actual(sb, i, EXT4_CHECKER_CLUSTERS);
+			sums[EXT4_CHECKER_INODES] +=
+				checker_group_actual(sb, i, EXT4_CHECKER_INODES);
+			sums[EXT4_CHECKER_DIRS] +=
+				checker_group_actual(sb, i, EXT4_CHECKER_DIRS);
+			continue;
+		}
+		if (!ext4_group_desc_csum_verify(sb, i, gdp)) {
+			checksum_violations++;
+			violations++;
+		}
+		block_bitmap = ext4_block_bitmap(sb, gdp);
+		inode_bitmap = ext4_inode_bitmap(sb, gdp);
+		inode_table = ext4_inode_table(sb, gdp);
+		if (block_bitmap < first_block || block_bitmap >= blocks ||
+		    inode_bitmap < first_block || inode_bitmap >= blocks ||
+		    inode_table < first_block || inode_table >= blocks ||
+		    sbi->s_itb_per_group > blocks - inode_table) {
+			bounds_violations++;
+			violations++;
+		}
+
+		actual = checker_group_actual(sb, i, EXT4_CHECKER_CLUSTERS);
+		if (actual < 0 || actual > sbi->s_clusters_per_group) {
+			bounds_violations++;
+			violations++;
+		}
+		if (actual != sbi->s_checker_groups[i].clusters) {
+			shadow_violations++;
+			violations++;
+		}
+		sbi->s_checker_groups[i].clusters = actual;
+		sums[EXT4_CHECKER_CLUSTERS] += actual;
+		actual = checker_group_actual(sb, i, EXT4_CHECKER_INODES);
+		if (actual < 0 || actual > sbi->s_inodes_per_group) {
+			bounds_violations++;
+			violations++;
+		}
+		if (actual != sbi->s_checker_groups[i].inodes) {
+			shadow_violations++;
+			violations++;
+		}
+		sbi->s_checker_groups[i].inodes = actual;
+		sums[EXT4_CHECKER_INODES] += actual;
+		actual = checker_group_actual(sb, i, EXT4_CHECKER_DIRS);
+		if (actual < 0 || actual > sbi->s_inodes_per_group) {
+			bounds_violations++;
+			violations++;
+		}
+		if (actual != sbi->s_checker_groups[i].dirs) {
+			shadow_violations++;
+			violations++;
+		}
+		sbi->s_checker_groups[i].dirs = actual;
+		sums[EXT4_CHECKER_DIRS] += actual;
+	}
+	actual_global[0] = checker_global_actual(sbi, EXT4_CHECKER_CLUSTERS);
+	actual_global[1] = checker_global_actual(sbi, EXT4_CHECKER_INODES);
+	actual_global[2] = checker_global_actual(sbi, EXT4_CHECKER_DIRS);
+	for (i = 0; i < ARRAY_SIZE(sums); i++) {
+		if (actual_global[i] < 0) {
+			bounds_violations++;
+			violations++;
+		}
+		if (actual_global[i] != sums[i]) {
+			global_violations++;
+			violations++;
+		} else if (actual_global[i] != *checker_global_value(sbi, i)) {
+			/* The shadow is an event-stream diagnostic.  A drift here can
+			 * come from ext4 counter maintenance outside the metadata hook;
+			 * the authoritative relation is percpu total == group sum. */
+			global_shadow_drift++;
+		}
+	}
+	/* A percpu aggregate may be sampled while ext4 publishes a counter
+	 * update.  Re-read it once; only a mismatch that persists is actionable.
+	 */
+	if (global_violations) {
+		stable_violations = 0;
+		for (i = 0; i < ARRAY_SIZE(sums); i++) {
+			s64 reread = checker_global_actual(sbi, i);
+			if (reread != sums[i])
+				stable_violations++;
+		}
+		if (!stable_violations) {
+			violations -= global_violations;
+			global_violations = 0;
+		}
+	}
+	raced = event_seq != sbi->s_checker_event_seq ||
+		namespace_seq != atomic64_read(&sbi->s_checker_namespace_seq) ||
+		namespace_active ||
+		atomic_read(&sbi->s_checker_namespace_active) ||
+		xattr_seq != atomic64_read(&sbi->s_checker_xattr_seq) ||
+		xattr_active || atomic_read(&sbi->s_checker_xattr_active);
+	dirlink_raced = namespace_seq !=
+		atomic64_read(&sbi->s_checker_namespace_seq) ||
+		namespace_active ||
+		atomic_read(&sbi->s_checker_namespace_active);
+	if (raced) {
+		/* A concurrent metadata event makes this cross-operation view
+		 * unsuitable for asserting stable bitmap/descriptor invariants.
+		 */
+		violations = orphan_file_violations + xattr_block_violations +
+			flex_violations;
+		bitmap_violations = 0;
+		descriptor_violations = 0;
+		checksum_violations = 0;
+		bounds_violations = 0;
+		shadow_violations = 0;
+		global_violations = 0;
+		global_shadow_drift = 0;
+		xattr_block_checks = 0;
+		xattr_block_violations = 0;
+		xattr_block_unverified++;
+		ea_inode_unverified += ea_inode_checks;
+		if (!ea_inode_unverified && ext4_has_feature_ea_inode(sb))
+			ea_inode_unverified = 1;
+		ea_inode_checks = 0;
+		ea_inode_violations = 0;
+		unverified++;
+		sbi->s_checker_snapshot_races++;
+		if (mb_pending_checks || mb_pending_violations) {
+			violations -= mb_pending_violations;
+			mb_pending_violations = 0;
+			mb_pending_checks = 0;
+			mb_pending_unverified++;
+			unverified++;
+		}
+		if (mb_buddy_checks || mb_buddy_violations) {
+			violations -= mb_buddy_violations;
+			mb_buddy_violations = 0;
+			mb_buddy_checks = 0;
+			mb_buddy_unverified++;
+			unverified++;
+		}
+		if (delalloc_checks || delalloc_violations) {
+			violations -= delalloc_violations;
+			delalloc_violations = 0;
+			delalloc_checks = 0;
+			delalloc_unverified++;
+			unverified++;
+		}
+	}
+	if (raced) {
+		block_unverified += block_checks;
+		block_checks = 0;
+		block_violations = 0;
+		inode_unverified += inode_checks;
+		inode_checks = 0;
+		inode_violations = 0;
+	}
+	if (dirlink_raced) {
+		if (!raced)
+			unverified++;
+		dirlink_violations = 0;
+		dirlink_checks = 0;
+		dirlink_unverified = max_t(u64, dirlink_unverified, 1);
+	} else {
+		violations += dirlink_violations;
+	}
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_INODE_BITMAP] += inode_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_BLOCK_BITMAP] += block_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_ORPHAN_FILE] +=
+		orphan_file_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_XATTR_BLOCK_REFS] +=
+		xattr_block_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_EA_INODE_REFS] +=
+		ea_inode_checks;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_INODE_BITMAP] += inode_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_BLOCK_BITMAP] +=
+		block_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_ORPHAN_FILE] +=
+		orphan_file_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_XATTR_BLOCK_REFS] +=
+		xattr_block_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_EA_INODE_REFS] +=
+		ea_inode_unverified;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_FLEX_GROUP_COUNTS] +=
+		flex_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT] +=
+		dirlink_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_MB_FREE_PENDING] +=
+		mb_pending_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_DELALLOC_GLOBAL] +=
+		delalloc_checks;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_MB_BUDDY] +=
+		mb_buddy_checks;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_FLEX_GROUP_COUNTS] +=
+		flex_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT] +=
+		dirlink_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_MB_FREE_PENDING] +=
+		mb_pending_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_DELALLOC_GLOBAL] +=
+		delalloc_unverified;
+	sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_MB_BUDDY] +=
+		mb_buddy_unverified;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_INODE_BITMAP] += inode_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_BLOCK_BITMAP] +=
+		block_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_ORPHAN_FILE] +=
+		orphan_file_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_XATTR_BLOCK_REFS] +=
+		xattr_block_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_EA_INODE_REFS] +=
+		ea_inode_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_FLEX_GROUP_COUNTS] +=
+		flex_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT] +=
+		dirlink_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_MB_FREE_PENDING] +=
+		mb_pending_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_DELALLOC_GLOBAL] +=
+		delalloc_violations;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_MB_BUDDY] +=
+		mb_buddy_violations;
+	sbi->s_checker_unverified_count += unverified;
+	if (violations) {
+		sbi->s_checker_violation_count += violations;
+		scnprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "snapshot violations=%d unverified=%d groups=%u "
+			  "classes=bitmap:%d descriptor:%d checksum:%d bounds:%d "
+			  "orphan_file:%u xattr_block:%u ea_inode_refs:%u "
+			  "dirlink:%llu dirlink_first=%u:%u/%u "
+				  "mb_free_pending:%llu/%llu mb_buddy:%u/%u "
+				  "delalloc:%lld/%lld "
+			  "shadow:%d global:%d global_shadow_drift:%d sums=(%lld,%lld,%lld) "
+			  "globals=(%lld,%lld,%lld)\n", violations,
+			  unverified, sbi->s_groups_count,
+			  bitmap_violations, descriptor_violations, checksum_violations,
+			  bounds_violations, orphan_file_violations,
+			  xattr_block_violations, ea_inode_violations,
+			  dirlink_violations,
+			  dirlink_bad_ino, dirlink_bad_links,
+				  dirlink_bad_entries, mb_pending, mb_pending_tracked,
+				  mb_buddy_bad_expected, mb_buddy_bad_actual,
+				  delalloc_expected, delalloc_actual,
+			  shadow_violations, global_violations,
+			  global_shadow_drift,
+			  sums[0], sums[1], sums[2],
+			  actual_global[0], actual_global[1], actual_global[2]);
+		pr_warn_ratelimited("EXT4 invariant violation: %s",
+				    sbi->s_checker_last_report);
+		strscpy(sbi->s_checker_last_violation,
+			sbi->s_checker_last_report);
+	} else if (raced)
+		scnprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "snapshot unstable events=%llu->%llu groups=%u\n",
+			  event_seq, sbi->s_checker_event_seq, sbi->s_groups_count);
+	else if (xattr_block_violations)
+		snprintf(sbi->s_checker_last_report,
+			 sizeof(sbi->s_checker_last_report),
+			 "snapshot xattr_block_refs=%u first_block=%llu expected=%u actual=%u reason=%s\n",
+			 xattr_block_violations, xattr_bad_block,
+			 xattr_bad_expected, xattr_bad_ref, xattr_reason);
+	else if (xattr_block_unverified)
+		snprintf(sbi->s_checker_last_report,
+			 sizeof(sbi->s_checker_last_report),
+			 "snapshot partial xattr_block_refs_unverified=%u reason=%s groups=%u\n",
+			 xattr_block_unverified, xattr_reason, sbi->s_groups_count);
+	else if (dirlink_unverified)
+			scnprintf(sbi->s_checker_last_report,
+				  sizeof(sbi->s_checker_last_report),
+				  "snapshot partial dirlink_unverified=%llu reason=%s ino=%u groups=%u\n",
+				  dirlink_unverified, dirlink_reason,
+				  dirlink_bad_ino, sbi->s_groups_count);
+	else
+		scnprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "snapshot OK groups=%u free_clusters=%lld free_inodes=%lld dirs=%lld\n",
+			  sbi->s_groups_count, actual_global[0], actual_global[1],
+			  actual_global[2]);
+	if (delalloc_violations) {
+		scnprintf(sbi->s_checker_last_violation,
+			   sizeof(sbi->s_checker_last_violation),
+			   "model=delalloc_global_reservation source=stable_snapshot ino=%lu expected=%lld actual=%lld\n",
+			   delalloc_bad_ino, delalloc_expected, delalloc_actual);
+		pr_warn_ratelimited("EXT4 invariant violation: %s",
+				    sbi->s_checker_last_violation);
+	} else if (mb_buddy_violations) {
+		scnprintf(sbi->s_checker_last_violation,
+			   sizeof(sbi->s_checker_last_violation),
+			   "model=mb_buddy_free source=stable_snapshot group=%u expected=%u actual=%u\n",
+			   mb_buddy_bad_group, mb_buddy_bad_expected,
+			   mb_buddy_bad_actual);
+		pr_warn_ratelimited("EXT4 invariant violation: %s",
+				    sbi->s_checker_last_violation);
+	}
+	if (ea_inode_violations) {
+		scnprintf(sbi->s_checker_last_violation,
+			  sizeof(sbi->s_checker_last_violation),
+			  "model=ea_inode_references source=stable_snapshot ino=%lu "
+			  "expected_ref=%llu actual_ref=%llu reason=%s\n",
+			  ea_inode_bad_ino,
+			  (unsigned long long)ea_inode_bad_expected,
+			  (unsigned long long)ea_inode_bad_actual,
+			  ea_inode_reason);
+		pr_warn_ratelimited("EXT4 invariant violation: %s",
+				    sbi->s_checker_last_violation);
+	} else if (ea_inode_unverified && !violations && !raced) {
+		scnprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "snapshot partial ea_inode_references_unverified=%u reason=%s groups=%u\n",
+			  ea_inode_unverified, ea_inode_reason, sbi->s_groups_count);
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	up_write(&sbi->s_checker_barrier);
+	if (violations && checker_panic)
+		panic("ext4 invariant checker: snapshot mismatch");
+	return violations;
+}
+
+static void checker_models_show(struct seq_file *m, struct ext4_sb_info *sbi)
+{
+	unsigned int i;
+	struct ext4_checker_journal_stats *journal =
+		&sbi->s_checker_journal_stats;
+
+	for (i = 0; i < EXT4_CHECKER_MODEL_COUNT; i++) {
+		seq_printf(m, "model_%s_checks=%llu\n", checker_model_name(i),
+			   sbi->s_checker_model_checks[i]);
+		seq_printf(m, "model_%s_violations=%llu\n", checker_model_name(i),
+			   sbi->s_checker_model_violations[i]);
+		seq_printf(m, "model_%s_unverified=%llu\n", checker_model_name(i),
+			   sbi->s_checker_model_unverified[i]);
+	}
+	seq_printf(m, "model_migrate_postcondition_checks=%llu\n",
+		   sbi->s_checker_migrate_checks);
+	seq_printf(m, "model_migrate_postcondition_violations=%llu\n",
+		   sbi->s_checker_migrate_violations);
+	seq_printf(m, "model_mkdir_atomicity_checks=%llu\n",
+		   sbi->s_checker_mkdir_atomicity_checks);
+	seq_printf(m, "model_mkdir_atomicity_violations=%llu\n",
+		   sbi->s_checker_mkdir_atomicity_violations);
+	seq_printf(m, "model_mkdir_atomicity_unverified=%llu\n",
+		   sbi->s_checker_mkdir_atomicity_unverified);
+	seq_printf(m, "model_xattr_update_atomicity_checks=%llu\n",
+		   sbi->s_checker_xattr_atomicity_checks);
+	seq_printf(m, "model_xattr_update_atomicity_violations=%llu\n",
+		   sbi->s_checker_xattr_atomicity_violations);
+	seq_printf(m, "model_xattr_update_atomicity_unverified=%llu\n",
+		   sbi->s_checker_xattr_atomicity_unverified);
+	seq_printf(m, "model_acl_mode_consistency_checks=%llu\n",
+		   sbi->s_checker_acl_mode_checks);
+	seq_printf(m, "model_acl_mode_consistency_violations=%llu\n",
+		   sbi->s_checker_acl_mode_violations);
+	seq_printf(m, "model_acl_mode_consistency_unverified=%llu\n",
+		   sbi->s_checker_acl_mode_unverified);
+	seq_printf(m, "model_inline_dir_conversion_checks=%llu\n",
+		   sbi->s_checker_inline_dir_checks);
+	seq_printf(m, "model_inline_dir_conversion_violations=%llu\n",
+		   sbi->s_checker_inline_dir_violations);
+	seq_printf(m, "model_inline_dir_conversion_unverified=%llu\n",
+		   sbi->s_checker_inline_dir_unverified);
+	seq_printf(m, "model_fileattr_atomicity_checks=%llu\n",
+		   sbi->s_checker_fileattr_checks);
+	seq_printf(m, "model_fileattr_atomicity_violations=%llu\n",
+		   sbi->s_checker_fileattr_violations);
+	seq_printf(m, "model_fileattr_atomicity_unverified=%llu\n",
+		   sbi->s_checker_fileattr_unverified);
+	for (i = 0; i < EXT4_CHECKER_ERROR_SOURCE_COUNT; i++) {
+		struct ext4_checker_error_stats *stats =
+			&sbi->s_checker_error_stats[i];
+		const char *name = checker_error_source_name(i);
+
+		seq_printf(m, "error_exit_%s_hits=%llu\n", name, stats->hits);
+		seq_printf(m, "error_exit_%s_verified=%llu\n", name,
+			   stats->verified);
+		seq_printf(m, "error_exit_%s_unverified=%llu\n", name,
+			   stats->unverified);
+		seq_printf(m, "error_exit_%s_enospc=%llu\n", name,
+			   stats->enospc);
+		seq_printf(m, "error_exit_%s_edquot=%llu\n", name,
+			   stats->edquot);
+		seq_printf(m, "error_exit_%s_eio=%llu\n", name, stats->eio);
+		seq_printf(m, "error_exit_%s_enomem=%llu\n", name, stats->enomem);
+		seq_printf(m, "error_exit_%s_other=%llu\n", name, stats->other);
+		seq_printf(m, "error_exit_%s_last_errno=%d\n", name,
+			   stats->last_errno);
+		seq_printf(m, "error_exit_%s_last_expected=%lld\n", name,
+			   stats->last_expected);
+		seq_printf(m, "error_exit_%s_last_actual=%lld\n", name,
+			   stats->last_actual);
+	}
+	for (i = 0; i < EXT4_CHECKER_TARGET_ERROR_COUNT; i++)
+		seq_printf(m, "target_error_%s=%llu\n",
+			   checker_target_error_name(i),
+			   sbi->s_checker_target_errors[i]);
+	for (i = 0; i < EXT4_CHECKER_IO_STAGE_COUNT; i++)
+		seq_printf(m, "io_stage_%s_errors=%llu\n",
+			   checker_io_stage_name(i), sbi->s_checker_io_stages[i]);
+	seq_printf(m, "journal_commit_callbacks=%llu\n",
+		   journal->commit_callbacks);
+	seq_printf(m, "journal_aborted_callbacks=%llu\n",
+		   journal->aborted_callbacks);
+	seq_printf(m, "journal_fsdev_write_error_observations=%llu\n",
+		   journal->fsdev_write_error_observations);
+	seq_printf(m, "journal_abort_callbacks=%llu\n",
+		   journal->abort_callbacks);
+	seq_printf(m, "journal_abort_fsdev_write_error_observations=%llu\n",
+		   journal->abort_fsdev_write_error_observations);
+	seq_printf(m, "journal_last_tid=%llu\n", journal->last_tid);
+	seq_printf(m, "journal_last_aborted=%d\n", journal->last_aborted);
+	seq_printf(m, "journal_last_errno=%d\n",
+		   journal->last_journal_errno);
+	seq_printf(m, "journal_last_fsdev_write_errno=%d\n",
+		   journal->last_fsdev_write_errno);
+	seq_printf(m, "journal_last_abort_commit_sequence=%llu\n",
+		   journal->last_abort_commit_sequence);
+	seq_printf(m, "journal_last_abort_errno=%d\n",
+		   journal->last_abort_errno);
+	seq_printf(m, "journal_last_abort_fsdev_write_errno=%d\n",
+		   journal->last_abort_fsdev_write_errno);
+}
