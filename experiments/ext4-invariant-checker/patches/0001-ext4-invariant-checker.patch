+	sbi->s_checker_tx_underflows = 0;
+	sbi->s_checker_tx_context_count = 0;
+	memset(sbi->s_checker_model_checks, 0, sizeof(sbi->s_checker_model_checks));
+	memset(sbi->s_checker_model_violations, 0,
+	       sizeof(sbi->s_checker_model_violations));
+	memset(sbi->s_checker_model_unverified, 0,
+	       sizeof(sbi->s_checker_model_unverified));
+	sbi->s_checker_migrate_checks = 0;
+	sbi->s_checker_migrate_violations = 0;
+	sbi->s_checker_mkdir_atomicity_checks = 0;
+	sbi->s_checker_mkdir_atomicity_violations = 0;
+	sbi->s_checker_mkdir_atomicity_unverified = 0;
+	sbi->s_checker_xattr_atomicity_checks = 0;
+	sbi->s_checker_xattr_atomicity_violations = 0;
+	sbi->s_checker_xattr_atomicity_unverified = 0;
+	sbi->s_checker_acl_mode_checks = 0;
+	sbi->s_checker_acl_mode_violations = 0;
+	sbi->s_checker_acl_mode_unverified = 0;
+	sbi->s_checker_inline_dir_checks = 0;
+	sbi->s_checker_inline_dir_violations = 0;
+	sbi->s_checker_inline_dir_unverified = 0;
+	sbi->s_checker_fileattr_checks = 0;
+	sbi->s_checker_fileattr_violations = 0;
+	sbi->s_checker_fileattr_unverified = 0;
+	memset(sbi->s_checker_error_stats, 0,
+	       sizeof(sbi->s_checker_error_stats));
+	memset(sbi->s_checker_target_errors, 0,
+	       sizeof(sbi->s_checker_target_errors));
+	memset(sbi->s_checker_io_stages, 0,
+	       sizeof(sbi->s_checker_io_stages));
+	memset(&sbi->s_checker_journal_stats, 0,
+	       sizeof(sbi->s_checker_journal_stats));
+	memset(sbi->s_checker_txids, 0, sizeof(sbi->s_checker_txids));
+	memset(sbi->s_checker_txrefs, 0, sizeof(sbi->s_checker_txrefs));
+	sbi->s_checker_last_report[0] = '\0';
+	sbi->s_checker_last_violation[0] = '\0';
+	spin_unlock(&sbi->s_checker_lock);
+	up_write(&sbi->s_checker_barrier);
+	return count;
+}
