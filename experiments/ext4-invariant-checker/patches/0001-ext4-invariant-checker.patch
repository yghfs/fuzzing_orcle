+void ext4_checker_start(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	unsigned int i;
+	size_t groups_bytes, events_bytes;
+
+	init_rwsem(&sbi->s_checker_barrier);
+	spin_lock_init(&sbi->s_checker_lock);
+	atomic_set(&sbi->s_checker_namespace_active, 0);
+	atomic64_set(&sbi->s_checker_namespace_seq, 0);
+	atomic_set(&sbi->s_checker_xattr_active, 0);
+	atomic64_set(&sbi->s_checker_xattr_seq, 0);
+	atomic_set(&sbi->s_checker_flex_active, 0);
+	atomic64_set(&sbi->s_checker_flex_seq, 0);
+	if (checker_event_cap < EXT4_CHECKER_EVENT_CAP_MIN ||
+	    checker_event_cap > EXT4_CHECKER_EVENT_CAP_MAX)
+		checker_event_cap = EXT4_CHECKER_EVENT_CAP;
+	sbi->s_checker_event_size = checker_event_cap;
+	groups_bytes = (size_t)sbi->s_groups_count * sizeof(*sbi->s_checker_groups);
+	events_bytes = (size_t)sbi->s_checker_event_size * sizeof(*sbi->s_checker_events);
+	sbi->s_checker_groups = kcalloc(sbi->s_groups_count,
+					 sizeof(*sbi->s_checker_groups), GFP_KERNEL);
+	/* The maximum ring is several MiB; kvcalloc avoids requiring a large
+	 * physically contiguous allocation during early filesystem mount.
+	 */
+	sbi->s_checker_events = kvcalloc(sbi->s_checker_event_size,
+					  sizeof(*sbi->s_checker_events), GFP_KERNEL);
+	sbi->s_checker_tx_context = kcalloc(EXT4_CHECKER_TX_CONTEXT,
+					 sizeof(*sbi->s_checker_tx_context), GFP_KERNEL);
+	if (!sbi->s_checker_groups || !sbi->s_checker_events ||
+	    !sbi->s_checker_tx_context)
+		goto out_free;
+	for (i = 0; i < sbi->s_groups_count; i++) {
+		sbi->s_checker_groups[i].clusters =
+			ext4_free_group_clusters(sb, ext4_get_group_desc(sb, i, NULL));
+		sbi->s_checker_groups[i].inodes =
+			ext4_free_inodes_count(sb, ext4_get_group_desc(sb, i, NULL));
+		sbi->s_checker_groups[i].dirs =
+			ext4_used_dirs_count(sb, ext4_get_group_desc(sb, i, NULL));
+	}
+	sbi->s_checker_group_capacity = sbi->s_groups_count;
+	sbi->s_checker_global[EXT4_CHECKER_CLUSTERS] =
+		percpu_counter_sum(&sbi->s_freeclusters_counter);
+	sbi->s_checker_global[EXT4_CHECKER_INODES] =
+		percpu_counter_sum(&sbi->s_freeinodes_counter);
+	sbi->s_checker_global[EXT4_CHECKER_DIRS] =
+		percpu_counter_sum(&sbi->s_dirs_counter);
+	sbi->s_checker_active = true;
+	if (!checker_debugfs_root)
+		checker_debugfs_root = debugfs_create_dir("ext4", NULL);
+	if (!IS_ERR_OR_NULL(checker_debugfs_root)) {
+		sbi->s_checker_dir = debugfs_create_dir(sb->s_id,
+							 checker_debugfs_root);
+		if (!IS_ERR_OR_NULL(sbi->s_checker_dir))
+			debugfs_create_file("invariant_check", 0600,
+					    sbi->s_checker_dir, sb,
+					    &checker_debugfs_fops);
+		if (!IS_ERR_OR_NULL(sbi->s_checker_dir))
+			debugfs_create_file("invariant_summary", 0400,
+					    sbi->s_checker_dir, sb,
+					    &checker_debugfs_summary_fops);
+		if (!IS_ERR_OR_NULL(sbi->s_checker_dir))
+			debugfs_create_file("invariant_reset", 0200,
+					    sbi->s_checker_dir, sb,
+					    &checker_debugfs_reset_fops);
+	}
+	ext4_msg(sb, KERN_INFO, "invariant checker enabled");
+	return;
+out_free:
+	ext4_msg(sb, KERN_ERR,
+		 "invariant checker disabled: allocation failed groups=%u "
+		 "groups_bytes=%zu events=%u event_bytes=%zu",
+		 sbi->s_groups_count, groups_bytes, sbi->s_checker_event_size,
+		 events_bytes);
+	kvfree(sbi->s_checker_events);
+	kfree(sbi->s_checker_tx_context);
+	kfree(sbi->s_checker_groups);
+	sbi->s_checker_events = NULL;
+	sbi->s_checker_tx_context = NULL;
+	sbi->s_checker_groups = NULL;
+}
+
+void ext4_checker_stop(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!sbi->s_checker_events)
+		return;
+	down_write(&sbi->s_checker_barrier);
+	sbi->s_checker_active = false;
+	/* xattr operations hold an activity reference across their transaction;
+	 * wait for those references before freeing checker storage. */
+	spin_lock(&sbi->s_checker_lock);
+	spin_unlock(&sbi->s_checker_lock);
+	while (atomic_read(&sbi->s_checker_xattr_active))
+		cpu_relax();
+	/*
+	 * Hooks which raced the barrier trylock may still be waiting for the
+	 * checker lock.  Serialize with them before releasing the barrier and
+	 * freeing the ring they access.
+	 */
+	spin_lock(&sbi->s_checker_lock);
+	spin_unlock(&sbi->s_checker_lock);
+	up_write(&sbi->s_checker_barrier);
+	debugfs_remove_recursive(sbi->s_checker_dir);
+	kvfree(sbi->s_checker_events);
+	kfree(sbi->s_checker_tx_context);
+	kfree(sbi->s_checker_groups);
+	sbi->s_checker_events = NULL;
+	sbi->s_checker_tx_context = NULL;
+	sbi->s_checker_groups = NULL;
+}
