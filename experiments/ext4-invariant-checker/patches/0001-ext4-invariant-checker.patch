+		return;
+	/* mkdir() must not leave the parent's subdirectory link count changed
+	 * when it returns an error.  The VFS holds the parent inode lock here,
+	 * so the captured value is stable against other namespace operations.
+	 */
+	ext4_checker_count_check(dir, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+				 "failed_mkdir_parent_nlink", old_nlink,
+				 old_nlink, dir->i_nlink, true);
