+/*
+ * A failed inline-directory conversion must leave its old inline state
+ * usable. In particular, restoring the inline xattr is insufficient if the
+ * conversion already published a block mapping or advanced i_size.
+ */
+void ext4_checker_inline_dir_failure(struct inode *inode, int inline_size,
+				     int err)
+{
+	struct ext4_map_blocks map = { .m_lblk = 0, .m_len = 1 };
+	struct ext4_sb_info *sbi;
+	bool verified, mismatch;
+	int mapped;
+	bool barrier_locked;
+
+	if (!inode || !err || !S_ISDIR(inode->i_mode) ||
+	    !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active))
+		return;
+	sbi = EXT4_SB(inode->i_sb);
+	if (sbi->s_mount_state & EXT4_FC_REPLAY)
+		return;
+
+	mapped = ext4_map_blocks(NULL, inode, &map, 0);
+	verified = mapped >= 0;
+	mismatch = !ext4_has_inline_data(inode) || mapped > 0 ||
+		i_size_read(inode) != inline_size ||
+		EXT4_I(inode)->i_disksize != inline_size;
+
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	if (!verified) {
+		sbi->s_checker_inline_dir_unverified++;
+		sbi->s_checker_unverified_count++;
+	} else {
+		sbi->s_checker_inline_dir_checks++;
+		if (mismatch) {
+			sbi->s_checker_inline_dir_violations++;
+			sbi->s_checker_violation_count++;
+			snprintf(sbi->s_checker_last_report,
+				 sizeof(sbi->s_checker_last_report),
+				 "model=inline_dir_conversion source=failed_conversion_not_rolled_back ino=%lu size=%lld inline_size=%d mapped=%d err=%d\n",
+				 inode->i_ino, i_size_read(inode), inline_size,
+				 mapped > 0, err);
+			pr_warn_ratelimited("EXT4 invariant violation: %s",
+					    sbi->s_checker_last_report);
+			strscpy(sbi->s_checker_last_violation,
+				sbi->s_checker_last_report);
+			if (checker_panic) {
+				spin_unlock(&sbi->s_checker_lock);
+				checker_barrier_read_unlock(sbi, barrier_locked);
+				panic("ext4 invariant checker: inline directory conversion");
+			}
+		}
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
