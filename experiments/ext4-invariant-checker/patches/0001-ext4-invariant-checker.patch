+
+static unsigned int checker_event_cap = EXT4_CHECKER_EVENT_CAP;
+module_param_named(ext4_checker_event_cap, checker_event_cap, uint, 0600);
+MODULE_PARM_DESC(ext4_checker_event_cap,
+		 "metadata event ring capacity (64..65536)");
