+/*
+ * chmod updates i_mode before asking the filesystem to rewrite an extended
+ * access ACL. If that rewrite fails, mode and ACL permissions must still
+ * describe the same access rights.
+ */
+void ext4_checker_acl_mode_failure(struct inode *inode, int err)
+{
+	struct ext4_sb_info *sbi;
+	struct posix_acl *acl;
+	bool verified = false, mismatch = false, barrier_locked;
+	int owner = -1, group = -1, mask = -1, other = -1;
+	unsigned int i;
+
+	if (!inode || !err || !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active))
+		return;
+	sbi = EXT4_SB(inode->i_sb);
+	if (sbi->s_mount_state & EXT4_FC_REPLAY)
+		return;
+
+	acl = get_inode_acl(inode, ACL_TYPE_ACCESS);
+	if (IS_ERR(acl)) {
+		acl = NULL;
+	} else if (!acl) {
+		/* Without an access ACL, the inode mode is the permission state. */
+		verified = true;
+	} else {
+		for (i = 0; i < acl->a_count; i++) {
+			struct posix_acl_entry *entry = &acl->a_entries[i];
+
+			switch (entry->e_tag) {
+			case ACL_USER_OBJ:
+				owner = entry->e_perm;
+				break;
+			case ACL_GROUP_OBJ:
+				group = entry->e_perm;
+				break;
+			case ACL_MASK:
+				mask = entry->e_perm;
+				break;
+			case ACL_OTHER:
+				other = entry->e_perm;
+				break;
+			}
+		}
+		if (owner >= 0 && group >= 0 && other >= 0) {
+			umode_t group_perm = mask >= 0 ? mask : group;
+			umode_t acl_mode = ((owner & 7) << 6) |
+					   ((group_perm & 7) << 3) |
+					   (other & 7);
+
+			verified = true;
+			mismatch = (inode->i_mode & 0777) != acl_mode;
+		}
+	}
+	posix_acl_release(acl);
+
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	if (!verified) {
+		sbi->s_checker_acl_mode_unverified++;
+		sbi->s_checker_unverified_count++;
+	} else {
+		sbi->s_checker_acl_mode_checks++;
+		if (mismatch) {
+			sbi->s_checker_acl_mode_violations++;
+			sbi->s_checker_violation_count++;
+			snprintf(sbi->s_checker_last_report,
+				 sizeof(sbi->s_checker_last_report),
+				 "model=acl_mode_consistency source=failed_chmod_acl_update ino=%lu mode=%#o err=%d\n",
+				 inode->i_ino, inode->i_mode & 0777, err);
+			pr_warn_ratelimited("EXT4 invariant violation: %s",
+				    sbi->s_checker_last_report);
+			strscpy(sbi->s_checker_last_violation,
+				sbi->s_checker_last_report);
+			if (checker_panic) {
+				spin_unlock(&sbi->s_checker_lock);
+				checker_barrier_read_unlock(sbi, barrier_locked);
+				panic("ext4 invariant checker: ACL mode consistency");
+			}
+		}
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
