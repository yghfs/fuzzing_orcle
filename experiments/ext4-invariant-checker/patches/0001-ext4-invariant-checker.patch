+/*
+ * An xattr container is being destroyed, so each EA inode number stored in
+ * it represents a reference that must be dropped before the container goes
+ * away.  If iget fails, ext4_xattr_inode_dec_ref_all() currently continues
+ * and its caller still frees the container.  Record that lost ownership
+ * reference as an EA-reference invariant violation.
+ */
+void ext4_checker_ea_ref_release_error(struct inode *parent,
+				      unsigned long ea_ino, int err,
+				      const char *stage)
+{
+	struct ext4_sb_info *sbi;
+	bool barrier_locked;
+
+	if (!parent || !err)
+		return;
+	sbi = EXT4_SB(parent->i_sb);
+	if (!READ_ONCE(sbi->s_checker_active) ||
+	    (sbi->s_mount_state & EXT4_FC_REPLAY) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_EA_REFERENCES]++;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_EA_REFERENCES]++;
+	sbi->s_checker_violation_count++;
+	checker_record_locked(parent->i_sb, false, 0, EXT4_CHECKER_EA_REFS,
+			      EXT4_CHECKER_EVENT_EA_REFERENCE, parent->i_ino,
+			      ea_ino, 1, 0, 0, 1, 0, 1);
+	snprintf(sbi->s_checker_last_report,
+		 sizeof(sbi->s_checker_last_report),
+		 "model=ea_references source=xattr_container_release_%s "
+		 "parent_ino=%lu ea_ino=%lu expected_ref_delta=-1 "
+		 "actual_ref_delta=0 errno=%d\n",
+		 stage ?: "unknown", parent->i_ino, ea_ino, err);
+	pr_warn_ratelimited("EXT4 invariant violation: %s",
+			    sbi->s_checker_last_report);
+	strscpy(sbi->s_checker_last_violation, sbi->s_checker_last_report);
+	if (checker_panic) {
+		spin_unlock(&sbi->s_checker_lock);
+		checker_barrier_read_unlock(sbi, barrier_locked);
+		panic("ext4 invariant checker: EA reference lost");
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
