+/* xattr_delete_inode() detaches i_file_acl after this helper returns. */
+void ext4_checker_xattr_block_release_error(struct inode *inode,
+						      struct buffer_head *bh, int err)
+{
+	struct ext4_sb_info *sbi;
+	u32 before;
+	bool barrier_locked;
+
+	if (!inode || !bh || !err ||
+	    !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active))
+		return;
+	sbi = EXT4_SB(inode->i_sb);
+	if (sbi->s_mount_state & EXT4_FC_REPLAY)
+		return;
+	if (BHDR(bh)->h_magic != cpu_to_le32(EXT4_XATTR_MAGIC) ||
+	    BHDR(bh)->h_blocks != cpu_to_le32(1))
+		return;
+	before = le32_to_cpu(BHDR(bh)->h_refcount);
+	if (!before)
+		return;
+	/* A failed release has already committed the logical detach of this
+	 * inode's i_file_acl, but the external header did not receive its
+	 * required -1 update.  Record that delta directly. */
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_XATTR_BLOCK_REFS]++;
+	sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_XATTR_BLOCK_REFS]++;
+	sbi->s_checker_violation_count++;
+	snprintf(sbi->s_checker_last_report,
+		 sizeof(sbi->s_checker_last_report),
+		 "model=xattr_block_refs source=xattr_block_release_error block=%llu "
+		 "expected_ref_delta=-1 actual_ref_delta=0 ref=%u errno=%d\n",
+		 (unsigned long long)bh->b_blocknr, before, err);
+	strscpy(sbi->s_checker_last_violation, sbi->s_checker_last_report);
+	pr_warn_ratelimited("EXT4 invariant violation: %s",
+			    sbi->s_checker_last_report);
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
