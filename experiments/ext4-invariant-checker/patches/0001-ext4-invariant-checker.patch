+static int checker_debugfs_show(struct seq_file *m, void *unused)
+{
+	struct super_block *sb = m->private;
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	unsigned int i, slot;
+
+	ext4_checker_snapshot(sb);
+	spin_lock(&sbi->s_checker_lock);
+	checker_models_show(m, sbi);
+	seq_printf(m, "%s", sbi->s_checker_last_report);
+	seq_printf(m, "violations_total=%llu\n",
+		   sbi->s_checker_violation_count);
+	if (sbi->s_checker_last_violation[0])
+		seq_printf(m, "last_violation=%s", sbi->s_checker_last_violation);
+	seq_printf(m, "unverified_total=%llu\n",
+		   sbi->s_checker_unverified_count);
+	seq_printf(m, "snapshot_races=%llu\n",
+		   sbi->s_checker_snapshot_races);
+	seq_printf(m, "namespace_operations_active=%d\n",
+		   atomic_read(&sbi->s_checker_namespace_active));
+	seq_printf(m, "snapshots=%llu events_dropped=%llu\n",
+		   sbi->s_checker_snapshot_count, sbi->s_checker_event_dropped);
+	seq_printf(m, "tx_underflows=%llu\n", sbi->s_checker_tx_underflows);
+	seq_printf(m, "group_capacity=%u resize_unverified=%u\n",
+		   sbi->s_checker_group_capacity,
+		   sbi->s_checker_resize_unverified);
+	seq_printf(m, "events=%u\n", sbi->s_checker_event_count);
+	seq_printf(m, "tx_context=%u\n", sbi->s_checker_tx_context_count);
+	for (i = 0; i < sbi->s_checker_tx_context_count; i++) {
+		struct ext4_checker_event *event = &sbi->s_checker_tx_context[i];
+
+		seq_printf(m, "tx_context_event seq=%llu type=%s txid=%llu "
+			   "source=%s line=%u refs=%u->%u pid=%d cpu=%u\n",
+			   event->seq, checker_event_type_name(event->type),
+			   event->txid, checker_tx_source_name(event->tx_source),
+			   event->source_line, event->refs_before,
+			   event->refs_after, event->pid, event->cpu);
+	}
+	slot = (sbi->s_checker_event_head + sbi->s_checker_event_size -
+		sbi->s_checker_event_count) % sbi->s_checker_event_size;
+	for (i = 0; i < sbi->s_checker_event_count; i++) {
+		struct ext4_checker_event *event = &sbi->s_checker_events[slot];
+
+		if (event->type == EXT4_CHECKER_EVENT_TX_CREDITS) {
+			seq_printf(m, "event seq=%llu op=%llu type=tx_credits "
+				   "txid=%llu check=%llu extend=%u revoke=%lld "
+				   "result=%lld status=%s line=%u refs=%u pid=%d cpu=%u\n",
+				   event->seq, event->op_id, event->txid,
+				   event->range_start, event->range_len, event->delta,
+				   event->actual,
+				   checker_tx_source_name(event->tx_source),
+				   event->source_line, event->refs_before,
+				   event->pid, event->cpu);
+		} else {
+			seq_printf(m, "event seq=%llu op=%llu type=%s %s counter=%s "
+				   "group=%u ino=%llu range=%llu+%u txid=%llu delta=%lld "
+				   "old=%lld expected=%lld actual=%lld pid=%d cpu=%u "
+				   "source=%s line=%u refs=%u->%u\n",
+				   event->seq, event->op_id,
+				   checker_event_type_name(event->type),
+				   event->flags ? "group" : "global",
+				   checker_counter_name(event->counter), event->group,
+				   event->inode, event->range_start, event->range_len,
+				   event->txid, event->delta, event->old_value,
+				   event->expected, event->actual, event->pid, event->cpu,
+				   checker_tx_source_name(event->tx_source),
+				   event->source_line, event->refs_before,
+				   event->refs_after);
+		}
+		slot = (slot + 1) % sbi->s_checker_event_size;
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	return 0;
+}
