+	case EXT4_CHECKER_MODEL_RESERVATION: return EXT4_CHECKER_RESERVED_CLUSTERS;
+	case EXT4_CHECKER_MODEL_EA_REFERENCES: return EXT4_CHECKER_EA_REFS;
