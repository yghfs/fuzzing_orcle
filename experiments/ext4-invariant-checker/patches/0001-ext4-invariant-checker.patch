+/* A failed mkdir must not leave a parent dirent to the discarded inode. */
+void ext4_checker_mkdir_failure(struct inode *dir, unsigned long child_ino,
+				int err, bool verified, bool linked,
+				unsigned int old_nlink)
+{
+	struct ext4_sb_info *sbi;
+	bool barrier_locked;
+
+	if (!dir || !READ_ONCE(EXT4_SB(dir->i_sb)->s_checker_active))
+		return;
