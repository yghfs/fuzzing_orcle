+static const char *checker_error_source_name(enum ext4_checker_error_source source)
+{
+	switch (source) {
+	case EXT4_CHECKER_ERROR_INODE_ALLOC: return "inode_alloc";
+	case EXT4_CHECKER_ERROR_INODE_FREE: return "inode_free";
+	case EXT4_CHECKER_ERROR_DELALLOC_RESERVATION: return "delalloc_reservation";
+	case EXT4_CHECKER_ERROR_EXTENT_MAP: return "extent_map";
+	default: return "unknown";
+	}
+}
+
+static const char *checker_target_error_name(enum ext4_checker_target_error target)
+{
+	switch (target) {
+	case EXT4_CHECKER_TARGET_INODE_FREE_DESC_ACCESS:
+		return "inode_free_desc_access";
+	case EXT4_CHECKER_TARGET_INODE_ALLOC_DESC_ACCESS:
+		return "inode_alloc_desc_access";
+	case EXT4_CHECKER_TARGET_PENDING_ALLOC:
+		return "pending_reservation_alloc";
+	case EXT4_CHECKER_TARGET_EXTENT_GROW_DIRTY:
+		return "extent_grow_dirty_metadata";
+	default:
+		return "unknown";
+	}
+}
+
+void ext4_checker_target_error(struct super_block *sb,
+			       enum ext4_checker_target_error target)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool barrier_locked;
+
+	if (target >= EXT4_CHECKER_TARGET_ERROR_COUNT ||
+	    !READ_ONCE(sbi->s_checker_active) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+	sbi->s_checker_target_errors[target]++;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+static const char *checker_io_stage_name(enum ext4_checker_io_stage stage)
+{
+	switch (stage) {
+	case EXT4_CHECKER_IO_INODE_ALLOC_BITMAP: return "inode_alloc_bitmap";
+	case EXT4_CHECKER_IO_INODE_FREE_BITMAP: return "inode_free_bitmap";
+	case EXT4_CHECKER_IO_INODE_ALLOC_DESC: return "inode_alloc_desc";
+	case EXT4_CHECKER_IO_INODE_FREE_DESC: return "inode_free_desc";
+	case EXT4_CHECKER_IO_EXTENT_GROW_DIRTY: return "extent_grow_dirty";
+	default: return "unknown";
+	}
+}
+
+void ext4_checker_io_stage(struct super_block *sb,
+			   enum ext4_checker_io_stage stage)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool barrier_locked;
+
+	if (stage >= EXT4_CHECKER_IO_STAGE_COUNT ||
+	    !READ_ONCE(sbi->s_checker_active) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+	sbi->s_checker_io_stages[stage]++;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+/*
+ * Record journal commit outcomes separately from the in-memory inode models.
+ * A journal abort is a fail-stop event, not by itself an inode invariant
+ * violation.  The transaction ID lets users correlate this observation with
+ * the metadata events already retained in the checker event ring.
+ */
+void ext4_checker_journal_commit(struct super_block *sb, u64 tid,
+				 int aborted, int journal_errno,
+				 int fsdev_write_errno)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_journal_stats *stats;
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+	stats = &sbi->s_checker_journal_stats;
+	stats->commit_callbacks++;
+	if (aborted)
+		stats->aborted_callbacks++;
+	if (fsdev_write_errno)
+		stats->fsdev_write_error_observations++;
+	stats->last_tid = tid;
+	stats->last_aborted = !!aborted;
+	stats->last_journal_errno = journal_errno;
+	stats->last_fsdev_write_errno = fsdev_write_errno;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+/*
+ * Record the asynchronous abort request and the last completed journal
+ * sequence.  This is diagnostic telemetry only: an abort is fail-stop and
+ * does not establish an inode accounting violation by itself.
+ */
+void ext4_checker_journal_abort(struct super_block *sb, u64 commit_sequence,
+				int abort_errno, int fsdev_write_errno)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	struct ext4_checker_journal_stats *stats;
+	bool barrier_locked;
+
+	if (!READ_ONCE(sbi->s_checker_active) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+	stats = &sbi->s_checker_journal_stats;
+	stats->abort_callbacks++;
+	if (fsdev_write_errno)
+		stats->abort_fsdev_write_error_observations++;
+	stats->last_abort_commit_sequence = commit_sequence;
+	stats->last_abort_errno = abort_errno;
+	stats->last_abort_fsdev_write_errno = fsdev_write_errno;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+static void checker_record_error_exit(struct inode *inode,
+				      enum ext4_checker_error_source source,
+				      int err, bool verified,
+				      s64 expected, s64 actual)
+{
+	struct ext4_sb_info *sbi;
+	struct ext4_checker_error_stats *stats;
+	bool barrier_locked;
+
+	if (!inode || source >= EXT4_CHECKER_ERROR_SOURCE_COUNT || !err)
+		return;
+	sbi = EXT4_SB(inode->i_sb);
+	if (!READ_ONCE(sbi->s_checker_active) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+	stats = &sbi->s_checker_error_stats[source];
+	stats->hits++;
+	if (verified)
+		stats->verified++;
+	else
+		stats->unverified++;
+	switch (abs(err)) {
+	case ENOSPC: stats->enospc++; break;
+	case EDQUOT: stats->edquot++; break;
+	case EIO: stats->eio++; break;
+	case ENOMEM: stats->enomem++; break;
+	default: stats->other++; break;
+	}
+	stats->last_errno = err;
+	stats->last_expected = expected;
+	stats->last_actual = actual;
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+static void checker_record_locked(struct super_block *sb, bool group_event,
+				  ext4_group_t group,
+				  enum ext4_checker_counter counter,
+				  enum ext4_checker_event_type type,
+				  u64 inode, ext4_fsblk_t range_start,
+				  u32 range_len, u64 txid, s64 delta,
+				  s64 old_value, s64 expected, s64 actual);
+
+void ext4_checker_count_check(struct inode *inode,
+			      enum ext4_checker_model model, const char *source,
+			      s64 before, s64 expected, s64 actual, bool verified)
+{
+	struct ext4_sb_info *sbi;
+	bool barrier_locked;
+	enum ext4_checker_counter counter;
+
+	if (!inode || model >= EXT4_CHECKER_MODEL_COUNT)
+		return;
+	sbi = EXT4_SB(inode->i_sb);
+	if (!READ_ONCE(sbi->s_checker_active) ||
+	    (sbi->s_mount_state & EXT4_FC_REPLAY))
+		return;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return;
+	if (!verified) {
+		sbi->s_checker_model_unverified[model]++;
+		sbi->s_checker_unverified_count++;
+		spin_unlock(&sbi->s_checker_lock);
+		checker_barrier_read_unlock(sbi, barrier_locked);
+		return;
+	}
+	sbi->s_checker_model_checks[model]++;
+	counter = checker_model_counter(model);
+	checker_record_locked(inode->i_sb, false, 0, counter,
+			     checker_model_event(model), inode->i_ino, 0, 0, 0,
+			     actual - before, before, expected, actual);
+	if (expected != actual) {
+		sbi->s_checker_model_violations[model]++;
+		sbi->s_checker_violation_count++;
+		snprintf(sbi->s_checker_last_report,
+			  sizeof(sbi->s_checker_last_report),
+			  "model=%s source=%s ino=%lu before=%lld expected=%lld actual=%lld\n",
+			  checker_model_name(model), source ?: "unknown", inode->i_ino,
+			  before, expected, actual);
+		pr_warn_ratelimited("EXT4 invariant violation: %s",
+			    sbi->s_checker_last_report);
+		strscpy(sbi->s_checker_last_violation,
+			sbi->s_checker_last_report);
+		if (checker_panic) {
+			spin_unlock(&sbi->s_checker_lock);
+			checker_barrier_read_unlock(sbi, barrier_locked);
+			panic("ext4 invariant checker: model mismatch");
+		}
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+}
+
+/*
+ * ext4_group_extend_no_check() publishes the new filesystem and free-block
+ * counts before it adds the range to the block bitmap.  If adding the range
+ * fails, check that the failed operation did not leave those counts changed.
+ * The superblock free count is not kept current for ordinary allocations, so
+ * this comparison must use the value captured at this operation's entry.
+ */
+void ext4_checker_resize_group_extend_error(struct super_block *sb,
+					    ext4_fsblk_t old_blocks,
+					    ext4_fsblk_t old_free_blocks,
+					    int err)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	ext4_fsblk_t actual_values[2];
+	ext4_fsblk_t before[2] = { old_blocks, old_free_blocks };
+	const char *field[2] = { "blocks_count", "free_blocks_count" };
+	bool barrier_locked;
+	unsigned int i;
+
+	if (!err || !READ_ONCE(sbi->s_checker_active) ||
+	    (sbi->s_mount_state & EXT4_FC_REPLAY) ||
+	    !checker_event_lock(sbi, &barrier_locked))
+		return;
+
+	actual_values[0] = ext4_blocks_count(sbi->s_es);
+	actual_values[1] = ext4_free_blocks_count(sbi->s_es);
+	for (i = 0; i < ARRAY_SIZE(actual_values); i++) {
+		s64 before_s64, current_s64;
+
+		if (before[i] > S64_MAX || actual_values[i] > S64_MAX) {
+			sbi->s_checker_model_unverified[EXT4_CHECKER_MODEL_BLOCK_BITMAP]++;
+			sbi->s_checker_unverified_count++;
+			continue;
+		}
+		before_s64 = before[i];
+		current_s64 = actual_values[i];
+		sbi->s_checker_model_checks[EXT4_CHECKER_MODEL_BLOCK_BITMAP]++;
+		checker_record_locked(sb, false, 0, EXT4_CHECKER_CLUSTERS,
+				     EXT4_CHECKER_EVENT_COUNTER, 0, 0, 0, 0,
+				     current_s64 - before_s64, before_s64,
+				     before_s64, current_s64);
+		if (current_s64 == before_s64)
+			continue;
+		sbi->s_checker_model_violations[EXT4_CHECKER_MODEL_BLOCK_BITMAP]++;
+		sbi->s_checker_violation_count++;
+		snprintf(sbi->s_checker_last_report,
+			 sizeof(sbi->s_checker_last_report),
+			 "model=block_bitmap source=resize_group_extend_error_%s "
+			 "before=%lld expected=%lld actual=%lld errno=%d\n",
+			 field[i], before_s64, before_s64, current_s64, err);
+		pr_warn_ratelimited("EXT4 invariant violation: %s",
+				    sbi->s_checker_last_report);
+		strscpy(sbi->s_checker_last_violation,
+			sbi->s_checker_last_report);
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+	if (checker_panic &&
+	    (actual_values[0] != before[0] || actual_values[1] != before[1]))
+		panic("ext4 invariant checker: resize count mismatch");
+}
+
+/* All three bitmap hooks are called with the ext4 group lock held. */
+bool ext4_checker_inode_bitmap_begin(struct super_block *sb, ext4_group_t group)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool barrier_locked, tracked = false;
+
+	if (!READ_ONCE(sbi->s_checker_active) || sbi->s_mount_state & EXT4_FC_REPLAY)
+		return false;
+	if (!checker_event_lock(sbi, &barrier_locked))
+		return false;
+	if (group < sbi->s_checker_group_capacity) {
+		sbi->s_checker_groups[group].inode_updates++;
+		sbi->s_checker_event_seq++;
+		tracked = true;
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+	return tracked;
+}
+
+bool ext4_checker_inode_bitmap_busy(struct super_block *sb, ext4_group_t group)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	bool busy;
+
+	if (!READ_ONCE(sbi->s_checker_active))
+		return false;
+	spin_lock(&sbi->s_checker_lock);
+	busy = group >= sbi->s_checker_group_capacity ||
+		sbi->s_checker_groups[group].inode_updates;
+	spin_unlock(&sbi->s_checker_lock);
+	return busy;
+}
+
+void ext4_checker_inode_bitmap_end(struct inode *inode, ext4_group_t group,
+				   struct ext4_group_desc *gdp,
+				   struct buffer_head *bh, bool tracked)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(inode->i_sb);
+	bool barrier_locked, verified = false;
+	s64 expected = 0, actual = 0;
+
+	if (!tracked || !checker_event_lock(sbi, &barrier_locked))
+		return;
+	if (group < sbi->s_checker_group_capacity &&
+	    sbi->s_checker_groups[group].inode_updates) {
+		sbi->s_checker_groups[group].inode_updates--;
+		sbi->s_checker_event_seq++;
+		verified = !sbi->s_checker_groups[group].inode_updates && gdp && bh;
+	}
+	spin_unlock(&sbi->s_checker_lock);
+	checker_barrier_read_unlock(sbi, barrier_locked);
+	if (verified) {
+		expected = ext4_count_free(bh->b_data, EXT4_INODES_PER_GROUP(inode->i_sb) / 8);
+		actual = ext4_free_inodes_count(inode->i_sb, gdp);
+	}
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_INODE_BITMAP,
+				 "inode_bitmap_end", actual, expected, actual, verified);
+}
+
+/*
+ * Check a group's inode bitmap after an error path has finished its dirty
+ * metadata work.  This deliberately does not use the begin/end update
+ * token: error exits can finish after the token was consumed, and the useful
+ * question at that point is whether the published bitmap and descriptor are
+ * mutually consistent in the final in-memory state.
+ */
+void ext4_checker_inode_bitmap_check(struct inode *inode, ext4_group_t group,
+				     const char *source, int err,
+				     enum ext4_checker_error_source error_source)
+{
+	struct super_block *sb;
+	struct ext4_group_desc *gdp;
+	struct buffer_head *bh;
+	s64 expected = 0, actual = 0;
+	bool verified = false;
+
+	if (!inode || !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active) ||
+	    EXT4_SB(inode->i_sb)->s_mount_state & EXT4_FC_REPLAY)
+		return;
+	sb = inode->i_sb;
+	gdp = ext4_get_group_desc(sb, group, NULL);
+	bh = ext4_read_inode_bitmap(sb, group);
+	if (!IS_ERR(bh) && gdp) {
+		ext4_lock_group(sb, group);
+		if (!ext4_checker_inode_bitmap_busy(sb, group)) {
+			expected = ext4_count_free(bh->b_data,
+						    EXT4_INODES_PER_GROUP(sb) / 8);
+			actual = ext4_free_inodes_count(sb, gdp);
+			verified = true;
+		}
+		ext4_unlock_group(sb, group);
+	}
+	if (!IS_ERR(bh))
+		brelse(bh);
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_INODE_BITMAP,
+				 source ?: "inode_bitmap_error", actual, expected, actual,
+				 verified);
+	checker_record_error_exit(inode, error_source, err, verified,
+				  expected, actual);
+}
+
+/*
+ * An inode whose last reference is being evicted has completed the delete
+ * transition.  The independent postcondition is that its allocation bit is
+ * clear, even when the normal ext4_free_inode() path was skipped after a
+ * journal/dirty error.
+ */
+void ext4_checker_inode_eviction_error(struct inode *inode, int err)
+{
+	struct super_block *sb;
+	struct buffer_head *bh;
+	ext4_group_t group;
+	unsigned int bit;
+	bool verified = false;
+	s64 actual = 0;
+
+	if (!inode)
+		return;
+	sb = inode->i_sb;
+	if (inode->i_ino < EXT4_FIRST_INO(sb) ||
+	    inode->i_ino > le32_to_cpu(EXT4_SB(sb)->s_es->s_inodes_count))
+		return;
+	group = (inode->i_ino - 1) / EXT4_INODES_PER_GROUP(sb);
+	bit = (inode->i_ino - 1) % EXT4_INODES_PER_GROUP(sb);
+	bh = ext4_read_inode_bitmap(sb, group);
+	if (!IS_ERR(bh)) {
+		ext4_lock_group(sb, group);
+		if (!ext4_checker_inode_bitmap_busy(sb, group)) {
+			actual = ext4_test_bit(bit, bh->b_data) ? 1 : 0;
+			verified = true;
+		}
+		ext4_unlock_group(sb, group);
+		brelse(bh);
+	}
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_INODE_BITMAP,
+				 "inode_eviction_error", 1, 0, actual, verified);
+}
+
+/* Check the slot postcondition on the orphan-file error exits. */
+void ext4_checker_orphan_file_error(struct inode *inode, int block, int offset,
+					    int err)
+{
+	struct ext4_orphan_info *oi;
+	__le32 *entries;
+	s64 actual;
+
+	if (!inode || block < 0 || offset < 0)
+		return;
+	oi = &EXT4_SB(inode->i_sb)->s_orphan_info;
+	if (!oi->of_binfo || block >= oi->of_blocks ||
+	    !oi->of_binfo[block].ob_bh ||
+	    !buffer_uptodate(oi->of_binfo[block].ob_bh)) {
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_ORPHAN_FILE,
+					 "orphan_file_error", 1, 0, 1, false);
+		return;
+	}
+	entries = (__le32 *)oi->of_binfo[block].ob_bh->b_data;
+	actual = READ_ONCE(entries[offset]) != 0;
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_ORPHAN_FILE,
+				 "orphan_file_error", 1, 0, actual, true);
+}
+
+static bool checker_reservation_expected_locked(struct inode *inode, s64 *expected)
+{
+	struct ext4_inode_info *ei = EXT4_I(inode);
+	struct rb_node *node, *pending;
+	u64 clusters = 0, pending_clusters = 0, last = 0;
+	unsigned int work = 0;
+	bool have_delayed = false;
+	struct extent_status *es;
+	struct pending_reservation *pr;
+	struct ext4_sb_info *sbi = EXT4_SB(inode->i_sb);
+
+	if (ei->i_es_all_nr == ei->i_es_shk_nr && !ei->i_pending_tree.root.rb_node) {
+		*expected = 0;
+		return true;
+	}
+	pending = rb_first(&ei->i_pending_tree.root);
+	/* ES and pending trees are ordered; merge cluster intervals in one pass. */
+	for (node = rb_first(&ei->i_es_tree.root); node; node = rb_next(node)) {
+		u64 first, end;
+
+		if (++work > 8192)
+			return false;
+		es = rb_entry(node, struct extent_status, rb_node);
+		if (!ext4_es_is_delayed(es))
+			continue;
+		if (!es->es_len || (u64)es->es_lblk + es->es_len > EXT_MAX_BLOCKS)
+			return false;
+		first = EXT4_B2C(sbi, es->es_lblk);
+		end = EXT4_B2C(sbi, (u64)es->es_lblk + es->es_len - 1);
+		if (!have_delayed || first > last)
+			clusters += end - first + 1;
+		else if (end > last)
+			clusters += end - last;
+		have_delayed = true;
+		last = end;
+		while (pending) {
+			pr = rb_entry(pending, struct pending_reservation, rb_node);
+			if (pr->lclu > end)
+				break;
+			if (pr->lclu < first || ++work > 8192)
+				return false;
+			pending_clusters++;
+			pending = rb_next(pending);
+		}
+	}
+	if (pending || pending_clusters > clusters)
+		return false;
+	*expected = clusters - pending_clusters;
+	return true;
+}
+
+bool ext4_checker_reservation_begin(struct inode *inode)
+{
+	struct ext4_inode_info *ei;
+
+	if (!inode || !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active) ||
+	    EXT4_SB(inode->i_sb)->s_mount_state & EXT4_FC_REPLAY)
+		return false;
+	ei = EXT4_I(inode);
+	write_lock(&ei->i_es_lock);
+	ei->i_checker_reservation_updates++;
+	write_unlock(&ei->i_es_lock);
+	return true;
+}
+
+/* Caller holds i_es_lock, with no reservation publication in progress. */
+static void checker_reservation_locked(struct inode *inode, const char *source)
+{
+	struct ext4_inode_info *ei = EXT4_I(inode);
+	s64 expected = 0, actual;
+	bool verified;
+
+	verified = !ei->i_checker_reservation_updates &&
+		checker_reservation_expected_locked(inode, &expected);
+	spin_lock(&ei->i_block_reservation_lock);
+	actual = ei->i_reserved_data_blocks;
+	spin_unlock(&ei->i_block_reservation_lock);
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_RESERVATION,
+				 source, actual, expected, actual, verified);
+}
+
+void ext4_checker_reservation_error(struct inode *inode, const char *source,
+				    int err)
+{
+	struct ext4_inode_info *ei;
+	s64 expected = 0, actual;
+	bool verified;
+
+	if (!inode || !err ||
+	    !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active))
+		return;
+	ei = EXT4_I(inode);
+	read_lock(&ei->i_es_lock);
+	verified = !ei->i_checker_reservation_updates &&
+		checker_reservation_expected_locked(inode, &expected);
+	spin_lock(&ei->i_block_reservation_lock);
+	actual = ei->i_reserved_data_blocks;
+	spin_unlock(&ei->i_block_reservation_lock);
+	read_unlock(&ei->i_es_lock);
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_RESERVATION,
+				 source ?: "reservation_error", actual, expected,
+				 actual, verified);
+	checker_record_error_exit(inode,
+				  EXT4_CHECKER_ERROR_DELALLOC_RESERVATION,
+				  err, verified, expected, actual);
+}
+
+void ext4_checker_reservation_end(struct inode *inode, bool tracked)
+{
+	struct ext4_inode_info *ei;
+
+	if (!tracked || !inode)
+		return;
+	ei = EXT4_I(inode);
+	write_lock(&ei->i_es_lock);
+	if (ei->i_checker_reservation_updates) {
+		ei->i_checker_reservation_updates--;
+		checker_reservation_locked(inode, "reservation_end");
+	}
+	write_unlock(&ei->i_es_lock);
+}
+
+struct checker_extent_walk {
+	u64 data_blocks;
+	u64 metadata_blocks;
+	u32 work;
+	bool valid;
+};
+
+static void checker_walk_extent_block(struct inode *inode,
+					 struct ext4_extent_header *eh, unsigned int depth,
+					 unsigned int bytes,
+					 struct checker_extent_walk *walk,
+					 u64 *first_lblk, u64 *last_lblk)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(inode->i_sb);
+	struct buffer_head *bh;
+	unsigned int entries, max, i;
+	if (!walk->valid)
+		return;
+	if (depth > EXT4_MAX_EXTENT_DEPTH ||
+	    ++walk->work > EXT4_CHECKER_WALK_MAX ||
+	    eh->eh_magic != EXT4_EXT_MAGIC ||
+	    le16_to_cpu(eh->eh_depth) != depth)
+		goto invalid;
+	entries = le16_to_cpu(eh->eh_entries);
+	max = le16_to_cpu(eh->eh_max);
+	if (!max || entries > max || max > (bytes - sizeof(*eh)) /
+						 sizeof(struct ext4_extent_idx) ||
+	    walk->work + entries > EXT4_CHECKER_WALK_MAX ||
+	    (!entries && depth))
+		goto invalid;
+	walk->work += entries;
+	if (!depth) {
+		struct ext4_extent *ex = EXT_FIRST_EXTENT(eh);
+		u64 previous_end = 0;
+
+		for (i = 0; i < entries; i++) {
+			unsigned int len = ext4_ext_get_actual_len(&ex[i]);
+			ext4_fsblk_t pblk = ext4_ext_pblock(&ex[i]);
+			u64 lblk = le32_to_cpu(ex[i].ee_block);
+
+			if (!len || pblk <= le32_to_cpu(sbi->s_es->s_first_data_block) ||
+			    pblk + len > ext4_blocks_count(sbi->s_es) ||
+			    lblk + len > EXT_MAX_BLOCKS || (i && lblk < previous_end))
+				goto invalid;
+			if (!i)
+				*first_lblk = lblk;
+			previous_end = lblk + len;
+			*last_lblk = previous_end;
+			walk->data_blocks += len;
+		}
+		return;
+	}
+	{
+		u64 previous_index = 0;
+		u64 previous_child_last = 0;
+		bool have_index = false;
+		for (i = 0; i < entries; i++) {
+			struct ext4_extent_idx *ix = EXT_FIRST_INDEX(eh) + i;
+			u64 index_lblk = le32_to_cpu(ix->ei_block);
+			u64 child_first = 0, child_last = 0;
+			ext4_fsblk_t pblk = ext4_idx_pblock(ix);
+
+			if (have_index && index_lblk <= previous_index)
+				goto invalid;
+			if (!pblk || pblk >= ext4_blocks_count(sbi->s_es))
+				goto invalid;
+			previous_index = index_lblk;
+			have_index = true;
+			bh = ext4_sb_bread(inode->i_sb, pblk, REQ_PRIO);
+			if (IS_ERR(bh))
+				goto invalid;
+			walk->metadata_blocks++;
+			checker_walk_extent_block(inode, ext_block_hdr(bh), depth - 1,
+						 inode->i_sb->s_blocksize, walk,
+						 &child_first, &child_last);
+			if (walk->valid && (child_first != index_lblk ||
+				    (i && child_first < previous_child_last)))
+				walk->valid = false;
+			brelse(bh);
+			if (!walk->valid)
+				return;
+			if (!i)
+				*first_lblk = child_first;
+			*last_lblk = child_last;
+			previous_child_last = child_last;
+		}
+	}
+	return;
+invalid:
+	walk->valid = false;
+}
+
+/* Walk legacy direct/indirect pointers so block accounting checks cover
+ * regular files whose EXT4_EXTENTS_FL bit has been cleared.  The walk is
+ * bounded because this is diagnostic code running on a syscall path.
+ */
+static void checker_walk_indirect_block(struct inode *inode,
+					ext4_fsblk_t block,
+					unsigned int level,
+					struct checker_extent_walk *walk)
+{
+	struct buffer_head *bh;
+	__le32 *p;
+	unsigned int i, count = EXT4_ADDR_PER_BLOCK(inode->i_sb);
+
+	if (!walk->valid)
+		return;
+	if (!block)
+		return;
+	if (!level || level > 3 || ++walk->work > EXT4_CHECKER_WALK_MAX ||
+	    ext4_inode_block_valid(inode, block, 1) != 1)
+		goto invalid;
+	bh = ext4_sb_bread(inode->i_sb, block, REQ_PRIO);
+	if (IS_ERR(bh))
+		goto invalid;
+	walk->metadata_blocks++;
+	p = (__le32 *)bh->b_data;
+	for (i = 0; i < count; i++) {
+		ext4_fsblk_t child = le32_to_cpu(p[i]);
+
+		if (!child)
+			continue;
+		if (++walk->work > EXT4_CHECKER_WALK_MAX ||
+		    ext4_inode_block_valid(inode, child, 1) != 1) {
+			walk->valid = false;
+			break;
+		}
+		if (level == 1)
+			walk->data_blocks++;
+		else
+			checker_walk_indirect_block(inode, child, level - 1,
+						    walk);
+		if (!walk->valid)
+			break;
+	}
+	brelse(bh);
+	return;
+invalid:
+	walk->valid = false;
+}
+
+static void checker_walk_indirect_inode(struct inode *inode,
+					struct checker_extent_walk *walk)
+{
+	__le32 *i_data = (__le32 *)EXT4_I(inode)->i_data;
+	unsigned int i;
+
+	for (i = 0; i < EXT4_NDIR_BLOCKS; i++) {
+		ext4_fsblk_t block = le32_to_cpu(i_data[i]);
+
+		if (!block)
+			continue;
+		if (++walk->work > EXT4_CHECKER_WALK_MAX ||
+		    ext4_inode_block_valid(inode, block, 1) != 1) {
+			walk->valid = false;
+			return;
+		}
+		walk->data_blocks++;
+	}
+	checker_walk_indirect_block(inode,
+				    le32_to_cpu(i_data[EXT4_IND_BLOCK]), 1, walk);
+	checker_walk_indirect_block(inode,
+				    le32_to_cpu(i_data[EXT4_DIND_BLOCK]), 2, walk);
+	checker_walk_indirect_block(inode,
+				    le32_to_cpu(i_data[EXT4_TIND_BLOCK]), 3, walk);
+}
+
+static bool checker_extent_blocks_check(struct inode *inode,
+					const char *source,
+					s64 *expected_out,
+					s64 *actual_out)
+{
+	struct checker_extent_walk walk = { .valid = true };
+	struct ext4_extent_header *eh;
+	u64 blocks, sectors;
+	s64 actual;
+
+	*expected_out = 0;
+	*actual_out = 0;
+	if (!inode || !READ_ONCE(EXT4_SB(inode->i_sb)->s_checker_active) ||
+	    EXT4_SB(inode->i_sb)->s_mount_state & EXT4_FC_REPLAY)
+		return false;
+	if (EXT4_SB(inode->i_sb)->s_cluster_ratio != 1 ||
+	    ext4_has_feature_ea_inode(inode->i_sb) ||
+	    (!S_ISREG(inode->i_mode) && !S_ISDIR(inode->i_mode)) ||
+	    ext4_test_inode_flag(inode, EXT4_INODE_EA_INODE) ||
+	    ext4_has_inline_data(inode)) {
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_EXTENT_BLOCKS,
+					source, 0, 0, 0, false);
+		return false;
+	}
+	/* xattr conversion can take data_sem under xattr_sem; never wait here. */
+	if (!down_read_trylock(&EXT4_I(inode)->xattr_sem))
+		goto unverified;
+	if (ext4_test_inode_flag(inode, EXT4_INODE_EXTENTS)) {
+		eh = ext_inode_hdr(inode);
+		checker_walk_extent_block(inode, eh, le16_to_cpu(eh->eh_depth),
+					 sizeof(EXT4_I(inode)->i_data), &walk,
+					 &(u64){ 0 }, &(u64){ 0 });
+	} else {
+		checker_walk_indirect_inode(inode, &walk);
+	}
+	if (!walk.valid)
+		goto unlock_unverified;
+	blocks = walk.data_blocks + walk.metadata_blocks +
+			(EXT4_I(inode)->i_file_acl ? 1 : 0);
+	if (blocks > div_u64(S64_MAX, inode->i_sb->s_blocksize / 512))
+		goto unlock_unverified;
+	sectors = blocks * (inode->i_sb->s_blocksize / 512);
+	spin_lock(&inode->i_lock);
+	actual = inode->i_blocks;
+	spin_unlock(&inode->i_lock);
+	up_read(&EXT4_I(inode)->xattr_sem);
+	*expected_out = sectors;
+	*actual_out = actual;
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_EXTENT_BLOCKS,
+				source, actual, sectors, actual, true);
+	return true;
+unlock_unverified:
+	up_read(&EXT4_I(inode)->xattr_sem);
+unverified:
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_EXTENT_BLOCKS,
+				source, 0, 0, 0, false);
+	return false;
+}
+
+void ext4_checker_extent_blocks(struct inode *inode)
+{
+	s64 expected, actual;
+
+	checker_extent_blocks_check(inode, "extent_blocks", &expected, &actual);
+}
+
+void ext4_checker_extent_blocks_error(struct inode *inode, int err)
+{
+	s64 expected, actual;
+	bool verified;
+
+	verified = checker_extent_blocks_check(inode, "extent_blocks_error",
+					       &expected, &actual);
+	checker_record_error_exit(inode, EXT4_CHECKER_ERROR_EXTENT_MAP,
+				  err, verified, expected, actual);
+}
+
+void ext4_checker_indirect_truncate(struct inode *inode)
+{
+	s64 expected, actual;
+
+	if (ext4_test_inode_flag(inode, EXT4_INODE_EXTENTS))
