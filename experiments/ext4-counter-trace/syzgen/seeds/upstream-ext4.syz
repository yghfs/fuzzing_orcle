# syz_mount_image returns a directory fd backed by an embedded ext4 image.
# This keeps the upstream seed inside the target filesystem even when the
# executor's ordinary working directory is a temporary filesystem.
r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./file0\x00', 0x0, &AUTO, 0x1, AUTO, &AUTO="$")
r1 = openat(r0, &(0x7f0000000100)='counter-trace-seed\x00', 0x242, 0x1a4)
write(r1, &(0x7f0000000140)='counter-trace\x00', 0xe)
fallocate(r1, 0x0, 0x0, 0x2000)
ftruncate(r1, 0x1000)
fsync(r1)
renameat2(r0, &(0x7f0000000180)='counter-trace-seed\x00', r0, &(0x7f00000001c0)='counter-trace-renamed\x00', 0x0)
unlinkat(r0, &(0x7f0000000200)='counter-trace-renamed\x00', 0x0)
close(r1)
close(r0)
