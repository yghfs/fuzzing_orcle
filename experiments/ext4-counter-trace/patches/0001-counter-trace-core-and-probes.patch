+		[EXT4_FAULT_XATTR_SET_INODE_DIRTY] = "xattr_set_inode_dirty",
+		[EXT4_FAULT_EA_INODE_REF_DIRTY] = "ea_inode_ref_dirty",
+		[EXT4_FAULT_ACL_MODE_DIRTY] = "acl_mode_dirty",
+		[EXT4_FAULT_INLINE_DIR_BLOCK_DIRTY] = "inline_dir_block_dirty",
+		[EXT4_FAULT_INLINE_DIR_INODE_DIRTY] = "inline_dir_inode_dirty",
+		[EXT4_FAULT_INLINE_DATA_BLOCK_WRITE_BEGIN] = "inline_data_block_write_begin",
+		[EXT4_FAULT_FILEATTR_FLAGS_DIRTY] = "fileattr_flags_dirty",
+		[EXT4_FAULT_FILEATTR_PROJECT_DIRTY] = "fileattr_project_dirty",
+		[EXT4_FAULT_ES_INSERT_ALLOC] = "es_insert_alloc",
+		[EXT4_FAULT_DELALLOC_RESERVE] = "delalloc_reserve",
+		[EXT4_FAULT_EXTENT_INSERT_DIRTY] = "extent_insert_dirty",
+		[EXT4_FAULT_MB_BUDDY_LOAD] = "mb_buddy_load",
+	};
+	int i;
+
+	for (i = EXT4_FAULT_MBALLOC_MARK; i < EXT4_FAULT_OPERATION_MAX; i++) {
+		if (!strcmp(name, names[i])) {
+			*op = i;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+static int ext4_fault_errno_list_parse(char *list, int *errors,
+					      u8 *error_count);
+
+struct ext4_fault_random_policy {
+	int errors[EXT4_FAULT_OPERATION_MAX][EXT4_FAULT_ERRNO_MAX];
+	u8 error_count[EXT4_FAULT_OPERATION_MAX];
+	bool errno_native[EXT4_FAULT_OPERATION_MAX];
+};
+
+static int ext4_fault_errno_policy_parse(
+			char *value, const unsigned long *operations,
+		int errors[EXT4_FAULT_OPERATION_MAX][EXT4_FAULT_ERRNO_MAX],
+		u8 error_count[EXT4_FAULT_OPERATION_MAX],
+		bool native[EXT4_FAULT_OPERATION_MAX])
+{
+	char *entry, *list;
+	bool per_operation = strchr(value, '=') != NULL;
+	int i, ret;
+
+	if (!per_operation) {
+		int common[EXT4_FAULT_ERRNO_MAX];
+		u8 common_count = 0;
+
+		if (!strcmp(value, "native")) {
+			for (i = EXT4_FAULT_MBALLOC_MARK;
+			     i < EXT4_FAULT_OPERATION_MAX; i++)
+					if (test_bit(i, operations))
+					native[i] = true;
+			return 0;
+		}
+		ret = ext4_fault_errno_list_parse(value, common, &common_count);
+		if (ret)
+			return ret;
+		for (i = EXT4_FAULT_MBALLOC_MARK;
+		     i < EXT4_FAULT_OPERATION_MAX; i++) {
+				if (!test_bit(i, operations))
+				continue;
+			memcpy(errors[i], common, sizeof(common));
+			error_count[i] = common_count;
+		}
+		return 0;
+	}
+
+	/* Per-hook form: operation=EIO,ENOSPC;other=native. */
+	while ((entry = strsep(&value, ";")) != NULL) {
+		enum ext4_fault_operation operation;
+		char *equals;
+
+		if (!*entry)
+			return -EINVAL;
+		equals = strchr(entry, '=');
+		if (!equals)
+			return -EINVAL;
+		*equals++ = '\0';
+		if (!*entry || !*equals ||
+		    ext4_fault_operation_parse(entry, &operation) ||
+			    !test_bit(operation, operations) ||
+		    error_count[operation] || native[operation])
+			return -EINVAL;
+		if (!strcmp(equals, "native")) {
+			native[operation] = true;
+			continue;
+		}
+		list = equals;
+		ret = ext4_fault_errno_list_parse(list, errors[operation],
+						  &error_count[operation]);
+		if (ret)
+			return ret;
+	}
+	for (i = EXT4_FAULT_MBALLOC_MARK; i < EXT4_FAULT_OPERATION_MAX; i++)
+		if (test_bit(i, operations) && !error_count[i] && !native[i])
+			return -EINVAL;
+	return 0;
+}
+
+static int ext4_fault_parse_random_config(char *input, u64 *seed,
+					 u32 *probability_ppm, u32 *max_hits,
+					 unsigned long *operations,
+					 pid_t *target_pid, pid_t *target_pgid,
+					 int errors[EXT4_FAULT_OPERATION_MAX][EXT4_FAULT_ERRNO_MAX],
+					 u8 error_count[EXT4_FAULT_OPERATION_MAX],
+					 bool errno_native[EXT4_FAULT_OPERATION_MAX])
+{
+	char *token, *value, *key, *list, *name;
+	bool have_seed = false, have_probability = false;
+	bool have_max_hits = false, have_operations = false;
+	bool have_pid = false, have_pgid = false;
+	bool have_errnos = false;
+	u32 parsed_u32;
+	int ret, i, j;
+
+	while ((token = strsep(&input, " \t\n")) != NULL) {
+		if (!*token)
+			continue;
+		key = token;
+		value = strchr(token, '=');
+		if (!value)
+			return -EINVAL;
+		*value++ = '\0';
+		if (!strcmp(key, "mode")) {
+			if (strcmp(value, "random"))
+				return -EINVAL;
+		} else if (!strcmp(key, "seed")) {
+			ret = kstrtou64(value, 0, seed);
+			if (ret || !*seed)
+				return -EINVAL;
+			have_seed = true;
+		} else if (!strcmp(key, "probability_ppm")) {
+			ret = kstrtou32(value, 0, &parsed_u32);
+			if (ret || !parsed_u32 || parsed_u32 > 1000000)
+				return -EINVAL;
+			*probability_ppm = parsed_u32;
+			have_probability = true;
+		} else if (!strcmp(key, "max_hits")) {
+			ret = kstrtou32(value, 0, &parsed_u32);
+			if (ret || !parsed_u32 || parsed_u32 > 1024)
+				return -EINVAL;
+			*max_hits = parsed_u32;
+			have_max_hits = true;
+		} else if (!strcmp(key, "pid")) {
+			int parsed_pid;
+
+			ret = kstrtoint(value, 0, &parsed_pid);
+			if (ret || parsed_pid < 0)
+				return -EINVAL;
+			*target_pid = parsed_pid;
+			have_pid = true;
+		} else if (!strcmp(key, "pgid")) {
+			int parsed_pgid;
+
+			ret = kstrtoint(value, 0, &parsed_pgid);
+			if (ret || parsed_pgid <= 0)
+				return -EINVAL;
+			*target_pgid = parsed_pgid;
+			have_pgid = true;
+		} else if (!strcmp(key, "operations")) {
+			list = value;
+			while ((name = strsep(&list, ",")) != NULL) {
+				enum ext4_fault_operation operation;
+
+				if (!*name || ext4_fault_operation_parse(name,
+									 &operation))
+					return -EINVAL;
+				__set_bit(operation, operations);
+			}
+			have_operations = !bitmap_empty(operations,
+							EXT4_FAULT_OPERATION_MAX);
+		} else if (!strcmp(key, "errnos")) {
+			if (have_errnos)
+				return -EINVAL;
+			have_errnos = true;
+			ret = ext4_fault_errno_policy_parse(value, operations, errors,
+						     error_count, errno_native);
+			if (ret)
+				return ret;
+		} else {
+			return -EINVAL;
+		}
+	}
+	if (!have_seed || !have_probability || !have_max_hits ||
+	    !have_operations || (!have_pid && !have_pgid))
+		return -EINVAL;
+	if (!have_pid)
+		*target_pid = 0;
+	if (!have_pgid)
+		*target_pgid = 0;
+	if (!have_errnos) {
+		for (i = EXT4_FAULT_MBALLOC_MARK;
+		     i < EXT4_FAULT_OPERATION_MAX; i++)
+			if (test_bit(i, operations))
+				errno_native[i] = true;
+	}
+	for (i = EXT4_FAULT_MBALLOC_MARK;
+	     i < EXT4_FAULT_OPERATION_MAX; i++) {
+		if (!test_bit(i, operations) || errno_native[i])
+			continue;
+		for (j = 0; j < error_count[i]; j++)
+			if (!ext4_fault_errno_supported(i, errors[i][j]))
+				return -EINVAL;
+	}
+	return 0;
+}
+
+static u64 ext4_fault_random_draw(struct ext4_fault_state *state)
+{
+	u64 value = state->random_state;
+
+	/* xorshift64*; the configured seed and each checked hook fully determine it. */
+	value ^= value >> 12;
+	value ^= value << 25;
+	value ^= value >> 27;
+	state->random_state = value;
+	return (value * 2685821657736338717ULL) % 1000000;
+}
+
+static int ext4_fault_errno_parse(const char *value, int *error)
+{
+	char *end;
+	long parsed;
+	int named = ext4_fault_errno_from_name(value);
+
+	if (named) {
+		*error = named;
+		return 0;
+	}
+	parsed = simple_strtol(value, &end, 0);
+	if (*value == '\0' || *end != '\0' || parsed >= 0 || parsed < -MAX_ERRNO)
+		return -EINVAL;
+	*error = parsed;
+	return 0;
+}
+
+static int ext4_fault_errno_list_parse(char *list, int *errors,
+					      u8 *error_count)
+{
+	char *name;
+	unsigned int i;
+	int error, ret;
+
+	*error_count = 0;
+	while ((name = strsep(&list, ",")) != NULL) {
+		if (!*name || *error_count >= EXT4_FAULT_ERRNO_MAX)
+			return -EINVAL;
+		ret = ext4_fault_errno_parse(name, &error);
+		if (ret)
+			return ret;
+		for (i = 0; i < *error_count; i++)
+			if (errors[i] == error)
+				return -EINVAL;
+		errors[(*error_count)++] = error;
+	}
+	return *error_count ? 0 : -EINVAL;
+}
+
+void ext4_fault_init(struct super_block *sb)
+{
+	struct ext4_fault_state *state = &EXT4_SB(sb)->s_fault;
+
+	spin_lock_init(&state->lock);
+	state->operation = EXT4_FAULT_OFF;
+	state->error = -EIO;
+	state->errors[0] = -EIO;
+	state->error_count = 1;
+	state->last_errno_choice = 0;
+	state->generation = 1;
+	state->target_pgid = 0;
+	state->mount_prearmed = false;
+	state->random_active = false;
+	state->random_errno_native = false;
+	memset(state->random_errno_native_by_operation, 0,
+	       sizeof(state->random_errno_native_by_operation));
+	memset(state->random_error_count_by_operation, 0,
+	       sizeof(state->random_error_count_by_operation));
+	memset(state->random_errors_by_operation, 0,
+	       sizeof(state->random_errors_by_operation));
+	state->last_random_operation = EXT4_FAULT_OFF;
+	strscpy(state->program, "-", sizeof(state->program));
+}
+
+void ext4_fault_reset(struct super_block *sb)
+{
+	struct ext4_fault_state *state = &EXT4_SB(sb)->s_fault;
+	unsigned long flags;
+
+	spin_lock_irqsave(&state->lock, flags);
+	state->operation = EXT4_FAULT_OFF;
+	state->error = -EIO;
+	memset(state->errors, 0, sizeof(state->errors));
+	state->error_count = 0;
+	state->last_errno_choice = 0;
+	state->remaining = 0;
+	state->matches = 0;
+	state->target_pid = 0;
+	state->target_pgid = 0;
+	state->call_index = 0;
+	state->mount_prearmed = false;
+	state->random_active = false;
+	state->random_errno_native = false;
+	memset(state->random_errno_native_by_operation, 0,
+	       sizeof(state->random_errno_native_by_operation));
+	memset(state->random_error_count_by_operation, 0,
+	       sizeof(state->random_error_count_by_operation));
+	memset(state->random_errors_by_operation, 0,
+	       sizeof(state->random_errors_by_operation));
+	state->last_random_operation = EXT4_FAULT_OFF;
+	bitmap_zero(state->random_operations, EXT4_FAULT_OPERATION_MAX);
+	state->random_seed = 0;
+	state->random_state = 0;
+	state->random_probability_ppm = 0;
+	state->random_max_hits = 0;
+	state->program[0] = '-';
+	state->program[1] = '\0';
+	state->generation++;
+	spin_unlock_irqrestore(&state->lock, flags);
+}
+
+ssize_t ext4_fault_show(struct super_block *sb, char *buf)
+{
+	struct ext4_fault_state *state = &EXT4_SB(sb)->s_fault;
+	enum ext4_fault_operation operation;
+	int error;
+	u32 remaining, injected, generation;
+	pid_t target_pid, target_pgid;
+	u64 call_index, matches;
+	bool mount_prearmed, random_active;
+	bool random_errno_native;
+	enum ext4_fault_operation errno_operation;
+	DECLARE_BITMAP(random_operations, EXT4_FAULT_OPERATION_MAX);
+	char *random_operation_names;
+	size_t random_operation_names_size = EXT4_FAULT_OPERATION_MAX * 48;
+	int random_operation_names_len = 0;
+	u64 random_seed;
+	u32 random_probability_ppm, random_max_hits;
+	int errors[EXT4_FAULT_ERRNO_MAX];
+	u8 error_count, errno_choice;
+	char errno_choices[EXT4_FAULT_ERRNO_MAX * 12];
+	int errno_choices_len = 0;
+	unsigned int i;
+	char program[EXT4_FAULT_PROGRAM_MAX];
+	unsigned long flags;
+	ssize_t ret;
+
+	random_operation_names = kmalloc(random_operation_names_size, GFP_KERNEL);
+	if (!random_operation_names)
+		return -ENOMEM;
+
+	spin_lock_irqsave(&state->lock, flags);
+	operation = state->operation;
+	error = state->error;
+	remaining = state->remaining;
+	injected = state->injected;
+	generation = state->generation;
+	target_pid = state->target_pid;
+	target_pgid = state->target_pgid;
+	call_index = state->call_index;
+	matches = state->matches;
+	mount_prearmed = state->mount_prearmed;
+	random_active = state->random_active;
+	errno_operation = random_active ? state->last_random_operation : operation;
+	random_errno_native = state->random_errno_native;
+	bitmap_copy(random_operations, state->random_operations,
+		    EXT4_FAULT_OPERATION_MAX);
+	random_seed = state->random_seed;
+	random_probability_ppm = state->random_probability_ppm;
+	random_max_hits = state->random_max_hits;
+	if (random_active && errno_operation > EXT4_FAULT_OFF &&
+	    errno_operation < EXT4_FAULT_OPERATION_MAX) {
+		random_errno_native = state->random_errno_native_by_operation[
+			errno_operation];
+		error_count = state->random_error_count_by_operation[errno_operation];
+		memcpy(errors, state->random_errors_by_operation[errno_operation],
+		       sizeof(errors));
+	} else {
+		error_count = state->error_count;
+		memcpy(errors, state->errors, sizeof(errors));
+	}
+	errno_choice = state->last_errno_choice;
+	strscpy(program, state->program, sizeof(program));
+	spin_unlock_irqrestore(&state->lock, flags);
+	random_operation_names[0] = '\0';
+	for (i = EXT4_FAULT_MBALLOC_MARK;
+	     i < EXT4_FAULT_OPERATION_MAX; i++) {
+		if (!test_bit(i, random_operations))
+			continue;
+		random_operation_names_len += scnprintf(
+			random_operation_names + random_operation_names_len,
+			random_operation_names_size - random_operation_names_len,
+			"%s%s", random_operation_names_len ? "," : "",
+			ext4_fault_operation_name(i));
+	}
+	if (random_errno_native) {
+		strscpy(errno_choices, "native", sizeof(errno_choices));
+	} else {
+		for (i = 0; i < error_count; i++)
+			errno_choices_len += scnprintf(errno_choices + errno_choices_len,
+						      sizeof(errno_choices) - errno_choices_len,
+						      "%s%d", i ? "," : "", errors[i]);
+		if (!error_count)
+			errno_choices[0] = '\0';
+	}
+
+	ret = sysfs_emit(buf,
+		"{\"enabled\":%s,\"mode\":\"%s\",\"operation\":\"%s\",\"errno\":%d,"
+		"\"errno_operation\":\"%s\",\"errno_choices\":\"%s\",\"errno_choice_index\":%u,"
+		"\"remaining\":%u,\"injected\":%u,\"generation\":%u,"
+		"\"target_pid\":%d,\"target_pgid\":%d,\"program\":\"%s\",\"call_index\":%llu,"
+		"\"matches\":%llu,\"mount_prearmed\":%s,\"random_seed\":%llu,"
+			"\"probability_ppm\":%u,\"max_hits\":%u,"
+			"\"random_operations\":\"%s\"}\n",
+		(operation != EXT4_FAULT_OFF || random_active) ? "true" : "false",
+		random_active ? "random" : "targeted",
+		random_active ? "random" : ext4_fault_operation_name(operation),
+		error, ext4_fault_operation_name(errno_operation), errno_choices,
+		errno_choice, remaining, injected,
+		generation, target_pid, target_pgid, program, call_index, matches,
+		mount_prearmed ? "true" : "false", random_seed,
+			 random_probability_ppm, random_max_hits, random_operation_names);
+	kfree(random_operation_names);
+	return ret;
+}
+
+/*
+ * Mount-time replay happens before the per-mount sysfs file exists.  This
+ * interface is intentionally narrower than ext4_fault_store(): it accepts
+ * one fast-commit replay hook, -EIO, count=1, and explicit task/call filters.
+ * Grammar: operation:-EIO:1:pid:comm:call_index
+ */
+int ext4_fault_prearm_fast_commit(struct super_block *sb, const char *config)
+{
+	struct ext4_fault_state *state = &EXT4_SB(sb)->s_fault;
+	char *input, *cursor, *field[6];
+	enum ext4_fault_operation operation;
+	unsigned long flags;
+	u64 call_index;
+	int pid, ret, i;
+
+	if (!config || !*config || strlen(config) > 127)
+		return -EINVAL;
+	input = kstrdup(config, GFP_KERNEL);
+	if (!input)
+		return -ENOMEM;
+	cursor = input;
+	for (i = 0; i < ARRAY_SIZE(field); i++) {
+		field[i] = strsep(&cursor, ":");
+		if (!field[i] || !*field[i]) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	if (cursor) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = ext4_fault_operation_parse(field[0], &operation);
+	if (ret)
+		goto out;
+	if (operation != EXT4_FAULT_FAST_COMMIT_INODE_CLAIM ||
+	    strcmp(field[1], "-EIO") || strcmp(field[2], "1")) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = kstrtoint(field[3], 0, &pid);
+	if (ret || pid < 0) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (!pid || strlen(field[4]) >= TASK_COMM_LEN ||
+	    !strcmp(field[4], "-")) {
+		ret = -EINVAL;
+		goto out;
+	}
+	for (i = 0; field[4][i]; i++) {
+		if (!isalnum(field[4][i]) && field[4][i] != '_' &&
+		    field[4][i] != '-' && field[4][i] != '.') {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	ret = kstrtou64(field[5], 0, &call_index);
+	if (ret || call_index > 1000000) {
+		ret = -EINVAL;
+		goto out;
+	}
+	spin_lock_irqsave(&state->lock, flags);
+	if (state->operation != EXT4_FAULT_OFF) {
+		spin_unlock_irqrestore(&state->lock, flags);
+		ret = -EBUSY;
+		goto out;
+	}
+	state->operation = operation;
+	state->error = -EIO;
+	state->errors[0] = -EIO;
+	state->error_count = 1;
+	state->last_errno_choice = 0;
+	state->remaining = 1;
+	state->injected = 0;
+	state->matches = 0;
+	state->target_pid = pid;
+	state->target_pgid = 0;
+	state->call_index = call_index;
+	state->mount_prearmed = true;
+	strscpy(state->program, field[4], sizeof(state->program));
+	state->generation++;
+	{
+		u32 generation = state->generation;
+		pid_t mount_pid = task_tgid_nr(current);
+		char mount_comm[TASK_COMM_LEN];
+
+		strscpy(mount_comm, field[4], sizeof(mount_comm));
+		spin_unlock_irqrestore(&state->lock, flags);
+		get_task_comm(mount_comm, current);
+		trace_ext4_fault_prearm(sb, ext4_fault_operation_name(operation),
+					-EIO, generation, 1, mount_pid, pid,
+					mount_comm, field[4], call_index);
+		ret = 0;
+		goto out;
+	}
+out:
+	kfree(input);
+	return ret;
+}
+
+static int ext4_fault_parse_config(char *input,
+				   enum ext4_fault_operation *operation,
+				   int *error, u32 *count, pid_t *target_pid,
+				   char *program, size_t program_size, u64 *call_index)
+{
+	char *token, *value, *key;
+	bool have_operation = false, have_error = false, have_count = false;
+	u64 parsed_u64;
+	u32 parsed_count;
+	int ret;
+
+	while ((token = strsep(&input, " \t\n")) != NULL) {
+		if (!*token)
+			continue;
+		key = token;
+		value = strchr(token, '=');
+		if (!value)
+			return -EINVAL;
+		*value++ = '\0';
+		if (!strcmp(key, "op") || !strcmp(key, "operation")) {
+			ret = ext4_fault_operation_parse(value, operation);
+			if (ret)
+				return ret;
+			have_operation = true;
+		} else if (!strcmp(key, "errno")) {
+			ret = ext4_fault_errno_parse(value, error);
+			if (ret)
+				return ret;
+			have_error = true;
+		} else if (!strcmp(key, "count")) {
+			ret = kstrtou32(value, 0, &parsed_count);
+			if (ret || !parsed_count)
+				return -EINVAL;
+			*count = parsed_count;
+			have_count = true;
+		} else if (!strcmp(key, "pid")) {
+			int parsed_pid;
+
+			ret = kstrtoint(value, 0, &parsed_pid);
+			if (ret || parsed_pid < 0)
+				return -EINVAL;
+			*target_pid = parsed_pid;
+		} else if (!strcmp(key, "program")) {
+			if (!*value || strlen(value) >= TASK_COMM_LEN ||
+			    strscpy(program, value, program_size) < 0)
+				return -EINVAL;
+		} else if (!strcmp(key, "call") || !strcmp(key, "call_index")) {
+			ret = kstrtou64(value, 0, &parsed_u64);
+			if (ret)
+				return ret;
+			*call_index = parsed_u64;
+		} else {
+			return -EINVAL;
+		}
+	}
+	if (!have_operation || !have_error || !have_count ||
+	    *operation == EXT4_FAULT_OFF)
+		return -EINVAL;
+	return 0;
+}
+
+ssize_t ext4_fault_store(struct super_block *sb, const char *buf, size_t len)
+{
+	struct ext4_fault_state *state = &EXT4_SB(sb)->s_fault;
+	char *input;
+	enum ext4_fault_operation operation;
+	int error, ret;
+	u32 count;
+	pid_t target_pid = 0;
+	u64 call_index = 0;
+	char program[EXT4_FAULT_PROGRAM_MAX] = "-";
+	unsigned long flags;
+	bool random_mode;
+	u64 random_seed = 0;
+	DECLARE_BITMAP(random_operations, EXT4_FAULT_OPERATION_MAX);
+	u32 random_probability_ppm = 0, random_max_hits = 0;
+	pid_t random_target_pid = 0;
+	pid_t random_target_pgid = 0;
+	struct ext4_fault_random_policy *random_policy;
+	int first_random_operation;
+
+	bitmap_zero(random_operations, EXT4_FAULT_OPERATION_MAX);
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!len || len > PAGE_SIZE)
+		return -EINVAL;
+	input = kmemdup_nul(buf, len, GFP_KERNEL);
+	if (!input)
+		return -ENOMEM;
+	if (sysfs_streq(input, "off")) {
+		ext4_fault_reset(sb);
+		kfree(input);
+		return len;
+	}
+	random_mode = !strncmp(input, "mode=random", strlen("mode=random"));
+	if (random_mode) {
+		random_policy = kzalloc(sizeof(*random_policy), GFP_KERNEL);
+		if (!random_policy) {
+			kfree(input);
+			return -ENOMEM;
+		}
+		ret = ext4_fault_parse_random_config(input, &random_seed,
+						     &random_probability_ppm,
+						     &random_max_hits,
+						     random_operations,
+						     &random_target_pid,
+					     &random_target_pgid,
+					     random_policy->errors,
+					     random_policy->error_count,
+					     random_policy->errno_native);
+		kfree(input);
+		if (ret) {
+			kfree(random_policy);
+			return ret;
+		}
+		spin_lock_irqsave(&state->lock, flags);
+		if (state->operation != EXT4_FAULT_OFF || state->random_active) {
+			spin_unlock_irqrestore(&state->lock, flags);
+			kfree(random_policy);
+			return -EBUSY;
+		}
+		for (first_random_operation = EXT4_FAULT_MBALLOC_MARK;
+		     first_random_operation < EXT4_FAULT_OPERATION_MAX;
+		     first_random_operation++)
+				if (test_bit(first_random_operation, random_operations))
+				break;
+		state->error = 0;
+		memset(state->errors, 0, sizeof(state->errors));
+		state->error_count = 0;
+		memset(state->random_errno_native_by_operation, 0,
+		       sizeof(state->random_errno_native_by_operation));
+		memcpy(state->random_errno_native_by_operation,
+		       random_policy->errno_native,
+		       sizeof(random_policy->errno_native));
+		memset(state->random_error_count_by_operation, 0,
+		       sizeof(state->random_error_count_by_operation));
+		memcpy(state->random_error_count_by_operation,
+		       random_policy->error_count,
+		       sizeof(random_policy->error_count));
+		memset(state->random_errors_by_operation, 0,
+		       sizeof(state->random_errors_by_operation));
+		memcpy(state->random_errors_by_operation, random_policy->errors,
+		       sizeof(random_policy->errors));
+		state->last_errno_choice = 0;
+		state->remaining = 0;
+		state->injected = 0;
+		state->matches = 0;
+		state->target_pid = random_target_pid;
+		state->target_pgid = random_target_pgid;
+		state->call_index = 0;
+		state->mount_prearmed = false;
+		state->random_active = true;
+		state->random_errno_native = false;
+		state->last_random_operation = first_random_operation <
+			EXT4_FAULT_OPERATION_MAX ? first_random_operation : EXT4_FAULT_OFF;
+			bitmap_copy(state->random_operations, random_operations,
+				    EXT4_FAULT_OPERATION_MAX);
+		state->random_seed = random_seed;
+		state->random_state = random_seed;
+		state->random_probability_ppm = random_probability_ppm;
+		state->random_max_hits = random_max_hits;
+		strscpy(state->program, "-", sizeof(state->program));
+		state->generation++;
+		spin_unlock_irqrestore(&state->lock, flags);
+		kfree(random_policy);
+		return len;
+	}
+
+	error = -EIO;
+	count = 0;
+	ret = ext4_fault_parse_config(input, &operation, &error, &count,
+				      &target_pid, program, sizeof(program), &call_index);
+	kfree(input);
+	if (ret)
+		return ret;
+	if (!ext4_fault_errno_supported(operation, error))
+		return -EINVAL;
+
+	spin_lock_irqsave(&state->lock, flags);
+	if (state->operation != EXT4_FAULT_OFF) {
+		spin_unlock_irqrestore(&state->lock, flags);
+		return -EBUSY;
+	}
+	state->operation = operation;
+	state->error = error;
+	state->errors[0] = error;
+	memset(&state->errors[1], 0,
+	       sizeof(state->errors) - sizeof(state->errors[0]));
+	state->error_count = 1;
+	state->last_errno_choice = 0;
+	state->remaining = count;
+	state->injected = 0;
+	state->matches = 0;
+	state->target_pid = target_pid;
+	state->target_pgid = 0;
+	state->call_index = call_index;
+	state->random_active = false;
+	state->random_errno_native = false;
+	bitmap_zero(state->random_operations, EXT4_FAULT_OPERATION_MAX);
+	state->random_seed = 0;
+	state->random_state = 0;
+	state->random_probability_ppm = 0;
+	state->random_max_hits = 0;
+	strscpy(state->program, program, sizeof(state->program));
+	state->generation++;
+	state->mount_prearmed = false;
+	spin_unlock_irqrestore(&state->lock, flags);
+	return len;
+}
+
+int ext4_fault_maybe_inject(struct super_block *sb,
+				enum ext4_fault_operation operation,
+				u32 group, u64 block, u32 len)
+{
+	struct ext4_fault_state *state = &EXT4_SB(sb)->s_fault;
+	unsigned long flags;
+	int error, result;
+	u32 generation, injection_count;
+	pid_t target_pid, target_pgid;
+	u64 call_index, match_index;
+	u64 random_seed = 0, random_check = 0, random_draw = 0;
+	u64 errno_choice_draw = 0;
+	u32 probability_ppm = 0;
+	bool randomized = false;
+	u32 errno_choice = 0;
+	u32 errno_count;
+	char target_program[EXT4_FAULT_PROGRAM_MAX];
+	char current_program[TASK_COMM_LEN];
+
+	/* PR_SET_NAME may run concurrently; do not read task->comm unlocked. */
+	get_task_comm(current_program, current);
+	spin_lock_irqsave(&state->lock, flags);
+	if (state->random_active) {
+		if (!test_bit(operation, state->random_operations) ||
+		    state->injected >= state->random_max_hits ||
+		    (state->target_pid && state->target_pid !=
+		     task_tgid_nr(current)) ||
+		    (state->target_pgid && state->target_pgid !=
+		     task_pgrp_nr(current))) {
+			spin_unlock_irqrestore(&state->lock, flags);
+			return 0;
+		}
+		random_check = state->matches++;
+		random_draw = ext4_fault_random_draw(state);
+		if (random_draw >= state->random_probability_ppm) {
+			spin_unlock_irqrestore(&state->lock, flags);
+			return 0;
+		}
+		randomized = true;
+		random_seed = state->random_seed;
+		probability_ppm = state->random_probability_ppm;
+		match_index = random_check;
+		state->last_random_operation = operation;
+		if (state->random_errno_native_by_operation[operation]) {
+			errno_count = ext4_fault_errno_count(operation);
+			errno_choice_draw = ext4_fault_random_draw(state);
+			errno_choice = errno_choice_draw % errno_count;
+			error = ext4_fault_errno_at(operation, errno_choice);
+		} else {
+			errno_count = state->random_error_count_by_operation[operation];
+			if (!errno_count) {
+				spin_unlock_irqrestore(&state->lock, flags);
+				return 0;
+			}
+			errno_choice_draw = ext4_fault_random_draw(state);
+			errno_choice = errno_choice_draw % errno_count;
+			error = state->random_errors_by_operation[operation][errno_choice];
+		}
+		state->error = error;
+		state->last_errno_choice = errno_choice;
+	} else {
+		if (state->operation != operation || !state->remaining ||
+		    (state->target_pid && state->target_pid != task_tgid_nr(current)) ||
+		    (state->target_pgid && state->target_pgid != task_pgrp_nr(current)) ||
+		    (state->program[0] != '-' &&
+		     strcmp(state->program, current_program))) {
+			spin_unlock_irqrestore(&state->lock, flags);
+			return 0;
+		}
+		match_index = state->matches;
+		if (state->matches != U64_MAX)
+			state->matches++;
+		if (match_index < state->call_index) {
+			spin_unlock_irqrestore(&state->lock, flags);
+			return 0;
+		}
+		errno_choice = 0;
+		state->last_errno_choice = 0;
+	}
+	if (!randomized)
+		state->remaining--;
+	state->injected++;
+	error = state->error;
+	generation = state->generation;
+	injection_count = state->injected;
+	target_pid = state->target_pid;
+	target_pgid = state->target_pgid;
+	call_index = state->call_index;
+	strscpy(target_program, state->program, sizeof(target_program));
+	spin_unlock_irqrestore(&state->lock, flags);
+
+	result = error;
+	trace_ext4_fault_inject(sb, ext4_fault_operation_name(operation), error,
+			       errno_choice, errno_choice_draw,
+			       generation, injection_count, task_tgid_nr(current),
+			       target_pid, target_pgid, current_program, target_program, call_index,
+			       match_index, group, block, len, result, randomized,
+			       random_seed, probability_ppm, random_check, random_draw);
+	return result;
+}
