+
+void ext4_checker_rmdir_error(struct inode *dir, struct inode *inode,
+			      unsigned int old_dir_nlink,
+			      unsigned int old_child_nlink,
+			      bool entry_removal_attempted, bool entry_deleted,
+			      bool child_committed, bool parent_committed, int err)
+{
+	unsigned int dir_durable, child_durable, expected_dir;
+
+	if (!dir || !inode || !READ_ONCE(EXT4_SB(dir->i_sb)->s_checker_active))
+		return;
+	if (EXT4_SB(dir->i_sb)->s_mount_state & EXT4_FC_REPLAY)
+		return;
+
+	/*
+	 * A failed ext4_mark_inode_dirty() is not a durable update: the count the
+	 * inode carries in memory then never reaches the device, so what survives
+	 * the unmount is the value from before the change.  Each side is judged on
+	 * that durable value, derived from the per-update flag the caller recorded.
+	 * Everything read here is in memory; no block is fetched from the device.
+	 *
+	 *   - the removal was never attempted: both sides keep their starting
+	 *     counts;
+	 *   - the removal was attempted but the write failed: ext4_generic_delete_entry()
+	 *     already zeroed the entry in the buffer, so the name is gone from memory
+	 *     while the child keeps every link -- the child must have been retired
+	 *     for the removal to be recoverable;
+	 *   - the entry is gone and the child's update did not commit: on disk the
+	 *     directory is unreachable while its name has disappeared, which is what
+	 *     e2fsck reports as a disconnected directory;
+	 *   - the entry write landed and the child's cleared count was accepted: the
+	 *     removal is durable, so the parent may no longer count this directory.
+	 *     Whether this call also recorded its own decrement is a separate
+	 *     question -- treating a failed parent update as "nothing changed" is the
+	 *     defect, because the child is gone while the parent still counts it.
+	 */
+	dir_durable = parent_committed ? dir->i_nlink : old_dir_nlink;
+	child_durable = child_committed ? inode->i_nlink : old_child_nlink;
+
+	if (!entry_removal_attempted) {
+		ext4_checker_count_check(dir, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rmdir_error_before_removal", old_dir_nlink,
+					 old_dir_nlink, dir_durable, true);
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rmdir_error_before_removal", old_child_nlink,
+					 old_child_nlink, child_durable, true);
+		return;
+	}
+	if (!entry_deleted) {
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rmdir_error_entry_removed_child_kept",
+					 old_child_nlink, 0, child_durable, true);
+		return;
+	}
+	if (!child_committed) {
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rmdir_error_child_nlink_not_committed",
+					 old_child_nlink, 0, child_durable, true);
+		return;
+	}
+	/* Both halves of the removal are durable from here on: the entry write
+	 * landed and the child's cleared count was accepted.  The parent must no
+	 * longer count this directory. */
+	expected_dir = old_dir_nlink > 2 ? old_dir_nlink - 1 : old_dir_nlink;
+	ext4_checker_count_check(dir, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+				 "rmdir_error_parent_nlink", old_dir_nlink,
+				 expected_dir, dir_durable, true);
+}
