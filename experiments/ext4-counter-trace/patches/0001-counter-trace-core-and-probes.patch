+/* Caller holds the group lock. No I/O or allocation is done here. */
+void ext4_ct_ih(struct super_block *sb, u32 group, struct ext4_group_desc *gd,
+		struct buffer_head *bitmap, const char *point)
+{
+	u32 n = EXT4_INODES_PER_GROUP(sb), unused, bit, violations = 0;
+	bool valid = ext4_has_group_desc_csum(sb) &&
+		!(gd->bg_flags & cpu_to_le16(EXT4_BG_INODE_UNINIT)) &&
+		buffer_uptodate(bitmap) && n <= sb->s_blocksize * 8;
+
+	if ((EXT4_SB(sb)->s_mount_state & EXT4_FC_REPLAY) ||
+	    ext4_checker_inode_bitmap_busy(sb, group)) {
+		ext4_ct_record(sb, point, "R-IH", 0, group, 0, 0, 0, 0,
+			EXT4_CT_UNVERIFIED, "inode_descriptor_publication_pending");
+		return;
+	}
+	unused = ext4_itable_unused_count(sb, gd);
+	if (unused > n)
+		violations = 1;
+	else if (valid)
+		for (bit = n - unused; bit < n; bit++)
+			violations += ext4_test_bit(bit, bitmap->b_data);
+	ext4_ct_record(sb, point, "R-IH", 0, group, 0, violations, 0, 0,
+		ct_status(valid, violations, 0), valid ? "allocated_bits_beyond_prefix" :
+		"checksum_disabled_or_inode_uninit_or_unreadable");
+}
+
+static u64 ct_inode_changes(struct super_block *sb)
+{
+	struct ext4_ct_state *ct = &EXT4_SB(sb)->s_ct;
+	unsigned long flags;
+	u64 value;
+
+	spin_lock_irqsave(&ct->lock, flags);
+	value = ct->inode_changes;
+	spin_unlock_irqrestore(&ct->lock, flags);
+	return value;
+}
+
+void ext4_ct_evict_begin(struct inode *inode, struct ext4_ct_evict *s)
+{
+	struct super_block *sb = inode->i_sb;
+	struct ext4_group_desc *gd;
+	struct ext4_group_info *grp;
+
+	memset(s, 0, sizeof(*s));
+	s->eligible = !inode->i_nlink && !is_bad_inode(inode) &&
+		inode->i_ino >= EXT4_FIRST_INO(sb) &&
+		inode->i_ino <= le32_to_cpu(EXT4_SB(sb)->s_es->s_inodes_count);
+	if (!s->eligible)
+		return;
+	ext4_ct_enter(sb, &s->scope, "INODE.EVICT");
+	s->group = (inode->i_ino - 1) / EXT4_INODES_PER_GROUP(sb);
+	s->bit = (inode->i_ino - 1) % EXT4_INODES_PER_GROUP(sb);
+	s->inode_changes = ct_inode_changes(sb);
+	s->bitmap = ext4_read_inode_bitmap(sb, s->group);
+	if (IS_ERR(s->bitmap)) {
+		s->bitmap = NULL;
+		return;
+	}
+	gd = ext4_get_group_desc(sb, s->group, NULL);
+	grp = ext4_get_group_info(sb, s->group);
+	if (!gd || !grp || EXT4_MB_GRP_IBITMAP_CORRUPT(grp))
+		return;
+	ext4_lock_group(sb, s->group);
+	s->bit_before = ext4_test_bit(s->bit, s->bitmap->b_data);
+	s->descriptor_before = ext4_free_inodes_count(sb, gd);
+	ext4_unlock_group(sb, s->group);
+	s->global_before = percpu_counter_sum(&EXT4_SB(sb)->s_freeinodes_counter);
+	s->sampled = true;
+	ext4_ct_record(sb, "INODE.EVICT.TARGET.BEFORE", "R-IEVICT", inode->i_ino,
+		s->group, 0, s->bit_before, 0, 0, EXT4_CT_RAW, "target_before_cleanup");
+}
+
+void ext4_ct_evict_end(struct inode *inode, struct ext4_ct_evict *s)
+{
+	struct super_block *sb = inode->i_sb;
+	struct ext4_group_desc *gd;
+	struct ext4_group_info *grp;
+	s64 bit = -1, descriptor = 0, global = 0;
+	bool valid = false, delta_valid;
+	const char *reason = "target_bitmap_unreadable_or_corrupt";
+
+	if (!s->eligible)
+		return;
+	gd = ext4_get_group_desc(sb, s->group, NULL);
+	grp = ext4_get_group_info(sb, s->group);
+	if (s->sampled && gd && grp && buffer_uptodate(s->bitmap) &&
+	    !EXT4_MB_GRP_IBITMAP_CORRUPT(grp)) {
+		ext4_lock_group(sb, s->group);
+		bit = ext4_test_bit(s->bit, s->bitmap->b_data);
+		descriptor = (s64)ext4_free_inodes_count(sb, gd) - s->descriptor_before;
+		ext4_unlock_group(sb, s->group);
+		global = percpu_counter_sum(&EXT4_SB(sb)->s_freeinodes_counter) -
+			s->global_before;
+		valid = ext4_ct_exclusive(sb, &s->scope) && !inode->i_nlink &&
+			atomic_read(&inode->i_count) == 0 &&
+			!(EXT4_SB(sb)->s_mount_state & EXT4_FC_REPLAY);
+		reason = valid ? "after_incore_cleanup" : "concurrent_update_or_ineligible";
+	}
+	ext4_ct_record(sb, "INODE.EVICT.TARGET.EXIT", "R-IEVICT", inode->i_ino,
+		s->group, 0, bit, 0, 0, ct_status(valid, bit, 0), reason);
+	/* Other same-task allocations (e.g. EA inode cleanup) also defeat attribution. */
+	delta_valid = valid && s->bit_before == 1 && bit == 0 &&
+		ct_inode_changes(sb) == s->inode_changes + 1;
+	reason = delta_valid ? "isolated_slot_release" : "slot_not_released_or_other_inode_updates";
+	ext4_ct_record(sb, "INODE.EVICT.DESCRIPTOR.EXIT", "R-IDELTA-EVICT",
+		inode->i_ino, s->group, 0, descriptor, 1, descriptor,
+		ct_status(delta_valid, descriptor, 1), reason);
+	ext4_ct_record(sb, "INODE.EVICT.GLOBAL.EXIT", "R-IDELTA-EVICT",
+		inode->i_ino, s->group, 0, global, 1, global,
+		ct_status(delta_valid, global, 1), reason);
+	brelse(s->bitmap);
+	ext4_ct_exit(sb, &s->scope, valid && bit ? -EUCLEAN : 0);
+}
+
+/* Called only by the observer after a refcount-one release attempt. */
+int ext4_ct_xattr_freed(struct inode *inode, struct buffer_head *bh)
+{
+	struct super_block *sb = inode->i_sb;
+	struct buffer_head *bitmap;
+	struct ext4_group_info *grp;
+	ext4_group_t group;
+	ext4_grpblk_t bit;
+	int freed;
+
+	ext4_get_group_no_and_offset(sb, bh->b_blocknr, &group, &bit);
+	grp = ext4_get_group_info(sb, group);
+	if (!grp || EXT4_MB_GRP_BBITMAP_CORRUPT(grp))
+		return -1;
+	bitmap = ext4_read_block_bitmap(sb, group);
+	if (IS_ERR(bitmap))
+		return -1;
+	ext4_lock_group(sb, group);
+	freed = !ext4_test_bit(bit, bitmap->b_data);
+	ext4_unlock_group(sb, group);
+	brelse(bitmap);
+	return freed;
+}
+
+struct ct_acl {
+	u64 block;
+	u32 ino, refs, stored, csum, expected_csum;
+};
+
+static int ct_acl_order(const void *left, const void *right)
+{
+	const struct ct_acl *a = left, *b = right;
+
+	return a->block < b->block ? -1 : a->block > b->block;
+}
+
+static u32 ct_xattr_csum(struct super_block *sb, struct buffer_head *bh)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	__le64 block = cpu_to_le64(bh->b_blocknr);
+	u32 zero = 0, csum;
+	u32 off = offsetof(struct ext4_xattr_header, h_checksum);
+
+	csum = ext4_chksum(sbi, sbi->s_csum_seed, (u8 *)&block, sizeof(block));
+	csum = ext4_chksum(sbi, csum, bh->b_data, off);
+	csum = ext4_chksum(sbi, csum, (u8 *)&zero, sizeof(zero));
+	return ext4_chksum(sbi, csum, bh->b_data + off + sizeof(zero),
+			   sb->s_blocksize - off - sizeof(zero));
+}
+
+static void ct_relation(struct super_block *sb, struct ext4_ct_relations *r,
+	const char *formula, u32 ino, u64 block, u32 slot, s64 actual,
+	s64 expected, const char *reason)
+{
+	ext4_ct_object(sb, "SNAPSHOT.MEMORY.STABLE", formula, ino, block, slot,
+		actual, expected, 0, ct_status(r->valid, actual, expected),
+		r->valid ? reason : r->reason);
+	if (r->valid && actual != expected)
+		r->mismatches++;
+}
+
+/*
+ * Independent i_file_acl scan: prefer live inodes, otherwise read current
+ * inode-table buffers. Never instantiate dead inodes with iget(). Collect
+ * everything before accepting a complete writer-free version window.
+ */
+void ext4_ct_relations_scan(struct super_block *sb, u64 version,
+			    struct ext4_ct_relations *r)
+{
+	struct ext4_orphan_info *oi = &EXT4_SB(sb)->s_orphan_info;
+	u32 max_ino = le32_to_cpu(EXT4_SB(sb)->s_es->s_inodes_count);
+	u32 per_ob = ext4_inodes_per_orphan_block(sb), slots = 0;
+	u32 *orphans = NULL, *owner = NULL, *free_entries = NULL;
+	struct ct_acl *acl = NULL;
+	u8 *bits = NULL;
+	u32 g, b, n = 0, unique = 0, i, groups = ext4_get_groups_count(sb);
+	const char *failure = "concurrent_or_unhealthy";
+
+	memset(r, 0, sizeof(*r));
+	r->reason = failure;
+	if (!ext4_ct_stable(sb, version))
+		goto out;
+	failure = "relations_geometry_limit";
+	if (!max_ino || max_ino > CT_REL_MAX_INODES || oi->of_blocks < 0 ||
+	    oi->of_blocks > CT_REL_MAX_INODES / per_ob)
+		goto out;
+	slots = oi->of_blocks * per_ob;
+	failure = "relations_allocation_failed";
+	acl = kvcalloc(max_ino, sizeof(*acl), GFP_NOFS);
+	bits = kmalloc(sb->s_blocksize, GFP_NOFS);
+	if (!acl || !bits)
+		goto out;
+	if (slots) {
+		orphans = kvcalloc(slots, sizeof(*orphans), GFP_NOFS);
+		owner = kvcalloc(slots, sizeof(*owner), GFP_NOFS);
+		free_entries = kvcalloc(oi->of_blocks, sizeof(*free_entries), GFP_NOFS);
+		if (!orphans || !owner || !free_entries)
+			goto out;
+		for (b = 0; b < oi->of_blocks; b++) {
+			struct buffer_head *bh = oi->of_binfo[b].ob_bh;
+			failure = "orphan_buffer_unreadable";
+			if (!bh || !buffer_uptodate(bh))
+				goto out;
+			for (i = 0; i < per_ob; i++)
+				orphans[b * per_ob + i] = le32_to_cpu(READ_ONCE(((__le32 *)bh->b_data)[i]));
+			free_entries[b] = atomic_read(&oi->of_binfo[b].ob_free_entries);
+		}
+	}
+	for (g = 0; g < groups; g++) {
+		struct buffer_head *ib;
+		struct ext4_group_info *grp;
+		u32 per_group = EXT4_INODES_PER_GROUP(sb);
+
+		failure = "concurrent_or_unhealthy";
+		if (!ext4_ct_stable(sb, version))
+			goto out;
+		failure = "inode_bitmap_unreadable_or_corrupt";
+		grp = ext4_get_group_info(sb, g);
+		if (!grp || EXT4_MB_GRP_IBITMAP_CORRUPT(grp) || per_group > sb->s_blocksize * 8)
+			goto out;
+		ib = ext4_read_inode_bitmap(sb, g);
+		if (IS_ERR(ib))
+			goto out;
+		ext4_lock_group(sb, g);
+		memcpy(bits, ib->b_data, sb->s_blocksize);
+		ext4_unlock_group(sb, g);
+		brelse(ib);
+		for (i = 0; i < per_group; i++) {
+			u32 ino = g * per_group + i + 1;
+			u64 block;
+			struct inode *inode;
+
+			if (ino > max_ino)
+				break;
+			/* Inode 1 is the permanently reserved bad-blocks inode. */
+			if (ino < EXT4_ROOT_INO || !ext4_test_bit(i, bits))
+				continue;
+			inode = ilookup(sb, ino);
+			if (inode) {
+				if (!down_read_trylock(&EXT4_I(inode)->xattr_sem)) {
+					iput(inode);
+					failure = "xattr_lock_busy";
+					goto out;
+				}
+				block = EXT4_I(inode)->i_file_acl;
+				up_read(&EXT4_I(inode)->xattr_sem);
+				if (ext4_test_inode_state(inode, EXT4_STATE_ORPHAN_FILE)) {
+					u32 idx = EXT4_I(inode)->i_orphan_idx;
+					if (idx >= slots) {
+						iput(inode);
+						failure = "orphan_index_out_of_range";
+						goto out;
+					}
+					owner[idx] = ino;
+				}
+				iput(inode);
+			} else {
+				struct ext4_iloc iloc;
+				struct ext4_inode *raw;
+				failure = "inode_table_read_failed";
+				if (ext4_get_fc_inode_loc(sb, ino, &iloc))
+					goto out;
+				raw = ext4_raw_inode(&iloc);
+				block = le32_to_cpu(raw->i_file_acl_lo);
+				if (ext4_has_feature_64bit(sb))
+					block |= (u64)le16_to_cpu(raw->i_file_acl_high) << 32;
+				brelse(iloc.bh);
+			}
+			if (block) {
+				acl[n].block = block;
+				acl[n++].ino = ino;
+			}
+		}
+		cond_resched();
+	}
+	sort(acl, n, sizeof(*acl), ct_acl_order, NULL);
+	for (i = 0; i < n;) {
+		struct buffer_head *bh;
+		struct ext4_xattr_header *header;
+		u32 start = i;
+
+		while (i < n && acl[i].block == acl[start].block)
+			i++;
+		acl[unique] = acl[start];
+		acl[unique].refs = i - start;
+		failure = "xattr_block_out_of_range";
+		if (!ext4_sb_block_valid(sb, NULL, acl[unique].block, 1))
+			goto out;
+		bh = ext4_sb_bread(sb, acl[unique].block, REQ_PRIO);
+		failure = "xattr_block_read_failed";
+		if (IS_ERR(bh))
+			goto out;
+		lock_buffer(bh);
+		header = (struct ext4_xattr_header *)bh->b_data;
+		failure = "xattr_header_invalid";
+		if (header->h_magic != cpu_to_le32(EXT4_XATTR_MAGIC) ||
+		    header->h_blocks != cpu_to_le32(1)) {
+			unlock_buffer(bh);
+			brelse(bh);
+			goto out;
+		}
+		acl[unique].stored = le32_to_cpu(header->h_refcount);
+		acl[unique].csum = le32_to_cpu(header->h_checksum);
+		if (ext4_has_metadata_csum(sb))
+			acl[unique].expected_csum = ct_xattr_csum(sb, bh);
+		unlock_buffer(bh);
+		brelse(bh);
+		unique++;
+	}
+	failure = "concurrent_or_unhealthy";
+	if (!ext4_ct_stable(sb, version))
+		goto out;
+	r->valid = true;
+	r->reason = "stable_independent_inode_and_slot_scan";
+	r->xattr_blocks = unique;
+	r->orphan_slots = slots;
+	for (i = 0; i < unique; i++) {
+		r->xattr_violations += acl[i].stored != acl[i].refs;
+		ct_relation(sb, r, "XATTR-REF", acl[i].ino, acl[i].block, 0,
+			acl[i].stored, acl[i].refs, "independent_i_file_acl_scan");
+		if (ext4_has_metadata_csum(sb))
+			ct_relation(sb, r, "XATTR-REF.CSUM", acl[i].ino, acl[i].block,
+				0, acl[i].csum, acl[i].expected_csum, "xattr_header_checksum");
+	}
+	if (!unique)
+		ct_relation(sb, r, "XATTR-REF", 0, 0, 0, 0, 0, "empty_reference_set");
+	for (b = 0; b < oi->of_blocks; b++) {
+		u32 zeros = 0;
+		for (i = 0; i < per_ob; i++) {
+			u32 idx = b * per_ob + i;
+			zeros += !orphans[idx];
+			if (orphans[idx] || owner[idx])
+				ct_relation(sb, r, "O-LIFE", orphans[idx] ?: owner[idx],
+					oi->of_binfo[b].ob_bh->b_blocknr, i,
+					orphans[idx], owner[idx], "slot_to_live_orphan_owner");
+		}
+		ct_relation(sb, r, "O-LIFE-FREE", 0, oi->of_binfo[b].ob_bh->b_blocknr,
+			0, free_entries[b], zeros, "independent_zero_slot_scan");
+		r->orphan_checks++;
+		r->orphan_violations += free_entries[b] != zeros;
+	}
+out:
+	if (!r->valid) {
+		r->reason = failure;
+		ext4_ct_object(sb, "SNAPSHOT.MEMORY.STABLE", "XATTR-REF", 0, 0, 0,
+			0, 0, 0, EXT4_CT_UNVERIFIED, failure);
+		ext4_ct_object(sb, "SNAPSHOT.MEMORY.STABLE", "O-LIFE", 0, 0, 0,
+			0, 0, 0, EXT4_CT_UNVERIFIED, failure);
+	} else if (!slots) {
+		ext4_ct_object(sb, "SNAPSHOT.MEMORY.STABLE", "O-LIFE", 0, 0, 0,
+			0, 0, 0, EXT4_CT_UNVERIFIED, "orphan_file_not_enabled");
+	}
+	kvfree(acl);
+	kvfree(orphans);
+	kvfree(owner);
+	kvfree(free_entries);
+	kfree(bits);
+}
