+#include <linux/slab.h>
+#include <linux/smp.h>
+#include <linux/vmalloc.h>
+
+#include "ext4.h"
+#include "ext4_extents.h"
+#include "ext4_jbd2.h"
+#include "xattr.h"
+
+#define EXT4_CHECKER_EVENT_CAP 1024
+#define EXT4_CHECKER_EVENT_CAP_MIN 64
+#define EXT4_CHECKER_EVENT_CAP_MAX 65536
+#define EXT4_CHECKER_TX_SLOTS 128
+#define EXT4_CHECKER_TX_CONTEXT 32
+#define EXT4_CHECKER_WALK_MAX 16384
+
+struct ext4_checker_event {
+	u64 seq;
+	u64 op_id;
+	u64 inode;
+	u64 range_start;
+	u64 txid;
+	u32 group;
+	u32 range_len;
+	u16 counter;
+	u16 type;
+	u16 flags;
+	u16 tx_source;
+	u32 source_line;
+	u32 refs_before;
+	u32 refs_after;
+	s64 delta;
+	s64 old_value;
+	s64 expected;
+	s64 actual;
+	pid_t pid;
+	u16 cpu;
+};
+
+static bool checker_panic;
+module_param_named(ext4_checker_panic, checker_panic, bool, 0600);
+MODULE_PARM_DESC(ext4_checker_panic,
+		 "panic instead of continuing after an invariant violation");
+
+
+static unsigned int checker_event_cap = EXT4_CHECKER_EVENT_CAP;
+module_param_named(ext4_checker_event_cap, checker_event_cap, uint, 0600);
+MODULE_PARM_DESC(ext4_checker_event_cap,
+		 "metadata event ring capacity (64..65536)");
+static struct dentry *checker_debugfs_root;
+
+
+/* Checker hooks can run with ext4 group locks held; never sleep here. */
+static bool checker_barrier_read_trylock(struct ext4_sb_info *sbi)
+{
+	return down_read_trylock(&sbi->s_checker_barrier);
+}
+
+static void checker_barrier_read_unlock(struct ext4_sb_info *sbi, bool locked)
+{
+	if (locked)
+		up_read(&sbi->s_checker_barrier);
+}
+
+/*
+ * Enter the checker event critical section without sleeping.  Most ext4
+ * hooks run while a filesystem lock is held, so taking the barrier with
+ * down_read() is not safe here.  A failed trylock is normally a snapshot in
+ * progress, but it can also mean that ext4_ct_models_stop() is waiting to free
+ * the event ring.  Recheck s_checker_active while holding the checker lock so
+ * a hook which observed the old value cannot dereference the ring after it is
+ * freed. The same lock serializes teardown.
+ */
+static bool checker_event_lock(struct ext4_sb_info *sbi,
+				      bool *barrier_locked)
+{
+	*barrier_locked = checker_barrier_read_trylock(sbi);
+	spin_lock(&sbi->s_checker_lock);
+	if (!READ_ONCE(sbi->s_checker_active)) {
+		spin_unlock(&sbi->s_checker_lock);
+		checker_barrier_read_unlock(sbi, *barrier_locked);
+		return false;
+	}
+	return true;
+}
