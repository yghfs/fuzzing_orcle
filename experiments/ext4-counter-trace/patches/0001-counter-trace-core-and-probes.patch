+	case EXT4_CHECKER_MODEL_BLOCK_BITMAP: return "block_bitmap";
+	case EXT4_CHECKER_MODEL_RESERVATION: return "reservation";
+	case EXT4_CHECKER_MODEL_EA_REFERENCES: return "ea_references";
+	case EXT4_CHECKER_MODEL_EXTENT_BLOCKS: return "extent_blocks";
+	case EXT4_CHECKER_MODEL_INLINE_DATA: return "inline_data";
+	case EXT4_CHECKER_MODEL_ORPHAN_FILE: return "orphan_file_entries";
+	case EXT4_CHECKER_MODEL_FLEX_GROUP_COUNTS: return "flex_group_counts";
+	case EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT: return "directory_link_count";
+	case EXT4_CHECKER_MODEL_ES_TREE: return "extent_status_tree";
+	case EXT4_CHECKER_MODEL_MB_FREE_PENDING: return "mb_free_pending";
+	case EXT4_CHECKER_MODEL_XATTR_BLOCK_REFS: return "xattr_block_refs";
+	case EXT4_CHECKER_MODEL_EA_INODE_REFS: return "ea_inode_references";
+	case EXT4_CHECKER_MODEL_DELALLOC_GLOBAL: return "delalloc_global_reservation";
