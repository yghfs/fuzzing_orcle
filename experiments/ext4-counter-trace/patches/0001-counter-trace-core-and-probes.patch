+#define ext4_ct_desc_set(sb, gd, group, value, getter, setter, formula) do { \
+	struct super_block *ct_sb = (sb); \
+	struct ext4_group_desc *ct_gd = (gd); \
+	u32 ct_group = (group), ct_value = (value); \
+	s64 ct_before = getter(ct_sb, ct_gd); \
+	setter(ct_sb, ct_gd, ct_value); \
+	ext4_ct_record(ct_sb, "WRITE.DESCRIPTOR", formula, 0, ct_group, \
