+static enum ext4_checker_counter checker_model_counter(enum ext4_checker_model model)
+{
+	switch (model) {
+	case EXT4_CHECKER_MODEL_BLOCK_BITMAP: return EXT4_CHECKER_CLUSTERS;
+	case EXT4_CHECKER_MODEL_RESERVATION: return EXT4_CHECKER_RESERVED_CLUSTERS;
+	case EXT4_CHECKER_MODEL_EA_REFERENCES: return EXT4_CHECKER_EA_REFS;
+	case EXT4_CHECKER_MODEL_EXTENT_BLOCKS: return EXT4_CHECKER_INODE_SECTORS;
+	case EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT: return EXT4_CHECKER_DIRS;
+	default: return EXT4_CHECKER_INODES;
+	}
+}
+
+static enum ext4_checker_event_type checker_model_event(enum ext4_checker_model model)
+{
+	switch (model) {
+	case EXT4_CHECKER_MODEL_BLOCK_BITMAP: return EXT4_CHECKER_EVENT_COUNTER;
+	case EXT4_CHECKER_MODEL_RESERVATION: return EXT4_CHECKER_EVENT_RESERVATION;
+	case EXT4_CHECKER_MODEL_EA_REFERENCES: return EXT4_CHECKER_EVENT_EA_REFERENCE;
+	case EXT4_CHECKER_MODEL_EXTENT_BLOCKS: return EXT4_CHECKER_EVENT_INODE_BLOCKS;
+	case EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT:
+		return EXT4_CHECKER_EVENT_DIR_CREATE;
+	case EXT4_CHECKER_MODEL_DELALLOC_GLOBAL:
+		return EXT4_CHECKER_EVENT_RESERVATION;
+	default: return EXT4_CHECKER_EVENT_COUNTER;
+	}
+}
