+void ext4_ct_models_start(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	init_rwsem(&sbi->s_checker_barrier);
+	spin_lock_init(&sbi->s_checker_lock);
+	atomic_set(&sbi->s_checker_xattr_active, 0);
+	atomic64_set(&sbi->s_checker_xattr_seq, 0);
+	atomic_set(&sbi->s_checker_flex_active, 0);
+	atomic64_set(&sbi->s_checker_flex_seq, 0);
+	if (checker_event_cap < EXT4_CHECKER_EVENT_CAP_MIN ||
+	    checker_event_cap > EXT4_CHECKER_EVENT_CAP_MAX)
+		checker_event_cap = EXT4_CHECKER_EVENT_CAP;
+	sbi->s_checker_event_size = checker_event_cap;
+	/* The maximum ring is several MiB; kvcalloc avoids requiring a large
+	 * physically contiguous allocation during early filesystem mount.
+	 */
+	sbi->s_checker_events = kvcalloc(sbi->s_checker_event_size,
+					  sizeof(*sbi->s_checker_events), GFP_KERNEL);
+	sbi->s_checker_tx_context = kcalloc(EXT4_CHECKER_TX_CONTEXT,
+					 sizeof(*sbi->s_checker_tx_context), GFP_KERNEL);
+	if (!sbi->s_checker_events || !sbi->s_checker_tx_context)
+		goto out_free;
+	WRITE_ONCE(sbi->s_checker_active, true);
+	if (!checker_debugfs_root)
+		checker_debugfs_root = debugfs_create_dir("ext4", NULL);
+	if (!IS_ERR_OR_NULL(checker_debugfs_root)) {
+		sbi->s_checker_dir = debugfs_create_dir(sb->s_id,
+							 checker_debugfs_root);
+		if (!IS_ERR_OR_NULL(sbi->s_checker_dir))
+			debugfs_create_file("invariant_check", 0600,
+					    sbi->s_checker_dir, sb,
+					    &checker_debugfs_fops);
+		if (!IS_ERR_OR_NULL(sbi->s_checker_dir))
+			debugfs_create_file("invariant_summary", 0400,
+					    sbi->s_checker_dir, sb,
+					    &checker_debugfs_summary_fops);
+		if (!IS_ERR_OR_NULL(sbi->s_checker_dir))
+			debugfs_create_file("invariant_reset", 0200,
+					    sbi->s_checker_dir, sb,
+					    &checker_debugfs_reset_fops);
+	}
+	ext4_msg(sb, KERN_INFO, "consistency checker enabled");
+	return;
+out_free:
+	ext4_msg(sb, KERN_ERR,
+		 "consistency checker model statistics unavailable: allocation failed");
+	kvfree(sbi->s_checker_events);
+	kfree(sbi->s_checker_tx_context);
+	sbi->s_checker_events = NULL;
+	sbi->s_checker_tx_context = NULL;
+}
+
+void ext4_ct_models_stop(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+
+	if (!sbi->s_checker_events)
+		return;
+	debugfs_remove_recursive(sbi->s_checker_dir);
+	down_write(&sbi->s_checker_barrier);
+	sbi->s_checker_active = false;
+	/* xattr operations hold an activity reference across their transaction;
+	 * wait for those references before freeing checker storage. */
+	spin_lock(&sbi->s_checker_lock);
+	spin_unlock(&sbi->s_checker_lock);
+	while (atomic_read(&sbi->s_checker_xattr_active))
+		cpu_relax();
+	/*
+	 * Hooks which raced the barrier trylock may still be waiting for the
+	 * checker lock.  Serialize with them before releasing the barrier and
+	 * freeing the ring they access.
+	 */
+	spin_lock(&sbi->s_checker_lock);
+	spin_unlock(&sbi->s_checker_lock);
+	up_write(&sbi->s_checker_barrier);
+	kvfree(sbi->s_checker_events);
+	kfree(sbi->s_checker_tx_context);
+	sbi->s_checker_events = NULL;
+	sbi->s_checker_tx_context = NULL;
+}
+
+void ext4_checker_unlink_error(struct inode *dir, struct inode *inode,
+			       unsigned int old_nlink, bool entry_removed,
+			       bool inode_committed, int err)
+{
+	unsigned int durable;
+
+	if (!dir || !inode || !READ_ONCE(EXT4_SB(dir->i_sb)->s_checker_active))
+		return;
+	if (EXT4_SB(dir->i_sb)->s_mount_state & EXT4_FC_REPLAY)
+		return;
+
+	/*
+	 * unlink removes the directory entry and only then drops the inode's link
+	 * count.  A failed ext4_mark_inode_dirty() is not durable, so the count that
+	 * survives the unmount is the one from before the drop.  Judging that
+	 * durable value, rather than the value left in memory, is what exposes the
+	 * defect while the operation is still in progress:
+	 *
+	 *   - the entry removal never happened: the inode keeps every link and must
+	 *     still report exactly that;
+	 *   - the entry is gone: the name no longer exists, so the inode may keep
+	 *     only the links of the names that remain.  If the update carrying the
+	 *     decremented count did not commit, the on-disk count still includes the
+	 *     removed name and e2fsck reports a disconnected inode.
+	 */
+	durable = inode_committed ? inode->i_nlink : old_nlink;
+
+	if (!entry_removed) {
+		ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "unlink_error_before_removal", old_nlink,
+					 old_nlink, durable, true);
+		return;
+	}
+	ext4_checker_count_check(inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+				 "unlink_error_entry_removed_link_count",
+				 old_nlink, old_nlink ? old_nlink - 1 : 0,
+				 durable, true);
+}
+
+void ext4_checker_rename_error(struct inode *old_inode, struct inode *new_inode,
+			       unsigned int old_nlink, bool verified,
+			       bool dest_linked, bool source_linked,
+			       bool target_committed, unsigned int old_target_nlink,
+			       int err)
+{
+	unsigned int target_durable;
+
+	if (!old_inode || !verified ||
+	    !READ_ONCE(EXT4_SB(old_inode->i_sb)->s_checker_active))
+		return;
+	if (EXT4_SB(old_inode->i_sb)->s_mount_state & EXT4_FC_REPLAY)
+		return;
+
+	/*
+	 * rename publishes the destination entry before it retires the source and
+	 * before it commits the replaced target's decremented count.  Each of those
+	 * effects is visible in memory before it is durable, so the model reads the
+	 * names out of the buffers and derives the link count the namespace
+	 * requires.  Everything here is in memory; no block is read from the device.
+	 *
+	 *   - the destination name was never published: nothing moved, so the source
+	 *     must still carry its original count;
+	 *   - the destination is published and the source name remains: two names
+	 *     resolve to one inode, so a single link is a lost update;
+	 *   - only the destination remains: the move is complete and the source count
+	 *     is unchanged, because rename never touches it for a non-directory;
+	 *   - the replaced target lost a link in memory.  When that update did not
+	 *     commit, the on-disk count still includes the name that is gone.
+	 */
+	if (!dest_linked) {
+		ext4_checker_count_check(old_inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rename_error_before_link", old_nlink,
+					 old_nlink, old_inode->i_nlink, true);
+		return;
+	}
+	if (source_linked) {
+		ext4_checker_count_check(old_inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rename_error_dest_linked_source_kept",
+					 old_nlink, old_nlink + 1,
+					 old_inode->i_nlink, true);
+		return;
+	}
+	ext4_checker_count_check(old_inode, EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+				 "rename_error_move_complete", old_nlink,
+				 old_nlink, old_inode->i_nlink, true);
+	if (new_inode) {
+		/*
+		 * The replaced name is already gone from the buffer, so the target
+		 * keeps one link fewer than it started with.  Compare the target's
+		 * own durable count, not the source's.
+		 */
+		target_durable = target_committed ? new_inode->i_nlink
+						  : old_target_nlink;
+		ext4_checker_count_check(new_inode,
+					 EXT4_CHECKER_MODEL_DIRECTORY_LINK_COUNT,
+					 "rename_error_target_link_count",
+					 old_target_nlink,
+					 old_target_nlink ? old_target_nlink - 1 : 0,
+					 target_durable, true);
+	}
+}
