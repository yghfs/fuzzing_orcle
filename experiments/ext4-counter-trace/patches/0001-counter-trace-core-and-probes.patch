+#ifdef CONFIG_EXT4_COUNTER_TRACE
+int ext4_ct_inline_dir(struct inode *inode, struct dir_context *ctx)
+{
+    struct ext4_iloc iloc;
+    void *data;
+    int ret, size, offset, end, split;
+    struct ext4_dir_entry_2 *de;
+
+    ret = ext4_get_inode_loc(inode, &iloc);
+    if (ret)
+        return ret;
+    down_read(&EXT4_I(inode)->xattr_sem);
+    size = ext4_get_inline_size(inode);
+    if (!ext4_has_inline_data(inode) || size < EXT4_MIN_INLINE_DATA_SIZE) {
+        ret = -EAGAIN;
+        goto unlock;
+    }
+    data = kmalloc(size, GFP_NOFS);
+    if (!data) {
+        ret = -ENOMEM;
+        goto unlock;
+    }
+    ret = ext4_read_inline_data(inode, data, size, &iloc);
+    up_read(&EXT4_I(inode)->xattr_sem);
+    brelse(iloc.bh);
+    if (ret < 0)
+        goto free;
+    ret = -EFSCORRUPTED;
+    if (!ctx->actor(ctx, ".", 1, 0, inode->i_ino, DT_DIR) ||
+        !ctx->actor(ctx, "..", 2, 0, le32_to_cpu(*(__le32 *)data), DT_DIR))
+        goto free;
+    for (split = 0; split < 2; split++) {
+        offset = split ? EXT4_MIN_INLINE_DATA_SIZE : EXT4_INLINE_DOTDOT_SIZE;
+        end = split ? size : EXT4_MIN_INLINE_DATA_SIZE;
+        while (offset < end) {
+            unsigned int len;
+            de = data + offset;
+            if (end - offset < 8)
+                goto free;
+            len = ext4_rec_len_from_disk(de->rec_len, end - offset);
+            if (len < 8 || (len & 3) || len > end - offset ||
+                de->name_len > len - 8)
+                goto free;
+            if (de->inode && !ctx->actor(ctx, de->name, de->name_len,
+                                       offset, le32_to_cpu(de->inode), DT_UNKNOWN))
+                goto free;
+            offset += len;
+        }
+    }
+    ret = 0;
+free:
+    kfree(data);
+    return ret;
+unlock:
+    up_read(&EXT4_I(inode)->xattr_sem);
+    brelse(iloc.bh);
+    return ret;
+}
