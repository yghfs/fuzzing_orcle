+static enum ext4_ct_status ct_status(bool valid, s64 actual, s64 expected)
+{
+	return !valid ? EXT4_CT_UNVERIFIED : actual == expected ?
+		EXT4_CT_CONSISTENT : EXT4_CT_MISMATCH;
+}
