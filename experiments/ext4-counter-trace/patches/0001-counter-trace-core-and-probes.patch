+	struct ext4_iloc iloc;
+	struct ext4_sb_info *sbi = EXT4_SB(inode->i_sb);
+	enum ext4_fault_operation access_operation;
+	int err;
+
+	might_sleep();
+	trace_ext4_mark_inode_dirty(inode, _RET_IP_);
+	/* Inode updates can fail both before and after the raw inode is changed. */
+	access_operation = ext4_inode_dirty_access_operation(operation);
+	err = __ext4_reserve_inode_write(handle, inode, &iloc,
+					 access_operation);
+	if (!err) {
+		if (EXT4_I(inode)->i_extra_isize < sbi->s_want_extra_isize)
+			ext4_try_to_expand_extra_isize(inode, sbi->s_want_extra_isize,
+						       iloc, handle);
+		/* ext4_mark_iloc_dirty() is kept as the non-faultable wrapper;
+		 * this variant injects at ext4_do_update_inode's dirty exit. */
+		err = ext4_mark_iloc_dirty_faultable(handle, inode, &iloc,
+						      operation);
+	}
+	if (unlikely(err))
+		ext4_error_inode_err(inode, __func__, __LINE__, 0, err,
+				"faultable mark_inode_dirty error");
+	return err;
